@using Team1.VitalBridge.BackStage.Models.ViewModels
@model UserViewModel
@{
    ViewData["Title"] = "編輯會員資料";
    var allCities = ViewBag.AllCities as List<SelectListItem>;
    var allTownships = ViewBag.AllTownships as List<SelectListItem>;
    var allRoles = ViewBag.AllRoles as List<SelectListItem> ?? new List<SelectListItem>();
}



@*<link href="https:cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">*@


<div class="p-4">

   @* <h3 class="mb-4 border-bottom pb-2 text-primary">編輯會員資料</h3> *@

    <form asp-action="Edit" method="post" class="needs-validation" id="editMemberForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" name="Roles" value="" />

        <div class="row g-4">

            <!-- 基本資料 -->
            @*
            <div class="col-12">
                <h5 class="text-secondary border-bottom pb-1 mb-3">基本資料</h5>
            </div>
            *@

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">姓名</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">聯絡電話</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label">帳號狀態</label>
                <select asp-for="Status" class="form-select">
                    <option value="">請選擇</option>
                    <option value="active">活躍</option>
                    <option value="frozen">凍結</option>
                    <option value="unverified">未開通</option>
                    <option value="banned">停權</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <!-- 地址區塊 -->
            @*
            <div class="col-12">
                <h5 class="text-secondary border-bottom pb-1 mb-3 mt-4">通訊地址</h5>
            </div>
            *@


            <div class="col-md-6">
                <label asp-for="CityId" class="form-label">縣市</label>
                <select asp-for="CityId" class="form-select" asp-items="allCities" id="CityId">
                    <option value="">請選擇縣市</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="TownshipId" class="form-label">鄉鎮</label>
                <select asp-for="TownshipId" class="form-select" asp-items="allTownships" id="TownshipId">
                    <option value="">請選擇鄉鎮</option>
                </select>
            </div>

            <div class="col-md-12">
                <label asp-for="Address" class="form-label">詳細地址</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <!--  身分 -->
            <div class="col-12">
                <h5 class="text-secondary border-bottom pb-1 mb-3 mt-4">會員身分</h5>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var role in allRoles)
                    {
                        var value = role.Value ?? "";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="Roles" value="@value"
                                   id="role_@value"
                                   @(Model.Roles != null && Model.Roles.Contains(value) ? "checked" : "") />
                            <label class="form-check-label" for="role_@value">
                                <span class="badge bg-gradient bg-secondary px-3 py-2 fs-6 shadow-sm">@role.Text</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        
        <div class="modal-footer">
            <button type="submit" class="btn btn-primary shadow">儲存</button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
        </div>

    </form>
</div>












@* 除錯用
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var modelState in ViewData.ModelState)
            {
                foreach (var error in modelState.Value.Errors)
                {
                    <li>@modelState.Key：@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}
*@

