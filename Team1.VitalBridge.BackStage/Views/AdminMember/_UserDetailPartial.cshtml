@using Team1.VitalBridge.BackStage.Models.ViewModels
@model UserViewModel

<div class="modal-body">
    <div class="container-fluid">

        @* <h3 class="mb-4 border-bottom pb-2 text-primary">編輯會員資料</h3> *@

        <div class="row mb-3">
            <!-- 一欄：會員代碼 -->
            <div class="col-12">
                <h5 class="fw-bold text-primary">會員代碼：@Model.UserId</h5>
            </div>
        </div>

        <div class="row mb-3">
            <!-- 左欄：基本資訊 -->
            <div class="col-md-6">
                <p class="mb-2">
                    <span class="fw-semibold">姓名：</span>@Model.Name
                </p>
                <p class="mb-2">
                    <span class="fw-semibold">Email：</span>
                    <span class="text-break">@Model.Email</span>
                </p>
                <p class="mb-2">
                    <span class="fw-semibold">手機：</span>@Model.Phone
                </p>
                <p class="mb-2">
                    <span class="fw-semibold">身分：</span>
                    @if (Model.RoleDisplay != null && Model.RoleDisplay.Any())
                    {
                        foreach (var role in Model.RoleDisplay)
                        {
                            <span class="badge bg-secondary me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">無</span>
                    }


                </p>
                <p class="mb-2">
                    <span class="fw-semibold">狀態：</span>
                    @if (Model.Status == "active")
                    {
                        <span class="badge bg-success">正常</span>
                    }
                    else if (Model.Status == "frozen")
                    {
                        <span class="badge bg-secondary">凍結</span>
                    }
                    else if (Model.Status == "unverified")
                    {
                        <span class="badge bg-warning text-dark">未開通</span>
                    }
                    else if (Model.Status == "banned")
                    {
                        <span class="badge bg-danger">停權</span>
                    }
                    else
                    {
                        <span class="badge bg-dark">@Model.Status</span>
                    }
                </p>
            </div>

            <!-- 右欄：地址資訊 -->
            <div class="col-md-6">
                <p class="mb-2">
                    @* <span class="fw-semibold">縣市：</span>@Model.CityId *@
                    <span class="fw-semibold">縣市：</span>@Model.CityName
                </p>
                <p class="mb-2">
                    @* <span class="fw-semibold">鄉鎮：</span>@Model.TownshipId *@
                    <span class="fw-semibold">鄉鎮：</span>@Model.TownshipName
                </p>
                <p class="mb-2">
                    <span class="fw-semibold">地址：</span>
                    <span class="text-break">@Model.Address</span>
                </p>
            </div>
        </div>

        <div class="row text-muted small">
            <div class="col-12">
                <span class="fw-semibold">建立時間：</span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")<br />
                <span class="fw-semibold">最後更新：</span>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")<br />
                <span class="fw-semibold">最後登入：</span>@(Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "尚未登入")
            </div>
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">關閉</button>
</div>
