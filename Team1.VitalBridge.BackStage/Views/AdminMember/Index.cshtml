@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "會員清單";
}

<div class="container-fluid px-2">
    <h2 class="mb-4">會員清單</h2>

    <form method="get">
        <div class="row mb-3">
            <div class="col-md-3">
                <label>狀態</label>
                <select class="form-select">
                    <option value="">全部</option>
                    <option value="active">活躍（正常）</option>
                    <option value="frozen">凍結（太久沒用）</option>
                    <option value="unverified">未開通（尚未驗證）</option>
                    <option value="banned">停權（禁止登入）</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>縣市</label>
                <select class="form-select">
                    <option value="">全部</option>
                    <option value="Taipei">台北市</option>
                    <option value="Tainan">台南市</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>鄉鎮</label>
                <select class="form-select">
                    <option value="">全部</option>
                    <option value="Xinyi">信義區</option>
                    <option value="Anping">安平區</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>搜尋</label>
                <input type="text" class="form-control" placeholder="請輸入姓名或 Email">
            </div>
        </div>

        <div class="row mb-3 justify-content-between align-items-center">
            <div class="col-auto">
                <label class="me-2">每頁顯示筆數：</label>
                <select class="form-select d-inline-block w-auto">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">篩選</button>
            </div>
        </div>
    </form>

    <table class="table table-hover table-bordered align-middle">
        <thead class="table-primary text-center">
            <tr>
                @* <th>會員編號</th> *@
                <th><a href="#" class="text-decoration-none">姓名 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">Email <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">聯絡電話 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">身分 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">狀態 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">縣市 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">鄉鎮 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">詳細地址 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">註冊時間 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th><a href="#" class="text-decoration-none">最後登入 <i class="bi bi-caret-up-fill ms-1 text-muted"></i></a></th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    @* <td>@user.UserId</td> *@
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>
                        @string.Join(", ", user.RoleDisplay)
                    </td>

                    @{
                        // 依 status 同時決定 badge 顏色與顯示文字
                        var (badgeCss, statusText) = user.Status switch
                        {
                            "active" => ("success", "活躍"),    // 綠色
                            "frozen" => ("secondary", "凍結"),    // 灰色
                            "unverified" => ("warning text-dark", "未開通"), // 黃底黑字
                            "banned" => ("danger", "停權"),    // 紅色
                            _ => ("secondary", user.Status) // 其他狀態直接顯示原值
                        };
                    }
                    <td>
                        <span class="badge bg-@badgeCss">@statusText</span>
                    </td>
                    <td>@user.CityName</td>
                    <td>@user.TownshipName</td>
                    <td>@user.Address</td>


                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-center">
                        @* <a asp-action="Detail" asp-route-userId="@user.UserId" class="btn btn-sm btn-info me-1">詳細</a> *@
                        <button class="btn btn-sm btn-info me-1" onclick="showUserDetail('@user.UserId')">詳細</button>


                        @* <a asp-action="Edit" asp-route-userId="@user.UserId" class="btn btn-sm btn-warning">編輯</a> *@
                        <button class="btn btn-sm btn-warning" onclick="showEditMember('@user.UserId')">編輯</button>


                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            <li class="page-item disabled"><a class="page-link" href="#">上一頁</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">下一頁</a></li>
        </ul>
    </nav>
</div>



@* 詳細資訊(彈窗) *@
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                 <h3 class="text-primary">會員詳細資料</h3> 
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div> 

            <div id="userDetailContainer"></div>

        </div>
    </div>
</div>


@* 編輯資訊(彈窗) *@
<div class="modal fade" id="editMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" >
            <div class="modal-header">
                <h3 class="text-primary">編輯會員資料</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="editMemberContainer"></div>
            <!-- 內容由 AJAX 載入 -->
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // ===== 會員詳細 =====
        const userDetailModal = new bootstrap.Modal(document.getElementById('userDetailModal'));
        function showUserDetail(userId) {
            $('#userDetailContainer').html('載入中...');
            $.get('@Url.Action("Detail", "AdminMember")', { userId })
                .done(function (html) {
                    $('#userDetailContainer').html(html);
                    userDetailModal.show();
                })
                .fail(function (xhr) {
                    alert('載入失敗：' + xhr.status);
                    console.error(xhr.responseText);
                });
        }

        // ===== 編輯會員（載入 Partial 並開啟彈窗） =====
        const editMemberModal = new bootstrap.Modal(document.getElementById('editMemberModal'));

        function showEditMember(userId) {
            $('#editMemberContainer').html('載入中...');

            $.get('@Url.Action("Edit", "AdminMember")', { userId })
                .done(function (html) {
                    $('#editMemberContainer').html(html);

                    // 初始化縣市與鄉鎮（全 AJAX 載入）
                    initEditMemberLocation();

                    editMemberModal.show();
                })
                .fail(function (xhr) {
                    alert('載入失敗：' + xhr.status);
                    console.error(xhr.responseText);
                });
        }

        // 初始化縣市 / 鄉鎮下拉（全 AJAX 載入）
        function initEditMemberLocation() {
            const $wrap = $('#editMemberContainer');
            const $city = $wrap.find('#CityId');
            const $town = $wrap.find('#TownshipId');

            const selectedCityId = $city.data('selected');   // Partial 內 hidden data
            const selectedTownId = $town.data('selected');   // Partial 內 hidden data

            // 先載入城市
            loadCitiesForEdit(selectedCityId, function() {
                // 如果有已選城市 → 載入對應鄉鎮
                if (selectedCityId) {
                    loadTownshipsForEdit(selectedCityId, selectedTownId);
                }
            });

            // 城市變更 → 重新載入鄉鎮
            $city.off('change').on('change', function () {
                loadTownshipsForEdit($(this).val(), null);
            });
        }

        // 載入城市
        function loadCitiesForEdit(selectedCityId, callback) {
            const $city = $('#editMemberContainer').find('#CityId');
            $city.empty().append('<option value="">請選擇縣市</option>');

            $.getJSON('/api/locations/cities')
                .done(function (data) {
                    data.forEach(function (c) {
                        const opt = $('<option>', { value: c.id, text: c.name });
                        if (selectedCityId && String(selectedCityId) === String(c.id)) {
                            opt.prop('selected', true);
                        }
                        $city.append(opt);
                    });
                    if (callback) callback();
                })
                .fail(function () {
                    $city.html('<option value="">載入失敗</option>');
                });
        }

        // 載入鄉鎮
        function loadTownshipsForEdit(cityId, selectedTownshipId) {
            const $town = $('#editMemberContainer').find('#TownshipId');
            $town.empty().append('<option value="">請選擇鄉鎮</option>');

            if (!cityId) return;

            $.getJSON(`/api/locations/cities/${cityId}/townships`)
                .done(function (data) {
                    data.forEach(function (t) {
                        const opt = $('<option>', { value: t.id, text: t.name });
                        if (selectedTownshipId && String(selectedTownshipId) === String(t.id)) {
                            opt.prop('selected', true);
                        }
                        $town.append(opt);
                    });
                })
                .fail(function () {
                    $town.html('<option value="">載入失敗</option>');
                });
        }

        // ===== 編輯表單送出（AJAX） =====
        $(document).on('submit', '#editMemberForm', function (e) {
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: $(this).attr('action'),
                data: $(this).serialize(),
                success: function (res) {
                    if (res && res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editMemberModal')).hide();
                        location.reload();
                    } else {
                        // 驗證失敗會回 Partial → 重新初始化城市/鄉鎮
                        $('#editMemberContainer').html(res);
                        initEditMemberLocation();
                    }
                },
                error: function () {
                    alert('儲存失敗，請稍後再試');
                }
            });
        });
    </script>
}

