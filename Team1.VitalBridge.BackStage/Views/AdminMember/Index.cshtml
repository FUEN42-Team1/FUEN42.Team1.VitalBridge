@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "會員清單";

    // 供「身分」篩選下拉用：從模型彙總出不重複的角色顯示名稱
    var roleOptions = Model
        .SelectMany(m => m.RoleDisplay ?? Enumerable.Empty<string>())
        .Select(s => s?.Trim())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

@section Styles {
    <!-- DataTables 樣式 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <style>
        .td-truncate {
            max-width: 280px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .text-nowrap {
            white-space: nowrap !important;
        }

        /* 隱藏 DataTables 內建搜尋列，我們使用自訂篩選區 */
        .dt-search, .dataTables_filter {
            display: none;
        }

        /* Email 欄位字體縮小 */
        #membersTable td:nth-child(2) {
            font-size: 0.9rem; /* 或 14px */
        }

        /* 縣市欄位字體縮小 */
        #membersTable td:nth-child(6) {
            font-size: 0.9rem;
        }

        /* 鄉鎮欄位字體縮小 */
        #membersTable td:nth-child(7) {
            font-size: 0.9rem;
        }

        /* 詳細地址欄位字體縮小 */
        #membersTable td:nth-child(8) {
            font-size: 0.9rem;
        }
    </style>
}

<div class="container-fluid px-2">
    <h2 class="mb-3">會員清單</h2>

    <!-- 外部篩選區（只驅動 DataTables，不送表單到伺服器） -->
    <form id="filterForm" class="mb-3">
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <label class="form-label">狀態</label>
                <select class="form-select" id="statusSelect">
                    <option value="">全部</option>
                    <option value="正常">正常</option>
                    <option value="凍結">凍結</option>
                    <option value="未開通">未開通</option>
                    <option value="停權">停權</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label">縣市</label>
                <select class="form-select" id="citySelect">
                    <option value="">全部</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label">鄉鎮</label>
                <select class="form-select" id="townSelect">
                    <option value="">全部</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label">身分</label>
                <select class="form-select" id="roleSelect">
                    <option value="">全部</option>
                    @foreach (var r in roleOptions)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>

            <div class="col-sm-8 col-md-6">
                <label class="form-label">關鍵字</label>
                <input type="text" class="form-control" id="keywordInput" placeholder="姓名 / Email / 電話 / 地址…">
            </div>
            <div class="col-sm-4 col-md-6 d-flex align-items-end justify-content-between">
                <div>
                    <label class="me-2">每頁顯示筆數：</label>
                    <select class="form-select d-inline-block w-auto" id="pageLenSelect">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">套用篩選</button>
                    <button type="button" class="btn btn-outline-secondary ms-2" id="resetBtn">重置</button>
                </div>
            </div>
        </div>
    </form>

    <table id="membersTable" class="table table-hover table-bordered align-middle" style="width:100%">
        <thead class="table-primary text-center">
            <tr>
                <th>姓名</th>
                <th>Email</th>
                <th>聯絡電話</th>
                <th>身分</th>
                <th>狀態</th>
                <th>縣市</th>
                <th>鄉鎮</th>
                <th>詳細地址</th>
                @* <th>註冊時間</th> *@
                <th>最後登入</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var (badgeCss, statusText) = user.Status switch
                {
                    "active" => ("success", "正常"),
                    "frozen" => ("secondary", "凍結"),
                    "unverified" => ("warning text-dark", "未開通"),
                    "banned" => ("danger", "停權"),
                    _ => ("secondary", user.Status ?? "—")
                };
                <tr data-city-id="@(user.CityId?.ToString() ?? "")" data-town-id="@(user.TownshipId?.ToString() ?? "")">
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@string.Join(", ", user.RoleDisplay ?? Enumerable.Empty<string>())</td>
                    <td><span class="badge bg-@badgeCss">@statusText</span></td>
                    <td>@user.CityName</td>
                    <td>@user.TownshipName</td>
                    <td class="td-truncate" title="@user.Address">@user.Address</td>
                    @* <td data-order="@user.CreatedAt.Ticks">@user.CreatedAt.ToString("yyyy/MM/dd")</td> *@
                    <td data-order="@(user.LastLoginAt?.Ticks ?? 0)">
                        @(user.LastLoginAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                    </td>
                    <td class="text-center text-nowrap">
                        <button class="btn btn-sm btn-info me-1" onclick="showUserDetail('@user.UserId')">詳細</button>
                        <button class="btn btn-sm btn-warning" onclick="showEditMember('@user.UserId')">編輯</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* 詳細資訊(彈窗) *@
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="text-primary mb-0">會員詳細資料</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="userDetailContainer"></div>
        </div>
    </div>
</div>

@* 編輯資訊(彈窗) *@
<div class="modal fade" id="editMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="text-primary mb-0">編輯會員資料</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="editMemberContainer"></div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 若你的 Layout 已載入 jQuery，這行可拿掉；否則保留 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>
        // ===== DataTables 初始化 =====
        const dt = $('#membersTable').DataTable({
            ordering: true,
            searching: true,     // 保持開啟，並用 ext.search 加上外部條件
            pageLength: 10,
            lengthChange: false, // 用自訂的「每頁筆數」下拉
            language: { url: "https://cdn.datatables.net/plug-ins/1.13.8/i18n/zh-HANT.json" },
            columnDefs: [
                { targets: -1, orderable: false, className: 'text-center text-nowrap' }
            ]
        });

        // ===== 外部篩選控制 =====
        const $status  = $('#statusSelect');
        const $city    = $('#citySelect');
        const $town    = $('#townSelect');
        const $role    = $('#roleSelect');
        const $keyword = $('#keywordInput');
        const $pageLen = $('#pageLenSelect');

        // 客製過濾器：狀態/縣市ID/鄉鎮ID/身分 + 關鍵字
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            // 只作用於此表，避免影響其他頁面 DataTables
            if (settings.nTable && settings.nTable.id !== 'membersTable') return true;

            // 依欄位順序取得資料（僅供關鍵字匹配使用）
            const name    = data[0] || '';
            const email   = data[1] || '';
            const phone   = data[2] || '';
            const roles   = data[3] || '';
            const cityTxt = data[5] || ''; // 顯示名稱（for 關鍵字）
            const townTxt = data[6] || '';
            const address = data[7] || '';

            // 從當列的 DOM dataset 讀出 City/Town 的「ID」
            const rowNode = dt.row(dataIndex).node();
            const cityIdOnRow = (rowNode?.dataset?.cityId ?? '').toString();
            const townIdOnRow = (rowNode?.dataset?.townId ?? '').toString();

            // 狀態用 badge 文字取得
            const statusText = $(rowNode).find('td:eq(4) .badge').text().trim();

            const s  = ($status.val()  || '').toString().toLowerCase();
            const c  = ($city.val()    || '').toString(); // 這是 ID
            const t  = ($town.val()    || '').toString(); // 這是 ID
            const r  = ($role.val()    || '').toString().toLowerCase();
            const kw = ($keyword.val() || '').toString().toLowerCase();

            // 狀態（中文包含）
            if (s && !statusText.toLowerCase().includes(s)) return false;

            // 縣市/鄉鎮用 ID「等於」比對
            if (c && cityIdOnRow !== c) return false;
            if (t && townIdOnRow !== t) return false;

            // 身分（字串包含）
            if (r && !roles.toLowerCase().includes(r)) return false;

            // 關鍵字搜尋（名稱/Email/電話/身分/顯示用地名/地址）
            if (kw) {
                const haystack = (name + ' ' + email + ' ' + phone + ' ' + roles + ' ' + cityTxt + ' ' + townTxt + ' ' + address).toLowerCase();
                if (!haystack.includes(kw)) return false;
            }
            return true;
        });

        // 提交按鈕 → 觸發過濾
        $('#filterForm').on('submit', function(e){
            e.preventDefault();
            dt.draw();
        });

        // 重置
        $('#resetBtn').on('click', function(){
            $status.val('');
            $city.val('');

            // 清空鄉鎮下拉回「全部」
            $town.empty().append('<option value="">全部</option>').val('');

            $role.val('');
            $keyword.val('');
            $pageLen.val('10').trigger('change');
            dt.search(''); // 清掉 DT 內建搜尋字串
            dt.draw();
        });

        // 每頁筆數
        $pageLen.on('change', function () {
            dt.page.len(parseInt(this.value || '10', 10)).draw();
        });

        // 即時關鍵字（若改為按下「套用」才搜尋，註解這行）
        $keyword.on('input', function(){ dt.draw(); });

        // ===== 你的原本 Modal + AJAX（保持不動） =====

        // 會員詳細
        const userDetailModal = new bootstrap.Modal(document.getElementById('userDetailModal'));
        function showUserDetail(userId) {
            $('#userDetailContainer').html('載入中...');
            $.get('@Url.Action("Detail", "AdminMember")', { userId })
                .done(function (html) {
                    $('#userDetailContainer').html(html);
                    userDetailModal.show();
                })
                .fail(function (xhr) {
                    alert('載入失敗：' + xhr.status);
                    console.error(xhr.responseText);
                });
        }
        window.showUserDetail = showUserDetail;

        // 編輯會員
        const editMemberModal = new bootstrap.Modal(document.getElementById('editMemberModal'));
        function showEditMember(userId) {
            $('#editMemberContainer').html('載入中...');
            $.get('@Url.Action("Edit", "AdminMember")', { userId })
                .done(function (html) {
                    $('#editMemberContainer').html(html);
                    initEditMemberLocation();
                    editMemberModal.show();
                })
                .fail(function (xhr) {
                    alert('載入失敗：' + xhr.status);
                    console.error(xhr.responseText);
                });
        }
        window.showEditMember = showEditMember;

        // （以下維持你的載入城市/鄉鎮與表單送出程式）
        function initEditMemberLocation() {
            const $wrap = $('#editMemberContainer');
            const $city = $wrap.find('#CityId');
            const $town = $wrap.find('#TownshipId');

            const selectedCityId = $city.data('selected');
            const selectedTownId = $town.data('selected');

            loadCitiesForEdit(selectedCityId, function() {
                if (selectedCityId) loadTownshipsForEdit(selectedCityId, selectedTownId);
            });

            $city.off('change').on('change', function () {
                loadTownshipsForEdit($(this).val(), null);
            });
        }

        function loadCitiesForEdit(selectedCityId, callback) {
            const $city = $('#editMemberContainer').find('#CityId');
            $city.empty().append('<option value="">請選擇縣市</option>');

            $.getJSON('/api/locations/cities')
                .done(function (data) {
                    data.forEach(function (c) {
                        const opt = $('<option>', { value: c.id, text: c.name });
                        if (selectedCityId && String(selectedCityId) === String(c.id)) {
                            opt.prop('selected', true);
                        }
                        $city.append(opt);
                    });
                    if (callback) callback();
                })
                .fail(function () {
                    $city.html('<option value="">載入失敗</option>');
                });
        }

        function loadTownshipsForEdit(cityId, selectedTownshipId) {
            const $town = $('#editMemberContainer').find('#TownshipId');
            $town.empty().append('<option value="">請選擇鄉鎮</option>');

            if (!cityId) return;

            $.getJSON(`/api/locations/cities/${cityId}/townships`)
                .done(function (data) {
                    data.forEach(function (t) {
                        const opt = $('<option>', { value: t.id, text: t.name });
                        if (selectedTownshipId && String(selectedTownshipId) === String(t.id)) {
                            opt.prop('selected', true);
                        }
                        $town.append(opt);
                    });
                })
                .fail(function () {
                    $town.html('<option value="">載入失敗</option>');
                });
        }

        $(document).on('submit', '#editMemberForm', function (e) {
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: $(this).attr('action'),
                data: $(this).serialize(),
                success: function (res) {
                    if (res && res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editMemberModal')).hide();
                        location.reload();
                    } else {
                        $('#editMemberContainer').html(res);
                        initEditMemberLocation();
                    }
                },
                error: function () {
                    alert('儲存失敗，請稍後再試');
                }
            });
        });
    </script>

    <script>
        // ===== 外部篩選下拉：載入城市/鄉鎮（ID 為 value） =====
        $(function () {
            // 載入所有縣市
            function loadCitiesForFilter(selectedCityId) {
                const $city = $('#citySelect');
                $city.empty().append('<option value="">全部</option>');
                $.getJSON('/api/locations/cities')
                    .done(function (data) {
                        data.forEach(function (c) {
                            const opt = $('<option>', { value: c.id, text: c.name });
                            if (selectedCityId && String(selectedCityId) === String(c.id)) {
                                opt.prop('selected', true);
                            }
                            $city.append(opt);
                        });
                    })
                    .fail(function () {
                        $city.html('<option value="">載入失敗</option>');
                    });
            }

            // 根據選定縣市載入鄉鎮
            function loadTownshipsForFilter(cityId, selectedTownshipId) {
                const $town = $('#townSelect');
                $town.empty().append('<option value="">全部</option>');
                if (!cityId) return;
                $.getJSON(`/api/locations/cities/${cityId}/townships`)
                    .done(function (data) {
                        data.forEach(function (t) {
                            const opt = $('<option>', { value: t.id, text: t.name });
                            if (selectedTownshipId && String(selectedTownshipId) === String(t.id)) {
                                opt.prop('selected', true);
                            }
                            $town.append(opt);
                        });
                    })
                    .fail(function () {
                        $town.html('<option value="">載入失敗</option>');
                    });
            }

            // 初始化縣市
            loadCitiesForFilter();

            // 當縣市改變時，載入對應鄉鎮
            $('#citySelect').on('change', function () {
                const cityId = $(this).val();
                loadTownshipsForFilter(cityId, null);
            });

            // 若有預設值可在這裡載入
            // loadTownshipsForFilter($('#citySelect').val(), null);
        });
    </script>
}
