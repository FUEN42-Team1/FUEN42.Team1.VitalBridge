@using Team1.VitalBridge.BackStage.Models.ViewModels
@model UserViewModel
@{
    ViewData["Title"] = "編輯會員資料";
    var allCities = ViewBag.AllCities as List<SelectListItem>;
    var allTownships = ViewBag.AllTownships as List<SelectListItem>;
    var allRoles = ViewBag.AllRoles as List<SelectListItem>;
}

<h1 class="mb-4">編輯會員資料</h1>

<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="CityId" class="form-label">縣市</label>
            <select asp-for="CityId" class="form-select" asp-items="allCities" id="CityId">
                <option value="">請選擇縣市</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="TownshipId" class="form-label">鄉鎮</label>
            <select asp-for="TownshipId" class="form-select" asp-items="allTownships" id="TownshipId">
                <option value="">請選擇鄉鎮</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="col-md-12">
            <label class="form-label">會員身分</label>
            <div>
                @foreach (var role in allRoles)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               name="Roles" value="@role.Value"
                        @(Model.Roles.Contains(role.Value) ? "checked" : "") />
                        <label class="form-check-label">@role.Text</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">儲存</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">取消</a>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            const citySelect = $('#CityId');
            const townshipSelect = $('#TownshipId');

            citySelect.on('change', function () {
                const cityId = $(this).val();
                townshipSelect.empty().append($('<option>', {
                    value: '',
                    text: '載入中...'
                }));

                if (!cityId) return;

                $.get(`/api/location/townships?cityId=${cityId}`, function (data) {
                    townshipSelect.empty().append($('<option>', {
                        value: '',
                        text: '請選擇鄉鎮'
                    }));
                    data.forEach(t => {
                        townshipSelect.append($('<option>', {
                            value: t.id,
                            text: t.name
                        }));
                    });
                });
            });
        });
    </script>
}
