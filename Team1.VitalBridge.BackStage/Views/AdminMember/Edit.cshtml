@using Team1.VitalBridge.BackStage.Models.ViewModels
@model UserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<h1 class="mb-4">編輯會員資料</h1>

<form asp-action="Edit" asp-route-userId="@Model.UserId" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <!-- Read-only but still send value -->
    <input type="hidden" asp-for="UserId" />

    <div class="row g-3">
        <!-- UserId (read-only) -->
        <div class="col-md-6">
            <label asp-for="UserId" class="form-label"></label>
            <input asp-for="UserId" class="form-control" readonly />
        </div>

        <!-- Email (read-only) -->
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <!-- Name -->
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Phone -->
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <!-- CityId -->
        <div class="col-md-4">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" asp-items="ViewBag.Cities" class="form-select"></select>
            <span asp-validation-for="CityId" class="text-danger"></span>
        </div>

        <!-- TownshipId -->
        <div class="col-md-4">
            <label asp-for="TownshipId" class="form-label"></label>
            <select asp-for="TownshipId" asp-items="ViewBag.Townships" class="form-select"></select>
            <span asp-validation-for="TownshipId" class="text-danger"></span>
        </div>

        <!-- Status -->
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="active">活躍</option>
                <option value="frozen">凍結</option>
                <option value="unverified">未開通</option>
                <option value="banned">停權</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <!-- Address -->
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" placeholder="範例：松山路123號5樓" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <!-- CreatedAt (read-only) -->
        <div class="col-md-4">
            <label asp-for="CreatedAt" class="form-label"></label>
            <input asp-for="CreatedAt" class="form-control" readonly />
        </div>

        <!-- UpdatedAt (read-only) -->
        <div class="col-md-4">
            <label asp-for="UpdatedAt" class="form-label"></label>
            <input asp-for="UpdatedAt" class="form-control" readonly />
        </div>

        <!-- LastLoginAt (read-only) -->
        <div class="col-md-4">
            <label asp-for="LastLoginAt" class="form-label"></label>
            <input asp-for="LastLoginAt" class="form-control" readonly />
        </div>


        <label class="form-label">角色身份</label>
        @foreach (var role in (List<SelectListItem>)ViewBag.AllRoles)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="SelectedRoleIds"
                       value="@role.Value"
                       @(Model.SelectedRoleIds.Contains(int.Parse(role.Value)) ? "checked" : "") />
                <label class="form-check-label">@role.Text</label>
            </div>
        }

    </div>





    <!-- Buttons -->
    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">儲存</button>
        @* <a asp-action="UserList" class="btn btn-outline-secondary">取消</a> *@
        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>

    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
