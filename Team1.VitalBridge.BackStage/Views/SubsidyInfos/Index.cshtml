@model Team1.VitalBridge.BackStage.Models.ViewModels.PaginatedResult<Team1.VitalBridge.BackStage.Models.EFModels.SubsidyInfo>

@{
    ViewData["Title"] = "補助清單";
    var currentSearchQuery = Context.Request.Query["searchQuery"];
    var currentPageSize = Context.Request.Query["pageSize"];
}

@section Styles {
    <style>
        .table thead th {
            background-color: #f8f9fa;
            color: #212529;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
        }

        .modal-header, .modal-footer {
            background-color: #f8f9fa;
        }

        .pagination-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .pagination-container {
                flex-direction: row;
                justify-content: space-between;
            }
        }

        @@media (max-width: 576px) {
            .action-buttons {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 5px;
            }

                .action-buttons .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h6 class="m-0 font-weight-bold text-primary">補助清單</h6>
            </div>
            <div class="col-sm-6 text-end">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#subsidyInfoModal" id="createBtn">
                    <i class="fas fa-plus"></i> 新增補助
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 d-flex align-items-center">
                <label for="pageSize" class="me-2">顯示</label>
                <select id="pageSize" class="form-select" style="width: auto;">
                    @{
                        var pageSizes = new[] { 5, 10, 20, 50 };
                        foreach (var size in pageSizes)
                        {
                            if (size.ToString() == currentPageSize)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    }
                </select>
                <span class="ms-2">筆結果</span>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0">
                <label for="searchQuery" class="me-2">搜尋:</label>
                <input type="search" id="searchQuery" class="form-control" placeholder="請輸入關鍵字" style="width: auto;" value="@currentSearchQuery" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered" id="subsidyInfoTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            補助描述
                        </th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="#" class="btn btn-warning btn-sm edit-btn" data-id="@item.Id" data-description="@item.Description" data-bs-toggle="modal" data-bs-target="#subsidyInfoModal">
                                        <i class="fas fa-edit"></i> 編輯
                                    </a>
                                    <a href="#" class="btn btn-danger btn-sm delete-btn" data-id="@item.Id">
                                        <i class="fas fa-trash"></i> 刪除
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <div class="text-nowrap mb-2 mb-md-0" id="pagination-info">
                顯示第 @(Model.Items.Count > 0 ? (Model.PageSize * (Model.PageNumber - 1) + 1).ToString() : "0")
                至 @(Model.PageSize * (Model.PageNumber - 1) + Model.Items.Count)
                筆結果，共 <span id="total-count">@Model.TotalCount</span> 筆
            </div>
            <ul class="pagination mb-0 flex-wrap justify-content-center" id="pagination-links">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">第一頁</span>
                        <span class="d-md-none">&lt;&lt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">上一頁</span>
                        <span class="d-md-none">&lt;</span>
                    </a>
                </li>
                @{
                    var startPage = Math.Max(1, Model.PageNumber - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "") d-none d-sm-block">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">下一頁</span>
                        <span class="d-md-none">&gt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">最後一頁</span>
                        <span class="d-md-none">&gt;&gt;</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalLabel">訊息</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="messageModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subsidyInfoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">新增補助</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="subsidyInfoForm">
                    <input type="hidden" id="subsidyInfoId" name="Id" value="" />
                    <div class="mb-3">
                        <label for="subsidyInfoDescription" class="form-label">補助描述</label>
                        <input type="text" class="form-control" id="subsidyInfoDescription" name="Description" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-success" id="saveBtn">儲存</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">刪除確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmText">您確定要刪除這筆資料嗎？</p>
                <input type="hidden" id="deleteId" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">確定刪除</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const currentSearchQuery = urlParams.get('searchQuery') || '';
        const currentPageSize = urlParams.get('pageSize') || 10;
        const currentPage = parseInt(urlParams.get('page') || 1);

        const subsidyInfoModal = new bootstrap.Modal(document.getElementById('subsidyInfoModal'));
        const deleteConfirmModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        const messageModal = new bootstrap.Modal(document.getElementById('messageModal'));

        function showMessageModal(message, reloadPage = false) {
            $('#messageModalBody').html(message);
            messageModal.show();

            $('#messageModal').on('hidden.bs.modal', function () {
                if (reloadPage) {
                    window.location.reload();
                }
                $('#messageModal').off('hidden.bs.modal');
            });
        }

        function createTableRow(item) {
            return `
                <tr data-id="${item.id}">
                    <td>${item.description}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="#" class="btn btn-warning btn-sm edit-btn" data-id="${item.id}" data-description="${item.description}" data-bs-toggle="modal" data-bs-target="#subsidyInfoModal">
                                <i class="fas fa-edit"></i> 編輯
                            </a>
                            <a href="#" class="btn btn-danger btn-sm delete-btn" data-id="${item.id}">
                                <i class="fas fa-trash"></i> 刪除
                            </a>
                        </div>
                    </td>
                </tr>
            `;
        }

        $(document).ready(function () {
            $('#searchQuery').val(currentSearchQuery);
            $('#pageSize').val(currentPageSize);

            $('#pageSize').on('change', function () {
                var newPageSize = $(this).val();
                window.location.href = '@Url.Action("Index", "SubsidyInfos")' + '?page=1&pageSize=' + newPageSize + '&searchQuery=' + encodeURIComponent(currentSearchQuery);
            });

            $('#searchQuery').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var newSearchQuery = $(this).val();
                    var currentPageSize = $('#pageSize').val();
                    window.location.href = '@Url.Action("Index", "SubsidyInfos")' + '?page=1&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(newSearchQuery);
                }
            });

            $("#createBtn").on("click", function () {
                $("#modalTitle").text("新增補助");
                $("#subsidyInfoForm")[0].reset();
                $("#subsidyInfoId").val("");
                $("#saveBtn").removeClass("btn-warning").addClass("btn-success");
                subsidyInfoModal.show();
            });

            $("#subsidyInfoTable").on("click", ".edit-btn", function () {
                var id = $(this).data("id");
                var description = $(this).data("description");
                $("#modalTitle").text("編輯補助");
                $("#subsidyInfoId").val(id);
                $("#subsidyInfoDescription").val(description);
                $("#saveBtn").removeClass("btn-success").addClass("btn-warning");
                subsidyInfoModal.show();
            });

            $("#subsidyInfoDescription").on("keydown", function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $("#saveBtn").click();
                }
            });

            $("#saveBtn").on("click", function () {
                var id = $("#subsidyInfoId").val();
                var description = $("#subsidyInfoDescription").val();
                var url = "";

                if (description.trim() === "") {
                    showMessageModal("補助描述不能為空。");
                    return;
                }

                var data = { Description: description };
                if (id) {
                    url = "/SubsidyInfos/Edit/" + id;
                    data.Id = id;
                } else {
                    url = "/SubsidyInfos/Create";
                }

                $.ajax({
                    url: url,
                    type: "POST",
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            showMessageModal(response.message, true);
                        } else {
                            showMessageModal(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        showMessageModal("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        subsidyInfoModal.hide();
                    }
                });
            });

            $("#subsidyInfoTable").on("click", ".delete-btn", function () {
                var id = $(this).data("id");
                $("#deleteId").val(id);
                deleteConfirmModal.show();
            });

            $("#confirmDeleteBtn").on("click", function () {
                var id = $("#deleteId").val();

                $.ajax({
                    url: "/SubsidyInfos/Delete/" + id,
                    type: "POST",
                    success: function (response) {
                        if (response.success) {
                            showMessageModal(response.message, true);
                        } else {
                            showMessageModal(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        showMessageModal("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        deleteConfirmModal.hide();
                    }
                });
            });

            $('#messageModal').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    messageModal.hide();
                }
            });
        });
    </script>
}