@model Team1.VitalBridge.BackStage.Models.ViewModels.ContentTypeCategoryPairCreateViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>CreateContentTypeCategoryPair</h1>

<h4>ContentTypeCategoryPairCreateViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateContentTypeCategoryPair">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Content Type Dropdown -->
            <div class="form-group">
                <label asp-for="ContentTypeId" class="control-label"></label>
                <select asp-for="ContentTypeId" class="form-control" id="ContentTypeIdDropdown">
                    <option value="">-- Select Content Type --</option>
                    @* Options will be populated via AJAX. If Model.AvailableContentTypes has initial data, asp-items would render it. *@
                    @* <option value="1">Example Type 1</option> *@
                </select>
                <span asp-validation-for="ContentTypeId" class="text-danger"></span>
            </div>

            <!-- Content Category Dropdown -->
            <div class="form-group">
                <label asp-for="ContentCategoryId" class="control-label"></label>
                <select asp-for="ContentCategoryId" class="form-control" id="ContentCategoryIdDropdown">
                    <option value="">-- Select Existing Content Category (or leave blank for new) --</option>
                    @* Options will be populated via AJAX. *@
                    @* <option value="101">Example Category A</option> *@
                </select>
                <span asp-validation-for="ContentCategoryId" class="text-danger"></span>
            </div>


            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsEnabled" /> @Html.DisplayNameFor(model => model.IsEnabled)
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        $(document).ready(function () {
        }
}
