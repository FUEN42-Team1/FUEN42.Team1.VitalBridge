@model Team1.VitalBridge.BackStage.Models.ViewModels.Admin.AdminEditVM

<form asp-action="Edit" asp-controller="AdminUsers" method="post" id="admin-edit-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">名稱</label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">聯絡電話</label>
            <input asp-for="Phone" class="form-control" type="tel" inputmode="tel" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Note" class="form-label">註記</label>
            <textarea asp-for="Note" rows="3" class="form-control" placeholder="補充資訊、交接說明…"></textarea>
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
        <button type="submit" class="btn btn-primary">儲存</button>
    </div>

    <div class="mt-2">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    </div>
</form>
