@using Team1.VitalBridge.BackStage.Models.ViewModels.Admin
@model AdminUserDetailsVM
@{
    ViewData["Title"] = "管理員詳細資料";

    // 狀態外觀設定（可依你的實際狀態字串再擴充）
    string status = (Model.Status ?? "").Trim();
    string statusText = status switch
    {
        "active" => "正常",
        "frozen" => "凍結",
        "unverified" => "未開通",
        "banned" => "停權",
        _ => string.IsNullOrWhiteSpace(status) ? "未知" : status
    };
    string statusClass = status switch
    {
        "active" => "badge bg-success",
        "frozen" => "badge bg-secondary",
        "unverified" => "badge bg-warning text-dark",
        "banned" => "badge bg-danger",
        _ => "badge bg-light text-dark"
    };

    bool isLocked = Model.LockedUntil.HasValue && Model.LockedUntil.Value > DateTime.UtcNow;
    string lockedBadge = isLocked ? "badge bg-danger" : "badge bg-info";
    string lockedText = Model.LockedUntil.HasValue
        ? (isLocked ? $"鎖定中，至 {Model.LockedUntil:yyyy/MM/dd HH:mm}" : $"鎖定到期：{Model.LockedUntil:yyyy/MM/dd HH:mm}")
        : "未鎖定";

    string[] roles = Model.Roles ?? Array.Empty<string>();
    string phoneText = string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone;
    string noteText = string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note;
    string emailText = string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email;

    string fmt(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy/MM/dd HH:mm") : "—";
}

<div class="container-xxl py-4">
    <!-- 頁首與動作 -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">@ViewData["Title"]</h2>
            <div class="text-muted small">
                編號：<code>@Model.UserId</code>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" asp-controller="AdminUsers" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> 返回清單
            </a>
            <a asp-action="Edit" asp-controller="AdminUsers" asp-route-userId="@Model.UserId" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> 編輯
            </a>
        </div>
    </div>

    <!-- 基本資訊 -->
    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="fw-semibold">基本資料</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="@statusClass">@statusText</span>
                            <span class="@lockedBadge">@lockedText</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
                        <dd class="col-sm-9 d-flex align-items-center gap-2">
                            <span id="emailText">@emailText</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-clipboard="#emailText">
                                    複製
                                </button>
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
                        <dd class="col-sm-9">@phoneText</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
                        <dd class="col-sm-9 d-flex align-items-center gap-2">
                            <span class="@statusClass">@statusText</span>
                            @* 顯示原始狀態字串（debug/查核用），不要可刪 *@
                            <small class="text-muted">(@(string.IsNullOrWhiteSpace(Model.Status) ? "—" : Model.Status))</small>
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Note)</dt>
                        <dd class="col-sm-9">@noteText</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- 使用狀態 -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body">
                    <span class="fw-semibold">使用狀態</span>
                </div>
                <div class="card-body">
                    <div class="row gy-2">
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.FailedLoginCount)</div>
                            <div class="fs-5">
                                @((Model.FailedLoginCount ?? 0).ToString())
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.LockedUntil)</div>
                            <div>@(Model.LockedUntil.HasValue ? Model.LockedUntil.Value.ToString("yyyy/MM/dd HH:mm") : "—")</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.LastLoginAt)</div>
                            <div>@fmt(Model.LastLoginAt)</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.LastAdminActionAt)</div>
                            <div>@fmt(Model.LastAdminActionAt)</div>
                        </div>

                    </div>
                    <hr />
                    <div class="row gy-2">
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.CreatedAt)</div>
                            <div>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">@Html.DisplayNameFor(m => m.UpdatedAt)</div>
                            <div>@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 角色/身分 -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-body d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">@Html.DisplayNameFor(m => m.Roles)</span>
                    <a asp-action="EditRoles"
                       asp-controller="AdminUsers"
                       asp-route-userId="@Model.UserId"
                       class="btn btn-sm btn-outline-primary">
                        管理身分
                    </a>
                </div>
                <div class="card-body">
                    @if (roles.Length == 0)
                    {
                        <span class="text-muted">尚未指派任何身分</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var r in roles.OrderBy(x => x))
                            {
                                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">@r</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
}

@section Scripts {
    <script>
        // 簡易複製按鈕（不依賴外部套件）
        document.querySelectorAll('[data-clipboard]').forEach(btn => {
            btn.addEventListener('click', () => {
                const sel = btn.getAttribute('data-clipboard');
                const el = document.querySelector(sel);
                const text = el ? el.textContent.trim() : '';
                if (!text) return;

                navigator.clipboard.writeText(text).then(() => {
                    const original = btn.textContent;
                    btn.textContent = '已複製！';
                    setTimeout(() => btn.textContent = original, 1200);
                });
            });
        });
    </script>
}
