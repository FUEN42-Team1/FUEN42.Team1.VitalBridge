        <!-- ============================================================== -->
        <!-- End Topbar header -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Left Sidebar 這是左側欄 - style you can find in sidebar.scss  -->
        <!-- ============================================================== -->
        <aside class="left-sidebar" data-sidebarbg="skin5">
            <!-- Sidebar scroll-->
            <div class="scroll-sidebar">
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav">
                    <ul id="sidebarnav" class="pt-4">

                        @* 導覽列從這裡新增 *@
                        @* 這是2層的摺疊 *@
                        <li class="sidebar-item">
                            <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)"
                               aria-expanded="false"><i class="mdi mdi-receipt"></i><span class="hide-menu">2層範例 </span></a>
                            <ul aria-expanded="false" class="collapse first-level">
                                <li class="sidebar-item">
                                    <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="test2_1">
                                        <i class="mdi mdi-note-outline"></i><span class="hide-menu">
                                            第2層
                                        </span>
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="test2_2">
                                        <i class="mdi mdi-note-plus"></i><span class="hide-menu"> 第2層 </span>
                                    </a>
                                </li>

                            </ul>
                        </li>
                        <!--廣告輪播-->
                        <li class="sidebar-item">
                            <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)"
                               aria-expanded="false"><i class="mdi mdi-receipt"></i><span class="hide-menu">廣告輪播管理 </span></a>
                            <ul aria-expanded="false" class="collapse first-level">
                                <li class="sidebar-item">
                                    <a class="sidebar-link" asp-area="" asp-controller="Admin" asp-action="AdminPlate">
                                        <i class="mdi mdi-note-outline"></i><span class="hide-menu">
                                            廣告輪播板塊管理
                                        </span>
                                    </a>
                                </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)"
                               aria-expanded="false"><i class="mdi mdi-shopping"></i><span class="hide-menu">線上購物</span></a>
                            <ul aria-expanded="false" class="collapse first-level">
                                <li class="sidebar-item">
                                    <a class="sidebar-link" asp-area="" asp-controller="Products" asp-action="Index">
                                        <i class="mdi mdi-view-list"></i><span class="hide-menu">
                                            商品管理
                                        </span>
                                    </a>
                                </li>
                                @* <li class="sidebar-item"> // 還沒做
                                    <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="test2_2">
                                        <i class="mdi mdi-note-plus"></i><span class="hide-menu">商品分類 </span>
                                    </a>
                                </li> *@

                            </ul>
                        </li>

                            </ul>
                        </li>


                        @* 這是沒有折疊 *@
                        <li class="sidebar-item">
                            <a class="sidebar-link waves-effect waves-dark sidebar-link"
                               aria-expanded="false" asp-area="" asp-controller="Home" asp-action="沒有子項目">
                                <i class="mdi mdi-blur-linear"></i><span class="hide-menu">沒有子項目layout_說明版</span>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </aside>
        <!-- ============================================================== -->
        <!-- End Left Sidebar - style you can find in sidebar.scss  -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Page wrapper  這邊是頁面內容，實際上layout會刪除   未來在mvc 要放在各內頁-->


        <div class="page-wrapper">
            <!-- container-fluid-->
            <div class="container-fluid">

                @RenderBody()
                @* 這邊會連接到各自的內文，不要放東西 *@
            </div>
            @* <!-- End container-fluid  --> *@
            @* <!-- footer 這是頁腳 --> *@
            @* <!-- ============================================================== --> *@
            <footer class="footer text-center">
                All Rights Reserved by Matrix-admin. Designed and Developed by
                <a href="https://www.wrappixel.com">WrapPixel</a>.
            </footer>
            @* <!-- ============================================================== --> *@
            @* <!-- End footer --> *@
            @* <!-- ============================================================== --> *@
        </div>
        @* <!-- End Page wrapper  --> *@
    </div>
    <!-- All Jquery -->
    @* <!-- ============================================================== --> *@
    <script src="~/matrix-admin/assets/libs/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="~/matrix-admin/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/matrix-admin/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
    <script src="~/matrix-admin/assets/extra-libs/sparkline/sparkline.js"></script>
    <!--Wave Effects -->
    <script src="~/matrix-admin/dist/js/waves.js"></script>
    <!--Menu sidebar -->
    <script src="~/matrix-admin/dist/js/sidebarmenu.js"></script>
    <!--Custom JavaScript -->
    <script src="~/matrix-admin/dist/js/custom.min.js"></script>

    <!-- 廣告 後台管理不看廣告可刪除 -->
    <script src="~/js/LoadPlate.js"></script>
    <script>
        $(document).ready(function () {
            LoadPlateByNow();
        });
    </script>
    <!-- 廣告 後台管理不看廣告可刪除 -->

    <!-- 這邊在mvc 的layout 要用Render語法 -->
    @RenderSection("Scripts", required: false)
</body>

</html>