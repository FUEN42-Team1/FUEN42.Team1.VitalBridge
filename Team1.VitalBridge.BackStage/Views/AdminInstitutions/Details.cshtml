@using Team1.VitalBridge.BackStage.Models.ViewModels.Admin
@model AdminInstitutionDetailVM
@{
    ViewData["Title"] = "機構詳細資料";

    string status = (Model.Status ?? "Pending").Trim();
    string statusText = status switch { "Approved" => "核可", "Rejected" => "駁回", _ => "審核中" };
    string statusClass = status switch { "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-warning text-dark" };

    string physicalText = Model.IsPhysicalCheck ? "已完成" : "未完成";
    string physicalClass = Model.IsPhysicalCheck ? "bg-info" : "bg-secondary";

    string bannedText = Model.IsBanned ? "已停權" : "正常";
    string bannedClass = Model.IsBanned ? "bg-dark" : "bg-success";


    bool isPending = status == "Pending";
    bool hasRole = User.IsInRole("MainAdmin") || User.IsInRole("Admin");
    //bool hasRole = true;
    bool lockForm = Model.IsBanned || !isPending || !hasRole; // true => 鎖住表單
}

<div class="container-xxl py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-controller="AdminInstitutions">返回清單</a>
            <a class="btn btn-outline-primary btn-sm"
               asp-action="Edit"
               asp-controller="AdminInstitutions"
               asp-route-institutionCode="@Model.InstitutionCode">編輯</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- 左側：基本資料 / 文件預覽 -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="mb-0">基本資料</h5>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge @statusClass">@statusText</span>
                            <span class="badge @physicalClass">@physicalText</span>
                            <span class="badge @bannedClass">@bannedText</span>
                        </div>
                    </div>
                    <hr />

                    <div class="row gy-2">
                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">機構代碼</div>
                            <div class="flex-grow-1 text-monospace">@Model.InstitutionCode</div>
                        </div>
                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">機構名稱</div>
                            <div class="flex-grow-1">@Model.InstitutionName</div>
                        </div>
                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">Email</div>
                            <div class="flex-grow-1">@Model.InstitutionEmail</div>
                        </div>
                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">機構電話</div>
                            <div class="flex-grow-1">@Model.InstitutionPhone</div>
                        </div>
                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">負責人</div>
                            <div class="flex-grow-1">@Model.PrincipalName（@Model.PrincipalPhone）</div>
                        </div>

                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">地區</div>
                            <div class="flex-grow-1">@($"{Model.CityName ?? "-"} {(Model.TownshipName ?? "").Trim()}".Trim())</div>
                        </div>
                        <div class="col-12 d-flex">
                            <div class="field-label">地址</div>
                            <div class="flex-grow-1">@(!string.IsNullOrWhiteSpace(Model.Address) ? Model.Address : "-")</div>
                        </div>

                        <div class="col-12 col-md-6 d-flex">
                                <div class="field-label">現場查核</div>
                            <div class="flex-grow-1">
                                <span class="badge @physicalClass">@physicalText</span>
                                
                            </div>
                        </div>

                        <div class="col-12 col-md-6 d-flex">
                            <div class="field-label">機構狀態</div>
                            <div class="flex-grow-1"><span class="badge @bannedClass">@bannedText</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="mb-0">上傳文件</h5>
                        <span class="text-muted small">僅管理員可見</span>
                    </div>
                    <hr />

                    <div class="border rounded-3 p-3 h-100">
                        <div class="fw-semibold mb-2">設立許可證</div>
                        <div class="permit-preview mb-2">
                            @if (!string.IsNullOrWhiteSpace(Model.PermitImageUrl))
                            {
                                <img src="@Model.PermitImageUrl" alt="設立許可證預覽" class="img-fluid border rounded" />
                            }
                            else
                            {
                                <div class="text-muted">尚未上傳</div>
                            }
                        </div>

                        @if (Model.PermitUploadedAt.HasValue)
                        {
                            <div class="text-muted small">上傳於 @Model.PermitUploadedAt.Value.ToString("yyyy-MM-dd")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PermitImageUrl))
                        {
                            <a class="btn btn-sm btn-outline-primary mt-2"
                               href="@Model.PermitImageUrl" download>下載原檔</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側：審核面板 -->
        <div class="col-lg-4">
            <div class="card sticky-top">
                <div class="card-body">
                    <div class="mb-2">
                        <div class="text-muted small mb-1">當前狀態</div>
                        <div class="d-flex gap-2 flex-wrap" id="statusBadges">
                            <span class="badge @statusClass" id="badge-status">@statusText</span>
                            @* <span class="badge @physicalClass" id="badge-physical">@physicalText</span> *@
                            @* <span class="badge @bannedClass" id="badge-banned">@bannedText</span> *@
                        </div>
                    </div>

                    <form id="reviewForm" asp-action="Review" asp-controller="AdminInstitutions" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="InstitutionCode" value="@Model.InstitutionCode" />

                        <fieldset @(lockForm ? "disabled" : null)>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Decision" id="approve" value="Approved" checked>
                                <label class="form-check-label" for="approve">核可</label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="Decision" id="reject" value="Rejected">
                                <label class="form-check-label" for="reject">駁回</label>
                            </div>

                            <div id="rejectBlock" class="mb-3 d-none">
                                <label class="form-label">駁回原因（將寄給申請方）</label>
                                <textarea name="Reason" id="rejectReason" class="form-control" rows="3"
                                          placeholder="請輸入駁回說明…" maxlength="1000"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">送出審核結果</button>
                        </fieldset>
                    </form>

                    @if (lockForm)
                    {
                        <div class="text-muted small mt-2">
                            @(!isPending ? "此機構已完成審核，表單已鎖定。" : "你沒有審核權限，此表單為唯讀。")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            background: #ffffff;
            border: 1px solid #dee2e6;
        }

        .badge {
            font-weight: 600;
            letter-spacing: .02em;
        }

        .sticky-top {
            top: 1rem;
        }

        .field-label {
            width: 9rem;
            color: #6c757d;
        }

        .permit-preview img {
            max-width: 100%;
            border-radius: .25rem;
            border: 1px solid #dee2e6;
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('reviewForm');
            if (!form) return;

            // 若 fieldset 被鎖定（非 Pending 或無權限），不綁定任何互動
            const fieldset = form.querySelector('fieldset[disabled]');
            if (fieldset) return;

            const reject = document.getElementById('reject');
            const approve = document.getElementById('approve');
            const block = document.getElementById('rejectBlock');
            const reason = document.getElementById('rejectReason');

        function toggleRejectBlock() {
                const show = !!reject?.checked;
                if (block) block.classList.toggle('d-none', !show);
                if (reason) {
                    if (show) {
                        reason.setAttribute('required', 'required');
                    } else {
                        reason.removeAttribute('required');
                        reason.value = '';
                    }
                }
            }

            approve?.addEventListener('change', toggleRejectBlock);
            reject?.addEventListener('change', toggleRejectBlock);
            toggleRejectBlock(); // 初始化

            // 送出前再強制檢查一次（避免 UI 還沒來得及切換）
            form.addEventListener('submit', function (e) {
                toggleRejectBlock();
                if (reject?.checked && (!reason || !reason.value.trim())) {
                    e.preventDefault();
                    reason?.focus();
                }
            });
        })();


    </script>
}
