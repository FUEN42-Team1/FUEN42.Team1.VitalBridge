@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.NotifyViewModel>

@{
    ViewData["Title"] = "通知管理";
}
<h1 class="mb-4 text-primary fw-bold">通知管理</h1>

<p>
    <button type="button" class="btn btn-outline-primary rounded-pill px-4 mb-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#CreateNotify">
        ＋ 新增通知
    </button>
</p>
<!-- CreateModal -->
<div class="modal fade" id="CreateNotify" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateNotifyLabel">新增通知</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="CreateModalBodyContent">
                    <form id="CreateForm">
                        <div class="mb-3">
                            <label for="CreateTitle" class="form-label">標題</label>
                            <input type="text" class="form-control" id="CreateTitle"">
                        </div>
                        <div class="mb-3">
                            <label for="CreateTitle" class="form-label">說明文字</label>
                            <textarea class="form-control" id="CreateText" rows="4"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="CreateCategories" class="form-label">分類</label>
                            <select class="form-select" id="CreateCategories">
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="CreateSendDate" class="form-label">發送日期</label>
                            <input type="date" class="form-control" id="CreateSendDate">
                        </div>

                        <div class="mb-3">
                            <label for="CreateValidityDate" class="form-label">有效期限</label>
                            <input type="date" class="form-control" id="CreateValidityDate" ">
                        </div>

                        <div class="mb-3">
                            <label for="CreateNotifysUrl" class="form-label">通知網址</label>
                            <input type="url" class="form-control" id="CreateNotifysUrl">
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary btn-create">確定</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">編輯通知</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalBodyContent">載入中...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary btn-save">儲存</button>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive table-rounded shadow-sm w-100">
    <table id="notifysTable" class="table table-striped table-bordered table-hover align-middle bg-white w-100">
        <thead class="table-info text-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Categories)</th>
                <th>@Html.DisplayNameFor(model => model.SendDate)</th>
                <th>@Html.DisplayNameFor(model => model.ValidityDate)</th>
                <th>通知對象數量</th>
                <th class="text-center">操作</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables CSS & JS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>ㄈ
    <script>
        $(document).ready(function () {
            $.ajax({
                type: "GET",
                url: `/Api/Category/Enable`,
                success: function (data2) {
                        $('#CreateCategories').html(
                            data2.map(c =>
                            `<option value="${c.id}">${c.name}</option>`
                        ).join('')
                    );
                },
                error: function () {

                }
            });
          $('#notifysTable').DataTable({
              processing: true,
              language: {
                url: "https://cdn.datatables.net/plug-ins/1.11.3/i18n/zh_Hant.json"
              },
              serverSide: true,
              ajax: {
              url: '/api/notify/getByPage',
              type: 'POST',
              contentType: 'application/json',
              data: function (d) {
                return JSON.stringify(d);
              },
              error: function (xhr, status, error) {
                console.error("AJAX error:", status, error);
              }
            }
            ,
          columns: [
          { data: 'id' },
          { data: 'title',
            render: function (data, type, row) {
              if(row.notifysUrl!=null)
              {
                  return `<a href="${row.notifysUrl}">
                            ${data}
                          </a>`;
              }
              else
              {
                return data;
              }
            }
          },
          { data: 'categoriesName' },
          { data: 'sendDate' },
          { data: 'validityDate' },
          {
            data: 'userCount',
            render: function (data, type, row) {
              return `<a class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm btn-detail" data-id="${row.id}">
                        <i class="bi bi-people-fill" id="row-${row.id}" data-count="${data}">${data}</i>
                      </a>`;
            }
          },
          {
            data: 'id',
            render: function (data, type, row) {
              return `<div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-id =${data}>
                            編輯
                        </button>
                        <button type="button" class="btn btn-outline-danger rounded-pill btn-delete" data-id =${data}>
                            刪除
                        </button>
                      </div>`;
            },
            className: "text-center"
          }
        ]
            });


            $('#notifysTable').on('click', '.btn-detail', function () {
                const tr = $(this).closest('tr');
                const row = $('#notifysTable').DataTable().row(tr);

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                } else {
                    const id = $(this).data('id');
                    var content = $('#users-' + id).html();
                    if(!content)
                    {
                        var li = "";
                        $.ajax({
                          type: "GET",
                          url: `/Api/Notify/getUser/${id}`,
                          success: function (data) {
                            if(data.length==0)
                            {
                                li+=`<li class="list-group-item">
                                        <div>
                                            暫無通知對象
                                        </div>
                                     </li>`;
                            }
							for(var user of data)
                            {
                                var colorClass = user.isRead ? "text-success fw-bold" : "text-muted" ;
                                li+=`<li class="list-group-item ${colorClass}" id="${user.id}in${id}"">
                                        <div>
                                            ${user.name}
                                            ${user.email}
                                            <button class = "float-end btn btn-danger btn-deleteUser" data-id="${user.id}" data-nid="${id}">-</button>
                                        </div>
                                     </li>`;
                            }
                            var ul = `<ul class="list-group">
                                    ${li}
                                  </ul>`;
                            var div = `<div id="users-${id}" class="d-none">
                                            ${ul}
                                        </div>`;
                            $("#notifysTable").append(div);
                            content = ul;
                            row.child('<div class="p-3 bg-light">' + content + '</div>').show();
                            tr.addClass('shown');
                          },
                          error: function () {

                            }
                        });                    
                    }
                    else
                    {
                        row.child('<div class="p-3 bg-light">' + content + '</div>').show();
                        tr.addClass('shown');
                    }
                }
            });

            $('#staticBackdrop').on('show.bs.modal', function (event) {
              const button = $(event.relatedTarget);
              const id = button.data('id');

              $('#modalBodyContent').html(`正在載入 ID 為 <strong>${id}</strong> 的資料...`);

                $.ajax({
                    type: "GET",
                    url: `/Api/Notify/${id}`,
                            success: function (data) {
                              $('#modalBodyContent').html(`
                                <form id="editForm">
                                  <input type="hidden" id="editId" value="${data.id}">

                                  <div class="mb-3">
                                    <label for="editTitle" class="form-label">標題</label>
                                    <input type="text" class="form-control" id="editTitle" value="${data.title}">
                                  </div>
                                    <div class="mb-3">
                                      <label for="editTitle" class="form-label">說明文字</label>
                                      <textarea class="form-control" id="editText" rows="4">${data.text==null ? "" :data.text}</textarea>
                                    </div>
                                    <div class="mb-3">
                                      <label for="editCategories" class="form-label">分類</label>
                                      <select class="form-select" id="editCategories">
                                        
                                      </select>
                                    </div>
                                  <div class="mb-3">
                                    <label for="editSendDate" class="form-label">發送日期</label>
                                    <input type="date" class="form-control" id="editSendDate" value="${data.sendDate?.substring(0, 10)}">
                                  </div>

                                  <div class="mb-3">
                                    <label for="editValidityDate" class="form-label">有效期限</label>
                                    <input type="date" class="form-control" id="editValidityDate" value="${data.validityDate?.substring(0, 10)}">
                                  </div>

                                  <div class="mb-3">
                                    <label for="editNotifysUrl" class="form-label">通知網址</label>
                                    <input type="url" class="form-control" id="editNotifysUrl" value="${data.notifysUrl==null? "" : data.notifysUrl}">
                                  </div>
                                </form>
                              `);
                              $.ajax({
                                type: "GET",
                                url: `/Api/Category/Enable`,
                                    success: function (data2) {
                                      $('#editCategories').html(
                                        data2.map(c =>
                                          `<option value="${c.id}" ${c.id === data.categoriesId ? 'selected' : ''}>${c.name}</option>`
                                        ).join('')
                                      );
                                    },
                                    error: function () {

                                    }
                              });
                            },
                            error: function () {
                                $('#modalBodyContent').html(`<p class="text-danger">載入失敗，請稍後再試。</p>`);

                            }
              });
            });
        });
    </script>
    <script>
        $(document).ready(function(){
            //移除通知對象
            $(document).on('click','.btn-deleteUser',function(e){
                  Swal.fire({
                    title: "確定要刪除嗎?",
                    text: "即將移除通知對象",
                    icon: "warning",
                    showCancelButton: true,
                    cancelButtonText: "取消",
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "確定"
                }).then((result) => {
                    if (result.isConfirmed) {
                        var uid = $(this).data('id');
                        var nid = $(this).data('nid');
                        $.ajax({
                          url: `/api/NotifyUser/${nid}/${uid}`,
                          type: 'DELETE',
                          success: function () {
                            Swal.fire('刪除成功', '通知對象已移除', 'success');
                            $('#users-' + nid).find(`#${uid}in${nid}`).remove();
                            $(`#${uid}in${nid}`).remove();
                            var num = $(`#row-${nid}`).data('count')-1;
                            $(`#row-${nid}`).data('count',num);
                            $(`#row-${nid}`).text(num);
                          },
                          error: function (xhr) {
                          }
                        });
                    }
                });
            });

            //送出新增通知表單
            $(document).on('click','.btn-create',function(e){
                  const payload = {
                    text: $('#CreateText').val(),
                    title: $('#CreateTitle').val(),
                    categoriesId: $('#CreateCategories').val(),
                    sendDate: $('#CreateSendDate').val(),
                    validityDate: $('#CreateValidityDate').val() ? $('#CreateValidityDate').val() : null,
                    notifysUrl: $('#CreateNotifysUrl').val()
                  };

                  $.ajax({
                    url: `/api/notify`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (response) {
                      Swal.fire('新增成功', '資料已新增', 'success');
                      $("#CreateForm")[0].reset();
                      //關閉視窗
                      $("#CreateNotify").modal("hide");
                      //更新table
                      $('#notifysTable').DataTable().ajax.reload(null, false);
                    },
                    error: function (xhr) {
                      Swal.fire('❌ 錯誤', `新增失敗`, 'error');
                    }
                  });
            });

            //儲存通知變更
            $(document).on('click','.btn-save',function(e){
                const id = $('#editId').val(); // 取得 ID
                  const payload = {
                    text: $('#editText').val(),
                    title: $('#editTitle').val(),
                    categoriesId: $('#editCategories').val(),
                    sendDate: $('#editSendDate').val(),
                    validityDate: $('#editValidityDate').val() ? $('#editValidityDate').val() : null,
                    notifysUrl: $('#editNotifysUrl').val()
                  };

                  $.ajax({
                    url: `/api/notify/${id}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (response) {
                      $("#staticBackdrop").modal("hide");
                      Swal.fire('更新成功', '資料已儲存', 'success').then(()=>{
                          //更新table
                          $('#notifysTable').DataTable().ajax.reload(null, false);
                      });
                    },
                    error: function (xhr) {
                      Swal.fire('❌ 錯誤', `更新失敗`, 'error');
                    }
                  });
            });

            //刪除通知
            $(document).on('click', '.btn-delete', function (e) {
              e.preventDefault();

              const plateId = $(this).data('id');

              Swal.fire({
                title: "確定要刪除嗎?",
                text: "刪除後將無法復原!",
                icon: "warning",
                showCancelButton: true,
                cancelButtonText: "取消",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "確定"
              }).then((result) => {
                if (result.isConfirmed) {
                  $.ajax({
                    url: `/Api/Notify`,
                    type: 'DELETE',
                    data: { id: plateId },
                    success: function () {
                      Swal.fire({
                        title: "刪除!",
                        text: "刪除成功",
                        icon: "success"
                      }).then(() => {
                        //更新table
                        $('#notifysTable').DataTable().ajax.reload(null, false);
                      });
                    },
                    error: function () {
                      Swal.fire({
                        icon: "error",
                        title: "錯誤",
                        text: "刪除失敗",
                      });
                    }
                  });
                }
              });
            });
        });
    </script>
}