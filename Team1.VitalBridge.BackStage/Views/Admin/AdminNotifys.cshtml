@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.NotifyViewModel>

@{
    ViewData["Title"] = "通知管理";
}

<h1 class="mb-4 text-primary fw-bold">通知管理</h1>

<p>
    <a asp-action="Create" class="btn btn-outline-primary rounded-pill px-4 mb-3 shadow-sm">＋ 新增通知</a>
</p>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">編輯通知</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalBodyContent">載入中...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive table-rounded shadow-sm">
    <table id="notifysTable" class="table table-striped table-bordered table-hover align-middle bg-white">
        <thead class="table-info text-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Categories)</th>
                <th>@Html.DisplayNameFor(model => model.SendDate)</th>
                <th>@Html.DisplayNameFor(model => model.ValidityDate)</th>
                <th>通知對象數量</th>
                <th class="text-center">操作</th>
            </tr>
        </thead>
    </table>
    @foreach (var item in Model)
    {
        <div id="users-@item.Id" class="d-none">
            <ul class="list-group">
                @foreach (var user in item.NotifyUsers)
                {
                    <li class="list-group-item">
                         @user.User.Name
                    </li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables CSS & JS -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
          $('#notifysTable').DataTable({
              processing: true,
              serverSide: true,
              ajax: {
              url: '/api/notify/getByPage',
              type: 'POST',
              contentType: 'application/json',
              data: function (d) {
                return JSON.stringify(d);
              },
              error: function (xhr, status, error) {
                console.error("AJAX error:", status, error);
              }
            }
            ,
          columns: [
          { data: 'id' },
          { data: 'title' },
          { data: 'categoriesName' },
          { data: 'sendDate' },
          { data: 'validityDate' },
          {
            data: 'userCount',
            render: function (data, type, row) {
              return `<a class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm btn-detail" data-id="${row.id}">
                        <i class="bi bi-people-fill"></i> ${data}
                      </a>`;
            }
          },
          {
            data: 'id',
            render: function (data, type, row) {
              return `<div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-id =${data}>
                            編輯
                        </button>
                        <button type="button" class="btn btn-outline-danger rounded-pill btn-delete" data-id =${data}>
                            刪除
                        </button>
                      </div>`;
            },
            className: "text-center"
          }
        ]
            });


            $('#notifysTable').on('click', '.btn-detail', function () {
                const tr = $(this).closest('tr');
                const row = $('#notifysTable').DataTable().row(tr);

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                } else {
                    const id = $(this).data('id');
                    const content = $('#users-' + id).html();
                    row.child('<div class="p-3 bg-light">' + content + '</div>').show();
                    tr.addClass('shown');
                }
            });

            $('#staticBackdrop').on('show.bs.modal', function (event) {
              const button = $(event.relatedTarget);
              const id = button.data('id');

              $('#modalBodyContent').html(`正在載入 ID 為 <strong>${id}</strong> 的資料...`);

                $.ajax({
                    type: "GET",
                    url: `/Api/Notify/${id}`,
                            success: function (data) {
                              $('#modalBodyContent').html(`
                                <form id="editForm">
                                  <input type="hidden" id="editId" value="${data.id}">

                                  <div class="mb-3">
                                    <label for="editTitle" class="form-label">標題</label>
                                    <input type="text" class="form-control" id="editTitle" value="${data.title}">
                                  </div>
                                    <div class="mb-3">
                                      <label for="editCategories" class="form-label">分類</label>
                                      <select class="form-select" id="editCategories">
                                        
                                      </select>
                                    </div>
                                  <div class="mb-3">
                                    <label for="editSendDate" class="form-label">發送日期</label>
                                    <input type="date" class="form-control" id="editSendDate" value="${data.sendDate?.substring(0, 10)}">
                                  </div>

                                  <div class="mb-3">
                                    <label for="editValidityDate" class="form-label">有效期限</label>
                                    <input type="date" class="form-control" id="editValidityDate" value="${data.validityDate?.substring(0, 10)}">
                                  </div>

                                  <div class="mb-3">
                                    <label for="editNotifysUrl" class="form-label">通知網址</label>
                                    <input type="url" class="form-control" id="editNotifysUrl" value="${data.notifysUrl}">
                                  </div>
                                </form>
                              `);
                              $.ajax({
                                type: "GET",
                                url: `/Api/Category/Enable`,
                                    success: function (data2) {
                                      $('#editCategories').html(
                                        data2.map(c =>
                                          `<option value="${c.id}" ${c.id === data.categoriesId ? 'selected' : ''}>${c.name}</option>`
                                        ).join('')
                                      );
                                    },
                                    error: function () {

                                    }
                              });
                            },
                            error: function () {
                                $('#modalBodyContent').html(`<p class="text-danger">載入失敗，請稍後再試。</p>`);

                            }
              });
            });
        });
    </script>
    <script>
        $(document).ready(function(){
            $(document).on('click', '.btn-delete', function (e) {
              e.preventDefault();

              const plateId = $(this).data('id');

              Swal.fire({
                title: "確定要刪除嗎?",
                text: "刪除後將無法復原!",
                icon: "warning",
                showCancelButton: true,
                cancelButtonText: "取消",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "確定"
              }).then((result) => {
                if (result.isConfirmed) {
                  $.ajax({
                    url: `/Api/Notify`,
                    type: 'DELETE',
                    data: { id: plateId },
                    success: function () {
                      Swal.fire({
                        title: "刪除!",
                        text: "刪除成功",
                        icon: "success"
                      }).then(() => {
                        location.reload();
                      });
                    },
                    error: function () {
                      Swal.fire({
                        icon: "error",
                        title: "錯誤",
                        text: "刪除失敗",
                      });
                    }
                  });
                }
              });
            });
        });
    </script>
}