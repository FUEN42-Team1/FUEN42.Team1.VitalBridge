            //切換開關
            $(".toggle-enable").change(function () {
                var categoryId = $(this).data("id");
                var newEnable = $(this).is(":checked");

                $.ajax({
                    url: '/Api/Category/PutEnable',
                    type: 'PUT',
                    data: { id: categoryId, enable: newEnable },
                    success: function () {
                        console.log("更新成功");
                    },
                    error: function (ex) {
                        Swal.fire({
                            icon: "error",
                            title: "更新失敗",
                            text: ex.responseText
                        });
                    }
                });
            });


