@{
    ViewData["Title"] = "後台首頁";
}

<style>
    :root {
        --vb-primary: #3B82F6;
        --vb-line: #E9EEF7;
        --vb-soft: #F6F8FF;
    }

    .page-wrap {
        padding: 24px;
    }

    /* === 標題區 === */
    .hero-simple {
        margin-bottom: 24px;
        padding: 20px;
        background: linear-gradient(135deg,var(--vb-soft),#ffffff);
        border: 1px solid var(--vb-line);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .hero-left h1 {
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0;
    }

    .hero-left p {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: .95rem;
    }

    /* === 功能磁貼 === */
    .grid {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(4, 1fr); /* 桌機 4 欄 */
    }

    .tile {
        background: #fff;
        border: 1px solid var(--vb-line);
        border-radius: 14px;
        padding: 40px 20px;
        text-decoration: none;
        color: #111;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-height: 140px;
        transition: all .2s ease;
    }

        .tile:hover {
            transform: translateY(-4px);
            border-color: rgba(59,130,246,.4);
            box-shadow: 0 10px 24px rgba(0,0,0,.06);
            color: var(--vb-primary);
        }

        .tile i {
            font-size: 2rem;
            margin-bottom: 10px;
            color: var(--vb-primary);
            transition: color .2s ease;
        }

        .tile h3 {
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0;
            transition: color .2s ease;
        }

        .tile:hover i, .tile:hover h3 {
            color: var(--vb-primary);
        }

    /* 平板、手機自適應 */
    @@media (max-width:992px) {
        .grid

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }
    @@media (max-width:576px) {
        .grid

    {
        grid-template-columns: 1fr;
    }

    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<div class="page-wrap container-fluid px-2 px-md-3 px-lg-4">

    <!-- 簡潔標題區 -->
    <section class="hero-simple">
        <div class="hero-left">
            <h1>長照後台管理系統</h1>
            <p>快速進入各功能模組</p>
        </div>
    </section>

    <!-- 功能磁貼 -->
    <div class="grid">
        <a class="tile" asp-controller="AdminMember" asp-action="Index">
            <i class="bi bi-people"></i>
            <h3>會員管理</h3>
        </a>
        <a class="tile" asp-controller="ManagerOrganizations" asp-action="Index">
            <i class="bi bi-building"></i>
            <h3>機構管理</h3>
        </a>
        <a class="tile" asp-controller="Products" asp-action="Index">
            <i class="bi bi-bag"></i>
            <h3>線上購物</h3>
        </a>
        <a class="tile" asp-controller="Orders" asp-action="Index">
            <i class="bi bi-receipt"></i>
            <h3>訂單管理</h3>
        </a>
        <a class="tile" asp-controller="Admin" asp-action="AdminPlate">
            <i class="bi bi-badge-ad"></i>
            <h3>廣告管理</h3>
        </a>
        <a class="tile" asp-controller="Admin" asp-action="AdminNotifys">
            <i class="bi bi-bell"></i>
            <h3>通知管理</h3>
        </a>
        <a class="tile" asp-controller="ContentArticles" asp-action="Search">
            <i class="bi bi-journal-text"></i>
            <h3>專欄管理</h3>
        </a>
        <a class="tile" asp-controller="Roles" asp-action="Index">
            <i class="bi bi-shield-lock"></i>
            <h3>身分管理</h3>
        </a>
    </div>
</div>
