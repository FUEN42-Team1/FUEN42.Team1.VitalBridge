@model Team1.VitalBridge.BackStage.Models.EFModels.Plate
<link href="~/dist/css/lightbox.min.css" rel="stylesheet" />
<div class="editor-page">
    <!-- Modal -->
    <div class="modal fade" id="editPlateImageModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="editCategoryLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editPlateImageLabel">編輯廣告</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editPlateImageForm">
                        <input type="hidden" id="editId" />
                        <input type="hidden" id="editDisplayOrder" />
                        <div class="mb-3">
                            <label for="editIntroduct" class="form-label">介紹</label>
                            <input id="editIntroduct" class="form-control" placeholder="輸入介紹內容" />
                        </div>
                        <div class="mb-3">
                            <label for="editFileName" class="form-label">圖片名稱</label>
                            <input id="editFileName" class="form-control" readonly />
                        </div>
                        <div class="row">
                            <div class="mb-3">
                                <label for="editStartDate" class="form-label">開始時間</label>
                                <input id="editStartDate" class="form-control" type="date" />
                            </div>
                            <div class="mb-3">
                                <label for="editEndDate" class="form-label">結束時間</label>
                                <input id="editEndDate" class="form-control" type="date" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editClickUrl" class="form-label">點擊連結</label>
                            <input id="editClickUrl" class="form-control" />
                        </div>
                        <div class="input-group mb-3">
                            <input type="file" class="form-control" id="updateFileInput">
                            <button type="button" class="btn btn-outline-primary" id="editImage">上傳圖片</button>
                        </div>
                        <div id="updateResult"></div>
                        <div>
                            <img src="" alt="" id="updateShowImage" class="img-fluid rounded shadow-sm" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" id="savePlateImageBtn">儲存</button>
                </div>
            </div>
        </div>
    </div>
    <!-- 上方區塊 -->
    <div class="top-section row g-4 border-bottom pb-4">
        <div class="left-panel col-md-6">
            <div class="mb-3">
                <label class="form-label fw-bold">板塊名稱</label>
                <input type="text" asp-for="Name" class="form-control" id="Name"/>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">預設圖片說明文字</label>
                <textarea asp-for="DefaultImageIntroduct" class="form-control" rows="3" id="DefualImageIntroduct"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">預設圖片點擊連結</label>
                <input type="url" asp-for="DefaultImageClickUrl" class="form-control" id="DefualImageClickUrl" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">預設圖片檔名</label>
                <input asp-for="DefaultImageFile.FileName" class="form-control" id="DefualImageUrl" readonly />
            </div>
        </div>

        <div class="right-panel col-md-6 text-center">
            <div>
				<label class="form-label fw-bold mb-2">預設圖片</label>
                <img src="@Url.Action("GetFile", "UploadFile", new { fileName = Model.DefaultImageFile.FileName })" alt="Default" id="showimage" class="img-fluid rounded shadow-sm" />
            </div>
            <div class="input-group mb-3">
                <input type="file" class="form-control" id="fileInput">
                <button type="button" class="btn btn-outline-primary" id="upload">上傳圖片</button>
            </div>
            <div id="result"></div>

        </div>
    </div>

    <!-- 下方清單 -->
    <div class="image-list-section mt-4">
        <h3 class="fw-bold mb-4">廣告內容</h3>
        <div id="sortable-images" class="list-group">
            @foreach (var image in Model.PlateImages)
            {
                <div data-id="@image.Id" class="image-item list-group-item py-3 d-flex align-items-center">
                    <span class="drag-handle me-3" style="cursor: grab; font-size: 20px;">☰</span>
                    @* <a href="@image.ClickUrl" target="_blank" title="@image.Introduct"> *@
                    <a href="@Url.Action("GetFile", "UploadFile", new { fileName = image.ImageFile.FileName })" target="_blank" title="@image.Introduct" data-lightbox="image-@image.Id">
                        <img src="@Url.Action("GetFile", "UploadFile", new { fileName = image.ImageFile.FileName })"
                             alt="@image.Introduct"
                             class="img-thumbnail me-3 shadow-sm"
                             style="width: 100px; height: auto; border-radius: 4px;" />
                    </a>

                    <div class="flex-grow-1">
                        <div style="font-size: 1.1rem;">
                            <strong>廣告日期：</strong>
                            @image.StartDate.ToString("yyyy-MM-dd")~@image.EndDate.ToString("yyyy-MM-dd")
                        </div>
                    </div>

                    <div class="ms-auto btn-group btn-group-sm">
                        @* <a href="@Url.Action("EditPlateImage", new { id = image.Id })" class="btn btn-outline-warning">編輯</a> *@
                        <a href="#" class="btn btn-outline-warning btn-sm edit-btn" data-id="@image.Id">編輯</a>
                        <a href="#" class="btn btn-outline-danger delete-btn" data-id="@image.Id">刪除</a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="d-flex justify-content-between mt-3 gap-2">
        <div>
            <a href="@Url.Action("CreatePlateImage" ,new {Plateid = @Model.Id})" class="btn btn-outline-success btn-lg fw-bold">
                <i class="bi bi-plus-circle me-2"></i> 新增廣告
            </a>
        </div>
        <div>
            <button type="button" class="btn btn-danger" onclick="window.history.back()">取消</button>
            <button type="button" id="success" class="btn btn-success">儲存</button>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/dist/js/lightbox-plus-jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#sortable-images").sortable({
                handle: ".drag-handle",
                update: function (event, ui) {
                     const newOrder = $("#sortable-images .image-item").map(function () {
                        return $(this).data("id");
                    }).get();

                        $.ajax({
                        type: "PUT",
                        url: "/Api/AdvImage",
                        data: JSON.stringify(newOrder),
                        contentType: "application/json",
                        success: function () {
                            
                        },
                        error: function () {
                            
                        }
                    });


                }
            });
        });
    </script>
    <script src="~/js/UploadImage.js"></script>
    <script>
        $(document).ready(function () {
            var fileInput = $("#fileInput");
            var showImage = $("#showimage");
            var resultDiv = $("#result");
            var image = $("#DefualImageUrl");
            ready(fileInput,showImage);
            $("#upload").on('click',function(){
                uploadFile(fileInput,resultDiv,image,showImage);
            });

            var fileInput2 = $("#updateFileInput");
            var showImage2 = $("#updateShowImage");
            var resultDiv2 = $("#updateResult");
            var image2 = $("#editFileName");
            ready(fileInput2,showImage2);
            $("#editImage").on('click',function(){
                uploadFile(fileInput2,resultDiv2,image2,showImage2);
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
              $(".edit-btn").on("click", function () {
                const id = $(this).data("id");

                // 清空表單（避免殘留資料）
                $("#editPlateImageForm")[0].reset();
                $("#editFileName").val(""); // readonly 欄位不會被 reset 清空

                // AJAX 取得資料
                $.ajax({
                    url: `/api/AdvImage/${id}`, // 根據你的後端 API 調整路徑
                    method: "GET",
                    dataType: "json",
                    success: function (data) {
                        // 填入資料
                        $("#editId").val(data.id);
                        $("#editDisplayOrder").val(data.displayOrder);
                        $("#editIntroduct").val(data.introduct);
                        $("#editFileName").val(data.imageFile.fileName);
                        $("#editStartDate").val(data.startDate); // 格式需為 yyyy-mm-dd
                        $("#editEndDate").val(data.endDate); // 格式需為 yyyy-mm-dd
                        $("#editClickUrl").val(data.clickUrl);

                        // 顯示模態框
                        $("#editPlateImageModal").modal("show");
                    },
                    error: function () {
                        alert("載入資料失敗，請稍後再試");
                    }
                });
            });

            $("#savePlateImageBtn").click(function () {
                    const id = $("#editId").val();
                    const displayOrder = $("#editDisplayOrder").val();
                    const introduct = $("#editIntroduct").val();
                    const fileName = $("#editFileName").val();
                    const startDate = $("#editStartDate").val(); // 格式為 yyyy-mm-dd
                    const endDate = $("#editEndDate").val();     // 格式為 yyyy-mm-dd
                    const clickUrl = $("#editClickUrl").val();

                    const data = {
                        id: id,
                        displayOrder: displayOrder,
                        introduct: introduct,
                        ImageFileName: fileName,
                        startDate: startDate,
                        endDate: endDate,
                        clickUrl: clickUrl
                    };


                    $.ajax({
                        url: '/Api/AdvImage/update',
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function () {
                            Swal.fire({
                                icon: "success",
                                title: "更新成功",
                                showConfirmButton: false,
                                timer: 1500
                            }).then(() => {
                                $("#editCategoryModal").modal("hide");
                                location.reload();
                            });
                        },
                        error: function () {
                            Swal.fire({
                                icon: "error",
                                title: "更新失敗",
                                text: "請稍後再試"
                            });
                        }
                    });
                });

            $('.delete-btn').click(function (e) {
                e.preventDefault();
                Swal.fire({
                  title: "確定要刪除嗎?",
                  text: "刪除後將無法復原!",
                  icon: "warning",
                  showCancelButton: true,
                  cancelButtonText: "取消",
                  confirmButtonColor: "#3085d6",
                  cancelButtonColor: "#d33",
                  confirmButtonText: "確定"
                }).then((result) => {
                  if (result.isConfirmed) {
                      const plateId = $(this).data('id');
                      $.ajax({
                      url: '/Api/AdvImage',
                      type: 'DELETE',
                      data: { id: plateId },
                      success: function (response) {
                        Swal.fire({
                          title: "刪除!",
                          text: "刪除成功",
                          icon: "success"
                        }).then(() => {
                          location.reload();
                        });

                      },
                      error: function (xhr) {
                          Swal.fire({
                          icon: "error",
                          title: "錯誤",
                          text: "刪除失敗",
                        });
                      }
                    });
                  }
                });
          });

        $('#success').click(function (e) {
                $.ajax({
                      url: '/Api/Adv',
                      type: 'POST',
                        data: {
                            id: '@Model.Id',
                            name: $("#Name").val(),
                            defualImageIntroduct: $("#DefualImageIntroduct").val(),
                            defualImageClickUrl: $("#DefualImageClickUrl").val(),
                            defualImageUrl: $("#DefualImageUrl").val()
                        },
                      success: function (response) {
                        Swal.fire({
                            position: "top",
                            icon: "success",
                            title: "儲存成功!",
                            showConfirmButton: false,
                            timer: 1500

                        }).then(() => {
                          location.reload();
                        });

                      },
                      error: function (xhr) {
                          Swal.fire({
                          icon: "error",
                          title: "錯誤",
                          text: "儲存失敗",
                        });
                      }
                    });
          });
        });
    </script>
}