@model Team1.VitalBridge.BackStage.Models.ViewModels.ContentArticleCreateViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Create Article";
    <link rel="stylesheet" href="~/ckeditor5/css/style.css">
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/46.0.0/ckeditor5.css" crossorigin>

}

<h2>Create New Article</h2>
<hr />

<form id="createArticleForm" method="post" enctype="multipart/form-data" asp-controller="ContentArticles" asp-action="Create">
    <div class="form-group row">
        <label for="Title" class="col-sm-2 col-form-label">Title</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="Title" name="Title" required>
        </div>
    </div>

    <div class="form-group row">
        <label for="ContentCategoryId" class="col-sm-2 col-form-label">Category</label>
        <div class="col-sm-10">
            <select id="ContentCategoryId" name="ContentCategoryId" class="form-control" required>
                <option value="">-- Select a Category --</option>
            </select>
        </div>
    </div>

    @* <div class="form-group row">
        <label for="CoverPic" class="col-sm-2 col-form-label">Cover Picture</label>
        <div class="col-sm-10">
            <input type="file" id="CoverPic" name="CoverPic" class="form-control-file">
        </div>
    </div> *@

    <div class="form-group row">
        <label for="Status" class="col-sm-2 col-form-label">Status</label>
        <div class="col-sm-10">
            <select id="Status" name="Status" class="form-control" required>
                <option value="Drafted">Drafted</option>
                <option value="Published">Published</option>
                <option value="Archived">Archived</option>
            </select>
        </div>
    </div>

    <div class="form-group row">
        <label for="Content" class="col-sm-2 col-form-label">Content</label>
        <div class="col-sm-10">
            <textarea id="ContentEditor" name="Content" class="form-control" rows="10"></textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </div>
</form>

@section Scripts {
    @* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/46.0.0/ckeditor5.umd.js" crossorigin></script>
    <script src="~/ckeditor5/js/main.js"></script>
    <script>
        $(document).ready(function () {
            // Function to load categories via AJAX
            function loadCategories() {
                $.ajax({
                    url: '/api/ContentCategoriesAPI', // Finished Replacing with actual API endpoint
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        var select = $('#ContentCategoryId');
                        select.empty();
                        select.append('<option value="">-- Select a Category --</option>');
                        $.each(data, function (index, category) {
                            select.append('<option value="' + category.id + '">' + category.name + '</option>');
                        });
                    },
                    error: function (error) {
                        console.log("Error loading categories:", error);
                        // Optional: Add a user-friendly error message
                        alert("Failed to load categories. Please try again.");
                    }
                });
            }

            // Load categories when the page loads
            loadCategories();

            // Optional: You could also add a button to reload categories
            // $('#reloadCategoriesBtn').on('click', function() {
            //     loadCategories();
            // });
        });
    </script>
}
