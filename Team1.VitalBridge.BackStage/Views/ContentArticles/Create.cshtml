@model Team1.VitalBridge.BackStage.Models.ViewModels.ContentArticleCreateViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Create Article";
}

<h2>新增文章</h2> 
<hr />

<form id="createArticleForm" method="post" enctype="multipart/form-data" asp-controller="ContentArticles" asp-action="Create">
    <div class="form-group row">
        <label for="Title" class="col-sm-2 col-form-label">標題</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="Title" name="Title" required>
        </div>
    </div>

    <div class="form-group row">
        <label for="ContentCategoryId" class="col-sm-2 col-form-label">類別</label>
        <div class="col-sm-10">
            <select id="ContentCategoryId" name="ContentCategoryId" class="form-control" required>
                <option value="">-- Select a Category --</option>
            </select>
        </div>
    </div>
    @* <div class="form-group row">
        <label for="MemberId" class="col-sm-2 col-form-label">會員</label>
        <div class="col-sm-10">
            <select id="MemberId" name="MemberId" class="form-control" required>
                <option value="">-- Select a Member --</option>
            </select>
        </div>
    </div> *@
    <div class="form-group row">
        <label for="" class="col-sm-2 col-form-label">封面圖</label>
        <div class="col-sm-10">
            <div class="input-group mb-3">
                <input type="file" class="form-control" id="fileInput">
                <button id="upload" type="button" class="btn btn-outline-primary">上傳圖片</button>
            </div>
            <div>
                <img src="" alt="" id="showimage" class="img-fluid rounded shadow-sm" />
            </div>
            <div id="result"></div>
            <div class="form-group mb-3">
                <input type="text" class="form-control" id="CoverPicFileName" name="CoverPicFileName" readonly hidden>
            </div>
        </div>
    </div>

    


    <div class="form-group row">
        <label for="Status" class="col-sm-2 col-form-label">狀態</label>
        <div class="col-sm-10">
            <select id="Status" name="Status" class="form-control" required>
                <option value="Drafted">草稿</option>
                <option value="Published">已發表</option>
                <option value="Archived">已歸檔</option>
            </select>
        </div>
    </div>

    <div class="form-group row">
        <label for="Content" class="col-sm-2 col-form-label">內容</label>
        <div class="col-sm-10">
            <textarea id="ContentEditor" name="Content" class="form-control" rows="10"></textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary" id="upload">新增</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/UploadImage.js"></script>
    <script>
        $(document).ready(function () {
            var fileInput = $("#fileInput");
            var showImage = $("#showimage");
            var resultDiv = $("#result");
            var image = $("#CoverPicFileName");
            ready(fileInput,showImage);
            $("#upload").on('click',function(){
                uploadFile(fileInput,resultDiv,image,showimage);
            });
        });
    </script>
    <script src="~/ckeditor5/js/main.js"></script>

    <script>
        $(document).ready(function () {
            // Function to load categories via AJAX
            function loadCategories() {
                $.ajax({
                    url: '/api/ContentCategoriesAPI', // Finished Replacing with actual API endpoint
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        var select = $('#ContentCategoryId');
                        select.empty();
                        select.append('<option value="">-- 選擇類別 --</option>');
                        $.each(data, function (index, category) {
                            select.append('<option value="' + category.id + '">' + category.name + '</option>');
                        });
                    },
                    error: function (error) {
                        console.log("Error loading categories:", error);
                        // Optional: Add a user-friendly error message
                        alert("Failed to load categories. Please try again.");
                    }
                });
            }

            // Load categories when the page loads
            loadCategories();

            
        });
    </script>
}
