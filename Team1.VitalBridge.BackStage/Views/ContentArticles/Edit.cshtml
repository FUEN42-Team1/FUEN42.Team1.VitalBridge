@model Team1.VitalBridge.BackStage.Models.ViewModels.ContentArticleEditViewModel
@{
    ViewData["Title"] = "Edit Article";
}

<h2>編輯文章</h2>
<hr />

<form id="editArticleForm" method="post" enctype="multipart/form-data" asp-controller="ContentArticles" asp-action="Edit">
    <!-- Hidden field to pass the ArticleId for editing -->
    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label for="Title" class="col-sm-2 col-form-label">標題</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="Title" name="Title" value="@Model.Title" required>
        </div>
    </div>

    <div class="form-group row">
        <label for="ContentCategoryId" class="col-sm-2 col-form-label">類別</label>
        <div class="col-sm-10">
            <select id="ContentCategoryId" name="ContentCategoryId" class="form-control" required>
                <option value="">-- Select a Category --</option>
                <!-- Options will be loaded via AJAX and then selected -->
            </select>
        </div>
    </div>
    @* <div class="form-group row">
        <label for="MemberId" class="col-sm-2 col-form-label">會員</label>
        <div class="col-sm-10">
            <select id="MemberId" name="MemberId" class="form-control" required>
                <option value="">-- Select a Member --</option>
            </select>
        </div>
    </div> *@

    <!-- Cover Picture -->
    <div class="form-group row">
        <label for="" class="col-sm-2 col-form-label">封面圖</label>
        <div class="col-sm-10">
            <div class="input-group mb-3">
                <input type="file" class="form-control" id="fileInput">
                <button id="upload" type="button" class="btn btn-outline-primary">上傳圖片</button>
            </div>
            <div>
                <img src="@Url.Action("GetFile", "UploadFile", new { fileName = Model.CoverPicFileName })" alt="" id="showimage" class="img-fluid rounded shadow-sm" />
            </div>
            <div id="result"></div>
            <div class="form-group mb-3">
                <input type="text" class="form-control" id="CoverPicFileName" name="CoverPicFileName" value="@Model.CoverPicFileName" readonly hidden>
            </div>
        </div>

    </div>

    

    <div class="form-group row">
        <label for="Status" class="col-sm-2 col-form-label">狀態</label>
        <div class="col-sm-10">
            <select id="Status" name="Status" class="form-control" required>
                <option value="Drafted">草稿</option>
                <option value="Published">已發表</option>
                <option value="Archived">已歸檔</option>
            </select>
        </div>
    </div>

    <div class="form-group row mb-2">
        <label for="Content" class="col-sm-2 col-form-label">內容</label>
        <div class="col-sm-10">
            <textarea id="ContentEditor" name="Content" class="form-control" rows="10">@Html.Raw(Model.Content)</textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">儲存編輯</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/UploadImage.js"></script>
    <script>
        $(document).ready(function () {
            var fileInput = $("#fileInput");
            var showImage = $("#showimage");
            var resultDiv = $("#result");
            var image = $("#CoverPicFileName");
            ready(fileInput,showImage);
            $("#upload").on('click',function(){
                uploadFile(fileInput,resultDiv,image,showimage);
            });
        });
    </script>
    <script src="~/ckeditor5/js/main.js"></script>
    <script>
        $(document).ready(function () {
            var selectedCategoryId = '@Model.ContentCategoryId'; // Get the pre-selected category ID from the model
            var selectedStatus = '@Model.Status';
            var statusSelect = document.getElementById('Status');
            if (statusSelect && selectedStatus) {
                statusSelect.value = selectedStatus;
            }
            // Function to load categories via AJAX
            function loadCategories() {
                $.ajax({
                    url: '/api/ContentCategoriesAPI', // Actual API endpoint
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        var select = $('#ContentCategoryId');
                        select.empty();
                        select.append('<option value="">-- 選擇類別 --</option>');
                        $.each(data, function (index, category) {
                            // Pre-select the category if it matches the model's category ID
                            var selected = (category.id == selectedCategoryId) ? 'selected' : '';
                            select.append('<option value="' + category.id + '" ' + selected + '>' + category.name + '</option>');
                        });
                    },
                    error: function (error) {
                        console.log("Error loading categories:", error);
                        // Optional: Add a user-friendly error message
                        // alert("Failed to load categories. Please try again.");
                    }
                });
            }

            // Load categories when the page loads
            loadCategories();
        });
    </script>
}
