@model Team1.VitalBridge.BackStage.Models.ViewModels.ContentArticleEditViewModel
@{
    ViewData["Title"] = "Edit Article";
}

<h2>Edit Article</h2>
<hr />

<form id="editArticleForm" method="post" enctype="multipart/form-data" asp-controller="ContentArticles" asp-action="Edit">
    <!-- Hidden field to pass the ArticleId for editing -->
    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label for="Title" class="col-sm-2 col-form-label">Title</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="Title" name="Title" value="@Model.Title" required>
        </div>
    </div>

    <div class="form-group row">
        <label for="ContentCategoryId" class="col-sm-2 col-form-label">Category</label>
        <div class="col-sm-10">
            <select id="ContentCategoryId" name="ContentCategoryId" class="form-control" required>
                <option value="">-- Select a Category --</option>
                <!-- Options will be loaded via AJAX and then selected -->
            </select>
        </div>
    </div>

    @* Uncomment if you want to display or allow changing the cover picture in edit view
    <div class="form-group row">
        <label for="CoverPic" class="col-sm-2 col-form-label">Cover Picture</label>
        <div class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.CoverPicUrl))
            {
                <img src="@Model.CoverPicUrl" alt="Current Cover Picture" class="img-thumbnail mb-2" style="max-width: 200px;" />
            }
            <input type="file" id="CoverPic" name="CoverPic" class="form-control-file">
            <small class="form-text text-muted">Leave empty to keep current picture.</small>
        </div>
    </div>
    *@

    <div class="form-group row">
        <label for="Status" class="col-sm-2 col-form-label">Status</label>
        <div class="col-sm-10">
            <select id="Status" name="Status" class="form-control" required>
                <option value="Drafted">Drafted</option>
                <option value="Published">Published</option>
                <option value="Archived">Archived</option>
            </select>
        </div>
    </div>

    <div class="form-group row mb-2">
        <label for="Content" class="col-sm-2 col-form-label">Content</label>
        <div class="col-sm-10">
            <textarea id="ContentEditor" name="Content" class="form-control" rows="10">@Html.Raw(Model.Content)</textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/ckeditor5/js/main.js"></script>
    <script>
        $(document).ready(function () {
            var selectedCategoryId = '@Model.ContentCategoryId'; // Get the pre-selected category ID from the model
            var selectedStatus = '@Model.Status';
            var statusSelect = document.getElementById('Status');
            if (statusSelect && selectedStatus) {
                statusSelect.value = selectedStatus;
            }
            // Function to load categories via AJAX
            function loadCategories() {
                $.ajax({
                    url: '/api/ContentCategoriesAPI', // Actual API endpoint
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        var select = $('#ContentCategoryId');
                        select.empty();
                        select.append('<option value="">-- Select a Category --</option>');
                        $.each(data, function (index, category) {
                            // Pre-select the category if it matches the model's category ID
                            var selected = (category.id == selectedCategoryId) ? 'selected' : '';
                            select.append('<option value="' + category.id + '" ' + selected + '>' + category.name + '</option>');
                        });
                    },
                    error: function (error) {
                        console.log("Error loading categories:", error);
                        // Optional: Add a user-friendly error message
                        // alert("Failed to load categories. Please try again.");
                    }
                });
            }

            // Load categories when the page loads
            loadCategories();
        });
    </script>
}
