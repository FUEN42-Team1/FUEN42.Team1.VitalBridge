@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.ContentArticleListViewModel>
@{
    ViewData["Title"] = "Search Articles";
}
@section Styles {
    <link rel="stylesheet" href="~/css/AdminArticle.css" />
}

@{
    // Check if TempData contains a success message
    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    // Check if TempData contains an error message (optional, but good practice)
    if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}



<div class="pageBody">
    <div class="container">
        

        <!-- Search and Filter Area -->
        <div class="search-filter-area">
            <h2>管理文章</h2>
            <form action="#" method="get">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="Keyword">搜尋</label>
                        <input type="text" id="Keyword" name="Keyword" placeholder="搜尋標題、會員、類別">
                    </div>

                    <div class="form-group">
                        <label for="Status">狀態</label>
                        <select id="Status" name="Status">
                            <option value="">-- All --</option>
                            <option value="0">草稿</option>
                            <option value="1">已發表</option>
                            <option value="2">已歸檔</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>觀看次數段落</label>
                        <div class="date-inputs">
                            <input type="number" id="MinViewCount" name="MinViewCount" placeholder="Min">
                            <input type="number" id="MaxViewCount" name="MaxViewCount" placeholder="Max">
                        </div>
                    </div>

                    <div class="form-group date-range">
                        <label>新增時段</label>
                        <div class="date-inputs">
                            <input type="date" id="CreatedAtStart" name="CreatedAtStart">
                            <input type="date" id="CreatedAtEnd" name="CreatedAtEnd">
                        </div>
                    </div>

                    <div class="form-group date-range">
                        <label>更新時段</label>
                        <div class="date-inputs">
                            <input type="date" id="UpdatedAtStart" name="UpdatedAtStart">
                            <input type="date" id="UpdatedAtEnd" name="UpdatedAtEnd">
                        </div>
                    </div>
                </div>
                <button class="action-button">篩選</button>
            </form>
        </div>

        <!-- Create New Article Button -->
        <a class="btn btn-primary" asp-action="Create">新增文章</a>

        <!-- Rows Per Page Selector -->
        <div class="rows-per-page-area">
            <label for="rowsPerPage">每頁幾筆資料:</label>
            <select id="rowsPerPage">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="25">25</option>
                <option value="100">100</option>
            </select>
        </div>

        <!-- Articles Table Display -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>標題</th>
                        <th>封面</th>
                        <th>類別</th>
                        <th>成員</th>
                        <th>狀態</th>
                        <th>觀看次數</th>
                        <th>創作時間</th>
                        <th>更新時間</th>
                        <th>行動</th>
                    </tr>
                </thead>
                <tbody id="articlesTableBody">
                    <!-- Data will be populated here by JavaScript, right now it is just samples -->
                    <!-- Sample Data Rows -->
                    <tr>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>
                            Loading...
                        </td>
                    </tr>
                    <!-- More sample data can be added here -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-controls">
            <div class="pagination-info">No data (Static)</div>
            <div class="pagination-buttons">
                <button id="firstPageBtn">第一頁</button>
                <button id="prevPageBtn">上頁</button>
                <button id="nextPageBtn">下頁</button>
                <button id="lastPageBtn">最後一頁</button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Global variables for article management
        // API data 
        const allArticles = [];
        let currentPage = 1;
        // Assuming you have an input with id 'articleRowsPerPage' for articles
        let rowsPerPage = parseInt($('#rowsPerPage').val());
        let filteredArticles = []; // Stores articles after applying search filters
        let currentArticleFilters = {
            Keyword: '', // Searches title, member, category
            Status: '',  // 0: Draft, 1: Published, 2: Archived, "": All
            MinViewCount: '',
            MaxViewCount: '',
            CreatedAtStart: '',
            CreatedAtEnd: '',
            UpdatedAtStart: '',
            UpdatedAtEnd: ''
        };

        /**
         * API call to fetch and filter article data.
         * Filters the `allArticles` array based on `currentArticleFilters`.
         * returns {Promise<Array<object>>} A promise that resolves with the filtered articles.
         */
        function fetchAndFilterArticles() {
            return new Promise(function(resolve, reject){
                $.ajax({
                    url: '/api/ContentArticleContentAPI',
                    type: 'GET',
                    data: {
                        Keyword: currentArticleFilters.Keyword,
                        Status: currentArticleFilters.Status,
                        MinViewCount: currentArticleFilters.MinViewCount,
                        MaxViewCount: currentArticleFilters.MaxViewCount,
                        CreatedAtStart: currentArticleFilters.CreatedAtStart,
                        CreatedAtEnd: currentArticleFilters.CreatedAtEnd,
                        UpdatedAtStart: currentArticleFilters.UpdatedAtStart,
                        UpdatedAtEnd: currentArticleFilters.UpdatedAtEnd
                    },
                    success: resolve,
                    error: reject
                });
            });
        }

        /**
         * Renders the articles into the table body.
         * param {Array<object>} articles - An array of article objects to display.
         */
        function renderArticlesTable(articles) {
            const $tbody = $('#articlesTableBody'); // Make sure this ID matches your table's tbody
            $tbody.empty(); // Clear existing rows

            if (articles.length === 0) {
                $tbody.append(`<tr><td colspan="9" class="text-center py-4 text-gray-500">No articles found matching your criteria.</td></tr>`);
                return;
            }

                       // cover image dead

            articles.forEach(article => {
                const row = `
                    <tr>
                        <td>${article.title}</td>
                        <td><img src="/api/UploadFile/GetFile?fileName=${article.coverPicFileName}" width="100px" /></td>
                        <td>${article.category}</td>
                        <td>${article.memberName}</td>
                        <td>${article.status == 0 ? "草稿" : article.status == 1 ? "已發表" : "已歸檔"}</td>
                        <td>${article.views}</td>
                        <td>${article.createdAt}</td>
                        <td>${article.updatedAt}</td>
                        <td>
                            <a class="edit-button" href="/ContentArticles/Edit/${article.id}">編輯</a>
                        </td>
                    </tr>
                `;
                $tbody.append(row);
            });
        }

        /**
         * Updates the pagination info and button states.
         * param {number} totalCount - The total number of filtered comments.
         */
        function updatePaginationInfo(totalCount) {
            const totalPages = Math.ceil(totalCount / rowsPerPage);
            $('.pagination-info').text(`Page ${currentPage} of ${totalPages}`);

            $('#firstPageBtn').prop('disabled', currentPage === 1); // disable if on first page
            $('#prevPageBtn').prop('disabled', currentPage === 1); // disable if on first page
            $('#nextPageBtn').prop('disabled', currentPage === totalPages || totalPages === 0); // disable if on last page or no pages
            $('#lastPageBtn').prop('disabled', currentPage === totalPages || totalPages === 0); // disable if on last page or no pages
        }

        /**
         * Orchestrates the fetching, rendering, and pagination updates for articles.
         * This function is called when the page loads or when filters are applied.
         */
        async function loadArticles() {
            filteredArticles = await fetchAndFilterArticles();
            const totalArticles = filteredArticles.length;
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const paginatedArticles = filteredArticles.slice(startIndex, endIndex);
            renderArticlesTable(paginatedArticles);
            updatePaginationInfo(totalArticles);
        }

        // Event listeners (example, you'd integrate these with your actual HTML)
        $(document).ready(function() {
            // Set initial rows per page
            rowsPerPage = parseInt($('#rowsPerPage').val());

            // Initial load of articles
            loadArticles();

            // Event listener for the filter button (assuming you have one with class 'action-button')
            $('.action-button').on('click', async function(e) {
                e.preventDefault(); // Prevents the form from submitting and refreshing the page
                currentArticleFilters.Keyword = $('#Keyword').val();
                currentArticleFilters.Status = $('#Status').val();
                currentArticleFilters.MinViewCount = $('#MinViewCount').val();
                currentArticleFilters.MaxViewCount = $('#MaxViewCount').val();
                currentArticleFilters.CreatedAtStart = $('#CreatedAtStart').val();
                currentArticleFilters.CreatedAtEnd = $('#CreatedAtEnd').val();
                currentArticleFilters.UpdatedAtStart = $('#UpdatedAtStart').val();
                currentArticleFilters.UpdatedAtEnd = $('#UpdatedAtEnd').val();

                currentPage = 1; // Reset to first page on filter change
                await loadArticles();
            });

            // Event listener for Rows Per Page select
            $('#rowsPerPage').on('change', function() {
                rowsPerPage = parseInt($(this).val());
                currentPage = 1; // Reset to first page when rows per page changes
               loadArticles();
            });

            // Event listeners for pagination buttons
            $('#firstPageBtn').on('click', function() {
                currentPage = 1;
                loadArticles();
            });

            $('#prevPageBtn').on('click', function() {
                if (currentPage > 1) {
                    currentPage--;
                    loadArticles();
                }
            });

            $('#nextPageBtn').on('click', function() {
                const totalPages = Math.ceil(filteredArticles.length / rowsPerPage);
                if (currentPage < totalPages) {
                    currentPage++;
                    loadArticles();
                }
            });

            $('#lastPageBtn').on('click', function() {
                const totalPages = Math.ceil(filteredArticles.length / rowsPerPage);
                currentPage = totalPages;
                loadArticles();
            });
        });

        
    </script>

}