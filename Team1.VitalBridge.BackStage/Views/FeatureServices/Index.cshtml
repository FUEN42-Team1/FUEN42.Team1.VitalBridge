@model Team1.VitalBridge.BackStage.Models.ViewModels.PaginatedResult<Team1.VitalBridge.BackStage.Models.ViewModels.FeatureServiceViewModel>

@{
    ViewData["Title"] = "特色服務管理";
}

@section Styles {
    <style>
        /* 新增/編輯/啟用/停用按鈕配色 */
        .btn-add {
            background-color: #28a745; /* 綠色 */
            color: white;
            border-color: #28a745;
        }

            .btn-add:hover {
                background-color: #218838;
                border-color: #1e7e34;
                color: white;
            }

        .btn-edit {
            background-color: #ffc107; /* 橘黃色 */
            color: white;
            border-color: #ffc107;
        }

            .btn-edit:hover {
                background-color: #e0a800;
                border-color: #d39e00;
                color: white;
            }

        /* 啟用/停用按鈕的樣式 */
        .btn-deactivate {
            background-color: #e74a3b; /* 紅色 */
            color: white;
            border-color: #e74a3b;
        }

            .btn-deactivate:hover {
                background-color: #c82333;
                border-color: #bd2130;
                color: white;
            }

        .btn-activate {
            background-color: #36b9cc; /* 藍色 */
            color: white;
            border-color: #36b9cc;
        }

            .btn-activate:hover {
                background-color: #2c9faf;
                border-color: #2a96a9;
                color: white;
            }

        /* 表格標頭配色 */
        .table thead th {
            background-color: #e2f3f5; /* 淺藍綠色 */
            color: #000;
            border-bottom: 2px solid #d1d3e2;
            white-space: nowrap; /* 防止標題文字換行 */
        }

        /* Modal 標頭與頁尾配色 */
        .modal-header, .modal-footer {
            background-color: #f8f9fa; /* 淺灰色背景 */
        }

        /* 確保表格在任何大小下都有一致的欄位寬度 */
        #featureServiceTable {
            table-layout: fixed;
            width: 100%;
        }

            #featureServiceTable th:nth-child(1),
            #featureServiceTable td:nth-child(1) {
                width: 30%; /* 名稱 */
            }

            #featureServiceTable th:nth-child(2),
            #featureServiceTable td:nth-child(2) {
                width: 25%; /* 圖片 */
            }

            #featureServiceTable th:nth-child(3),
            #featureServiceTable td:nth-child(3) {
                width: 15%; /* 狀態 */
            }

            #featureServiceTable th:nth-child(4),
            #featureServiceTable td:nth-child(4) {
                width: 30%; /* 操作 */
            }

            /* 讓表格內容在空間不足時自動換行 */
            #featureServiceTable td {
                word-break: break-word;
                overflow-wrap: break-word;
            }

        /* 響應式分頁導覽列 */
        .pagination-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .pagination-container {
                flex-direction: row;
                justify-content: space-between;
            }
        }

        /* 響應式操作按鈕：讓按鈕在小螢幕時垂直排列 */
        @@media (max-width: 576px) {
            #featureServiceTable td:last-child {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 5px; /* 按鈕間的間距 */
            }

                #featureServiceTable td:last-child .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h6 class="m-0 font-weight-bold text-primary">特色服務清單</h6>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" class="btn btn-add" data-toggle="modal" data-target="#featureServiceModal" id="createBtn">
                    <i class="fas fa-plus"></i> 新增特色服務
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 d-flex align-items-center">
                <label for="pageSize" class="mr-2">顯示</label>
                <select id="pageSize" class="form-control" style="width: auto;">
                    @{
                        var pageSizes = new[] { 5, 10, 20, 50 };
                        foreach (var size in pageSizes)
                        {
                            if (size == Model.PageSize)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    }
                </select>
                <span class="ml-2">筆結果</span>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0">
                <label for="searchQuery" class="mr-2">搜尋:</label>
                <input type="search" id="searchQuery" class="form-control" placeholder="請輸入關鍵字" style="width: auto;" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered" id="featureServiceTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Items.First().Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Items.First().ImageUrl)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Items.First().IsActive)
                        </th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @{
                                    var imageUrl = !string.IsNullOrEmpty(item.ImageUrl) ? $"/api/UploadFile/GetFile?fileName={item.ImageUrl}" : "";
                                }
                                <img src="@imageUrl" alt="@item.Name" class="img-thumbnail" style="max-height: 100px;" />
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                    @(item.IsActive ? "啟用中" : "已停用")
                                </span>
                            </td>
                            <td>
                                <a href="#" class="btn btn-edit btn-sm edit-btn"
                                   data-id="@item.Id"
                                   data-name="@item.Name"
                                   data-imageurl="@item.ImageUrl"
                                   data-toggle="modal" data-target="#featureServiceModal">
                                    <i class="fas fa-edit"></i> 編輯
                                </a>
                                <a href="#" class="btn btn-sm @(item.IsActive ? "btn-deactivate deactivate-btn" : "btn-activate activate-btn")" data-id="@item.Id" data-is-active="@item.IsActive">
                                    <i class="fas @(item.IsActive ? "fa-power-off" : "fa-check")"></i> @(item.IsActive ? "停用" : "啟用")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <div class="text-nowrap mb-2 mb-md-0">
                顯示第 @(Model.Items.Count > 0 ? (Model.PageSize * (Model.PageNumber - 1) + 1).ToString() : "0")
                至 @(Model.PageSize * (Model.PageNumber - 1) + Model.Items.Count)
                筆結果，共 @Model.TotalCount 筆
            </div>
            <ul class="pagination mb-0 flex-wrap justify-content-center">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="1">
                        <span class="d-none d-md-inline">第一頁</span>
                        <span class="d-md-none">&lt;&lt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(Model.PageNumber - 1)">
                        <span class="d-none d-md-inline">上一頁</span>
                        <span class="d-md-none">&lt;</span>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "") d-none d-sm-block">
                        <a class="page-link" href="#" data-page-number="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(Model.PageNumber + 1)">
                        <span class="d-none d-md-inline">下一頁</span>
                        <span class="d-md-none">&gt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@Model.TotalPages">
                        <span class="d-none d-md-inline">最後一頁</span>
                        <span class="d-md-none">&gt;&gt;</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="modal fade" id="featureServiceModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">新增特色服務</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="featureServiceForm">
                    <input type="hidden" id="serviceId" name="Id" value="" />

                    <div class="form-group mb-3">
                        <label for="serviceName">特色服務名稱</label>
                        <input type="text" class="form-control" id="serviceName" name="Name" required>
                    </div>

                    <div class="form-group mb-3">
                        <label>服務圖片</label>
                        <div class="input-group mb-3">
                            <input type="file" class="form-control" id="fileInput">
                            <button id="upload" type="button" class="btn btn-outline-primary">上傳圖片</button>
                        </div>
                        <div class="mt-2 text-center">
                            <img src="" alt="" id="showimage" class="img-fluid rounded shadow-sm" style="max-height: 200px;" />
                        </div>
                        <div id="result" class="mt-2"></div>
                        <div class="form-group mt-2">
                            <input class="form-control" id="image" name="ImageUrl" readonly required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-add" id="saveBtn">儲存</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusConfirmModal" tabindex="-1" role="role" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">狀態變更確認</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="statusConfirmText">您確定要停用這筆資料嗎？</p>
                <input type="hidden" id="statusId" value="" />
                <input type="hidden" id="statusChangeTo" value="" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-deactivate" id="confirmStatusBtn">確定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/UploadImage.js"></script>
    <script>
        $(document).ready(function () {
            // 頁面載入時根據 URL 參數設定搜尋框和每頁筆數
            var urlParams = new URLSearchParams(window.location.search);
            var searchQuery = urlParams.get('searchQuery');
            var pageSize = urlParams.get('pageSize');
            if (searchQuery) {
                $('#searchQuery').val(searchQuery);
            }
            if (pageSize) {
                $('#pageSize').val(pageSize);
            }

            // 監聽每頁筆數變更
            $('#pageSize').on('change', function () {
                var newPageSize = $(this).val();
                var currentQuery = $('#searchQuery').val();
                var url = '@Url.Action("Index", "FeatureServices")' + '?page=1&pageSize=' + newPageSize + '&searchQuery=' + encodeURIComponent(currentQuery);
                window.location.href = url;
            });

            // 監聽搜尋框 Enter 鍵
            $('#searchQuery').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var newSearchQuery = $(this).val();
                    var currentPageSize = $('#pageSize').val();
                    var url = '@Url.Action("Index", "FeatureServices")' + '?page=1&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(newSearchQuery);
                    window.location.href = url;
                }
            });

            // 監聽分頁按鈕點擊
            $('.pagination').on('click', 'a.page-link', function (e) {
                e.preventDefault();
                var pageNumber = $(this).data('page-number');
                if (pageNumber && !$(this).parent().hasClass('disabled')) {
                    var currentPageSize = $('#pageSize').val();
                    var currentSearchQuery = $('#searchQuery').val();
                    var url = '@Url.Action("Index", "FeatureServices")' + '?page=' + pageNumber + '&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(currentSearchQuery);
                    window.location.href = url;
                }
            });

            // --- 以下是原有的 modal 相關 JavaScript，沒有變動 ---
            var fileInput = $("#fileInput");
            var resultDiv = $("#result");
            var image = $("#image");
            var showimage = $("#showimage");

            // 確保 UploadImage.js 的 ready 函數被調用
            ready(fileInput, showimage);

            $("#upload").on('click', function () {
                uploadFile(fileInput, resultDiv, image, showimage[0]);
            });

            $("#createBtn").on("click", function () {
                $("#modalTitle").text("新增特色服務");
                $("#featureServiceForm")[0].reset();
                $("#serviceId").val("");
                $("#image").val("");
                $("#showimage").attr("src", "");
                $("#result").empty();
                $("#saveBtn").removeClass("btn-edit").addClass("btn-add");
                $("#featureServiceModal").modal("show");
            });

            $("#featureServiceTable").on("click", ".edit-btn", function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                var imageUrl = $(this).data("imageurl");

                $("#modalTitle").text("編輯特色服務");
                $("#serviceId").val(id);
                $("#serviceName").val(name);
                $("#image").val(imageUrl);

                var src = imageUrl ? `/api/UploadFile/GetFile?fileName=${imageUrl}` : '';
                $("#showimage").attr("src", src);

                $("#result").empty();
                $("#featureServiceModal").modal("show");
                $("#saveBtn").removeClass("btn-add").addClass("btn-edit");
            });

            $("#saveBtn").on("click", function () {
                var id = $("#serviceId").val();
                var name = $("#serviceName").val();
                var imageUrl = $("#image").val();

                if (name.trim() === "" || imageUrl.trim() === "") {
                    alert("特色服務名稱與圖片不能為空。");
                    return;
                }

                var data = { Id: id, Name: name, ImageUrl: imageUrl };
                var url = id ? "/FeatureServices/Edit" : "/FeatureServices/Create";

                $.ajax({
                    url: url,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            window.location.href = window.location.pathname + window.location.search;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        $("#featureServiceModal").modal("hide");
                    }
                });
            });

            $("#featureServiceTable").on("click", ".deactivate-btn, .activate-btn", function () {
                var id = $(this).data("id");
                var isActive = $(this).data("is-active") === "True";
                var newStatus = !isActive;

                $("#statusId").val(id);
                $("#statusChangeTo").val(newStatus);
                $("#statusConfirmText").text("您確定要將此資料" + (newStatus ? "啟用" : "停用") + "嗎？");

                if (newStatus) {
                    $("#confirmStatusBtn").removeClass("btn-deactivate").addClass("btn-activate").text("啟用");
                } else {
                    $("#confirmStatusBtn").removeClass("btn-activate").addClass("btn-deactivate").text("停用");
                }
                $("#statusConfirmModal").modal("show");
            });

            $("#confirmStatusBtn").on("click", function () {
                var id = $("#statusId").val();
                var newStatus = $("#statusChangeTo").val() === "true";

                $.ajax({
                    url: "/FeatureServices/ToggleStatus/" + id,
                    type: "POST",
                    data: { isActive: newStatus },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            window.location.href = window.location.pathname + window.location.search;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        $("#statusConfirmModal").modal("hide");
                    }
                });
            });
        });
    </script>
}