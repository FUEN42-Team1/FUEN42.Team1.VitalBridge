@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/UploadImage.js"></script>
    <script>
        $(function () {
            // 表單：優先用 #registerForm；若沒有則抓第一個 POST 表單
            var form = $("#registerForm");
            if (!form.length) form = $('form[method="post"]').first();

            // 上傳元件
            var fileInput = $("#fileInput");                 // <input type="file" id="fileInput">
            var showimage = document.getElementById("showimage"); // <img id="showimage"> (DOM，給 .src 用)
            var resultDiv = $("#result");                    // 顯示訊息 <div id="result">
            var image = $("#image");                         // 組員 uploadFile 會把「檔名」寫到這裡

            // 隱藏欄位（送後端 VM）
            var imageName = $("#imageName"); // 檔名
            var imageUrl  = $("#imageUrl");  // 可取檔 URL
            var mimeType  = $("#mimeType");  // MIME

            // 即時預覽（ready 需要 jQuery 物件）
            ready(fileInput, $("#showimage"));

            // 綁定「上傳圖片」按鈕
            $("#upload").on('click', function () {

                // 只監聽「下一次」的 AJAX 成功事件（避免影響其他 AJAX）
                $(document).one('ajaxSuccess.uploadOnce', function (ev, xhr, settings) {
                    // 僅處理 /api/UploadFile 這支
                    if (settings && settings.url && settings.url.indexOf('/api/UploadFile') !== -1) {
                        var data = xhr.responseJSON;
                        if (!data && xhr.responseText) {
                            try { data = JSON.parse(xhr.responseText); } catch (_) {}
                        }

                        if (data) {
                            // 顯示回傳值
                            console.log("上傳回傳：", data);
                            resultDiv.append(
                              `<div class="mt-2 small text-success">
                                 檔名：${data.fileName || ''}<br>
                                 路徑：${data.filePath || ''}<br>
                                 大小：${data.length ?? ''}
                               </div>`
                            );

                            // 同步到隱藏欄位（讓 Register Action 可直接拿）
                            imageName.val(data.fileName || "");
                            imageUrl.val(data.filePath || "");
                            // MIME 若可從 fileInput 讀到也一併填
                            var f = fileInput[0].files && fileInput[0].files[0];
                            if (f && !mimeType.val()) mimeType.val(f.type || "");
                        } else {
                            console.warn("未取得可解析的回傳資料");
                        }
                    }
                });

                // 觸發你同事寫的上傳（第四參數要 DOM；第三參數會被寫入「檔名」）
                uploadFile(fileInput, resultDiv, image, showimage);
            });

            // 表單提交前的強制檢查：必須先「上傳成功」過
            form.on('submit', function (e) {
                // 規則：#image（由 uploadFile 寫入檔名）必須有值
                if (!image.val()) {
                    e.preventDefault();
                    // 顯示錯誤提示
                    resultDiv
                        .removeClass('text-success')
                        .addClass('text-danger')
                        .html('<p>請先上傳圖片，再提交註冊。</p>');
                    $("#upload").focus();
                    return;
                }

                // 送出前，確保三個隱藏欄位都有值（後端 VM 直接能取）
                if (!imageName.val()) imageName.val(image.val());                // 檔名
                if (!imageUrl.val() && showimage && showimage.src) imageUrl.val(showimage.src); // URL
                var f2 = fileInput[0].files && fileInput[0].files[0];
                if (f2 && !mimeType.val()) mimeType.val(f2.type || "");         // MIME
            });
        });
    </script>
}

















<script>
    $(function () {
        const $city = $('#CityId');
        const $township = $('#TownshipId');

        // 回填用
        const selectedCityId = '@(Model?.CityId.ToString() ?? "")';
        const selectedTownshipId = '@(Model?.TownshipId.ToString() ?? "")';

        // 載入縣市
        $.getJSON('/api/locations/cities', function (cities) {
            $city.html('<option value="">請選擇縣市</option>');
            $.each(cities, function (_, c) {
                $city.append(`<option value="${c.id}" ${selectedCityId == c.id ? 'selected' : ''}>${c.name}</option>`);
            });
            if (selectedCityId) {
                loadTownships(selectedCityId, selectedTownshipId);
            } else {
                $township.html('<option value="">請先選擇縣市</option>');
            }
        });

        // 縣市改變時載入鄉鎮
        $city.on('change', function () {
            loadTownships($(this).val(), null);
        });

        function loadTownships(cityId, preselect) {
            if (!cityId) {
                $township.html('<option value="">請先選擇縣市</option>');
                return;
            }
            $.getJSON(`/api/locations/cities/${cityId}/townships`, function (townships) {
                $township.html('<option value="">請選擇鄉鎮</option>');
                $.each(townships, function (_, t) {
                    $township.append(`<option value="${t.id}" ${preselect == t.id ? 'selected' : ''}>${t.name}</option>`);
                });
            });
        }
    });
</script>



