@model Team1.VitalBridge.BackStage.Models.ViewModels.Institutions.InstitutionRegisterLoginViewModel

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>機構註冊</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4">機構註冊</h2>
        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="InstitutionCode" class="form-label"></label>
                <input asp-for="InstitutionCode" class="form-control" required />
                <span asp-validation-for="InstitutionCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InstitutionName" class="form-label"></label>
                <input asp-for="InstitutionName" class="form-control" required />
                <span asp-validation-for="InstitutionName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InstitutionEmail" class="form-label"></label>
                <input asp-for="InstitutionEmail" class="form-control" type="email" required />
                <span asp-validation-for="InstitutionEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InstitutionPhone" class="form-label"></label>
                <input asp-for="InstitutionPhone" class="form-control" required />
                <span asp-validation-for="InstitutionPhone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrincipalName" class="form-label"></label>
                <input asp-for="PrincipalName" class="form-control" required />
                <span asp-validation-for="PrincipalName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrincipalPhone" class="form-label"></label>
                <input asp-for="PrincipalPhone" class="form-control" required />
                <span asp-validation-for="PrincipalPhone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CityId" class="form-label">縣市</label>
                <select asp-for="CityId" class="form-select" asp-items="@ViewBag.Cities">
                    <option value="">請選擇縣市</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TownshipId" class="form-label">鄉鎮</label>
                <select asp-for="TownshipId" class="form-select" asp-items="@ViewBag.Townships">
                    <option value="">請選擇鄉鎮</option>
                </select>
                <span asp-validation-for="TownshipId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" type="password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">提交註冊</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script asp-src-include="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script asp-src-include="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#CityId').change(function () {
                var cityId = $(this).val();
                if (cityId) {
                    $.ajax({
                        url: '@Url.Action("GetTownships", "Institution")',
                        type: 'GET',
                        data: { cityId: cityId },
                        success: function (data) {
                            $('#TownshipId').empty();
                            $('#TownshipId').append('<option value="">請選擇鄉鎮</option>');
                            $.each(data, function (index, township) {
                                $('#TownshipId').append('<option value="' + township.id + '">' + township.name + '</option>');
                            });
                        }
                    });
                } else {
                    $('#TownshipId').empty();
                    $('#TownshipId').append('<option value="">請選擇鄉鎮</option>');
                }
            });
        });
    </script>
</body>
</html>