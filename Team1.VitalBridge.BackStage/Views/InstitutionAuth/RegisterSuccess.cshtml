<!-- 如果你的專案尚未載入 Bootstrap Icons，加入這行（可留著或移除） -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-xxl py-4">
    <div class="alert alert-success d-flex align-items-start gap-3" role="alert">
        <i class="bi bi-check-circle-fill fs-3"></i>
        <div>
            <h1 class="h3 mb-1">機構註冊申請已收到</h1>
            <p class="mb-2">
                感謝您提交機構帳號申請，我們已成功收到並開始審核。一般需 <strong>1–3 個工作天</strong>，完成後將以電子郵件通知您。
            </p>
            <ul class="mb-0 small">
                <li>如需補件，我們會寄送通知至您的聯絡 Email。</li>
                <li>您可稍後再回來查看審核結果或留意信箱。</li>
            </ul>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="InstitutionAuth" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>回到登入頁面
        </a>
    </div>
</div>
