@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.shipViewModel>

@{
    ViewData["Title"] = "物流設定";
}

<h1>物流設定</h1>



<div class="container">
    <div>
        <a class="btn btn-primary" asp-controller="Ship" asp-action="CreateShipMethod">
            新增物流選項
        </a>
    </div>
<table class="table">
    <thead>
        <tr>
            
            <th>
                @Html.DisplayNameFor(model => model.ShipMethodName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShipCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                操作
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td >@item.ShipMethodName</td>
           <td>@item.ShipCost</td>
            <td>@item.IsActive</td>
            <td>
                    
                    <div class="form-check form-switch " >

                        <input 
                        class="form-check-input" 
                        type="checkbox" 
                        data-id="@item.Id"
                        
                        @(item.IsActive ==true? "checked" : "")>
                    </div>
                   
               
            </td>

            <td>
                <div class="edit">
                    編輯
                </div>

            </td>

                
        </tr>
}
    </tbody>
</table>

    

