</div>
@section Scripts {

    <script>
        // 新增淡出的效果
        window.addEventListener('DOMContentLoaded', function () {
            var alert = document.getElementById('success-alert');
            if (alert) {
                setTimeout(function () {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            }
        });
    </script>

}

