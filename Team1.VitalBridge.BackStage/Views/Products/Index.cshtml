@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "商品管理";
    var initialData = ViewBag.InitialData as Team1.VitalBridge.BackStage.Models.ViewModels.PagedResultViewModel<Team1.VitalBridge.BackStage.Models.ViewModels.ProductListViewModel>;
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>成功！</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>錯誤！</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@section Styles {
    <link href="~/css/product-search.css" rel="stylesheet" />
}
<!-- 頁面右上角訊息提示區域 -->
<div id="messageContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>

<div class="container mt-4">
    <!-- 標題列 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">商品管理</h3>
    </div>
    

    <!-- 搜尋與篩選區 -->
    <div class="card shadow-sm rounded-3 mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a class="btn btn-primary" asp-action="Create">新增商品</a>
                <div class="d-flex justify-content-end mb-3 align-items-center">
                    <span style="margin-right: 5px;">每頁</span>
                    <select id="pageSizeSelect" class="form-select" style="width: auto; display: inline-block;">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                    </select>
                    <span style="margin-left: 5px;">筆</span>
                </div>
            </div>
            <!-- 搜尋表單區域 -->
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" id="keywordInput" class="form-control" placeholder="輸入商品名稱或貨號" />
                        <button type="button" id="searchBtn" class="btn btn-primary">搜尋</button>
                    </div>
                </div>
                <div class="col-md-8 text-end">
                    <select id="statusSelect" class="form-select" style="width: auto; display: inline-block; margin-left: 10px;">
                        <option value="all">全部商品</option>
                        <option value="active">上架中</option>
                        <option value="inactive">下架中</option>
                    </select>
                </div>
            </div>
        </div>
    </div>


    <!-- 商品資料表格 -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-primary text-white">
                    <tr>
                        <th width="80">圖片</th>
                        <th>名稱</th>
                        <th>貨號</th>
                        <th>價格</th>
                        <th>庫存</th>
                        <th>上架狀態</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <!-- 商品資料將透過 JavaScript 動態載入 -->
                </tbody>
            </table>
            <!-- 無資料提示 -->
            <div id="noDataMessage" class="text-center py-4 d-none">
                <p class="text-muted">沒有找到符合條件的商品</p>
            </div>
        </div>
    </div>

    <!-- 分頁與資訊顯示 -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <!-- 左側：顯示資料範圍資訊 -->
        <div>
            <span id="dataInfo" class="text-muted"></span>
        </div>

        <!-- 右側：分頁控制 -->
        <nav>
            <ul id="pagination" class="pagination justify-content-center mb-0">
                <!-- 分頁按鈕將透過 JavaScript 動態生成 -->
            </ul>
        </nav>
    </div>

</div>

@section Scripts {
    <script>
        // 將初始資料傳遞給 JavaScript
        window.initialData = @Html.Raw(Json.Serialize(initialData));
    </script>
    <script src="~/js/product-search.js"></script>
}



