    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "Article Comment Management";
}
@section Styles {
    <link rel="stylesheet" href="~/css/AdminArticle.css" />
}
<div class="pageBody">
    <div class="container">

        <!-- Search and Filter Area -->
        <div class="search-filter-area">
            <h2>管理文章留言</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label for="articleTitleSearch">文章標題搜尋</label>
                    <input type="text" id="articleTitleSearch" placeholder="搜尋文章標題">
                </div>
                <div class="form-group">
                    <label for="memberNameSearch">成員名稱搜尋</label>
                    <input type="text" id="memberNameSearch" placeholder="搜尋會員姓名">
                </div>
                <div class="form-group">
                    <label for="commentContentSearch">留言內容搜尋</label>
                    <input type="text" id="commentContentSearch" placeholder="搜尋留言內容">
                </div>
                <div class="form-group">
                    <label for="commentStatusFilter">狀態</label>
                    <select id="commentStatusFilter">
                        <option value="all">All</option>
                        <option value="enabled">啟用</option>
                        <option value="disabled">禁用</option>
                    </select>
                </div>
            </div>
            <button class="action-button">
                篩選
            </button>
        </div>

        <!-- Rows Per Page Selector -->
        <div class="rows-per-page-area">
            <label for="rowsPerPage">每頁幾筆資料:</label>
            <select id="rowsPerPage">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="25">25</option>
                <option value="100">100</option>
            </select>
        </div>

        <!-- Comments Table Display -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>文章標題</th>
                        <th>成員名稱</th>
                        <th>留言內容</th>
                        <th>創作時間</th>
                        <th>狀態</th>
                    </tr>
                </thead>
                <tbody id="commentsTableBody">
                    <!-- Data will be populated here by JavaScript, right now it is just samples -->
                    <!-- Sample Data Rows -->
                    <tr>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>Loading...</td>
                        <td>
                            Loading...
                        </td>
                    </tr>
                    <!-- More sample data can be added here -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-controls">
            <div class="pagination-info">Page 1 of 10 (Static)</div>
            <div class="pagination-buttons">
                <button id="firstPageBtn">第一頁</button>
                <button id="prevPageBtn">上頁</button>
                <button id="nextPageBtn">下頁</button>
                <button id="lastPageBtn">最後一頁</button>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script>
        // Global variables for comment management
        // API data
        const allComments = [];
        let currentPage = 1;
        let rowsPerPage = parseInt($('#rowsPerPage').val());
        let filteredComments = []; // Stores comments after applying search filters
        let currentFilters = {
            articleTitle: '',
            memberName: '',
            commentContent: '',
            status: 'all'
        };

        /**
         * AJAX call to backend, gather data base on filters and pagination
         * returns {object} An object containing the paginated comments and total count.
        */
        
        function fetchAndFilterComments() {
            return new Promise(function(resolve, reject) {
                $.ajax({
                    url: '/api/ContentArticleCommentAPI',
                    type: 'GET',
                    data: {
                        ArticleTitle: currentFilters.articleTitle,
                        MemberName: currentFilters.memberName,
                        CommentContent: currentFilters.commentContent,
                        Status: currentFilters.status
                    },
                    success: resolve,
                    error: reject
                });
            });
        }


        /**
         * Renders the comments into the table body.
         * param {Array<object>} comments - An array of comment objects to display.
         */
        function renderTable(comments) {
            const $tbody = $('#commentsTableBody');
            $tbody.empty(); // Clear existing rows

            if (comments.length === 0) {
                $tbody.append(`<tr><td colspan="5" class="text-center py-4 text-gray-500">No comments found matching your criteria.</td></tr>`);
                return;
            }
            comments.forEach(comment => {
                const checked = comment.isEnabled ? 'checked' : ''; // <-- must be 'checked' or empty string
                const row = `
                    <tr>
                        <td>${comment.articleTitle}</td>
                        <td>${comment.memberName}</td>
                        <td>${comment.commentContent}</td>
                        <td>${comment.createdAt}</td>
                        <td>
                            <input type="checkbox" data-comment-id="${comment.id}" ${checked} aria-label="Toggle comment enabled status">
                        </td>
                    </tr>
                `;
                $tbody.append(row);
            });
        }

        /**
         * Updates the pagination info and button states.
         * param {number} totalCount - The total number of filtered comments.
         */
        function updatePaginationInfo(totalCount) {
            const totalPages = Math.ceil(totalCount / rowsPerPage);
            $('.pagination-info').text(`Page ${currentPage} of ${totalPages}`);

            $('#firstPageBtn').prop('disabled', currentPage === 1); // disable if on first page
            $('#prevPageBtn').prop('disabled', currentPage === 1); // disable if on first page
            $('#nextPageBtn').prop('disabled', currentPage === totalPages || totalPages === 0); // disable if on last page or no pages
            $('#lastPageBtn').prop('disabled', currentPage === totalPages || totalPages === 0); // disable if on last page or no pages
        }

        /**
         * Orchestrates the fetching, rendering, and pagination updates.
         * basically, summing it all up.
         * This function is called when the page loads or when filters are applied.
         */
        async function loadComments() {
            filteredComments = await fetchAndFilterComments();
            const totalComments = filteredComments.length;
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;
            const paginatedComments = filteredComments.slice(startIndex, endIndex);
            renderTable(paginatedComments);
            updatePaginationInfo(totalComments);
        }

        function updateCommentStatus(id) {
            return new Promise(function(resolve, reject) {
                $.ajax({
                    url: '/api/ContentArticleCommentAPI',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Id: id }),
                    success: resolve,
                    error: reject
                });
            });
        }

        $(document).ready(function(){
            // Set initial rows per page
            rowsPerPage = parseInt($('#rowsPerPage').val());

            // Initial load of comments
            loadComments();

            // Event listener for Apply Filters button
            $('.action-button').on('click', function() {
                currentFilters.articleTitle = $('#articleTitleSearch').val();
                currentFilters.memberName = $('#memberNameSearch').val();
                currentFilters.commentContent = $('#commentContentSearch').val();
                currentFilters.status = $('#commentStatusFilter').val();
                currentPage = 1; // Reset to first page on new filter
                loadComments();
            });

            // Event listener for Rows Per Page select
            $('#rowsPerPage').on('change', function() {
                rowsPerPage = parseInt($(this).val());
                currentPage = 1; // Reset to first page when rows per page changes
                loadComments();
            });

            // Event listeners for pagination buttons
            $('#firstPageBtn').on('click', function() {
                currentPage = 1;
                loadComments();
            });

            $('#prevPageBtn').on('click', function() {
                if (currentPage > 1) {
                    currentPage--;
                    loadComments();
                }
            });

            $('#nextPageBtn').on('click', function() {
                const totalPages = Math.ceil(filteredComments.length / rowsPerPage);
                if (currentPage < totalPages) {
                    currentPage++;
                    loadComments();
                }
            });

            $('#lastPageBtn').on('click', function() {
                const totalPages = Math.ceil(filteredComments.length / rowsPerPage);
                currentPage = totalPages;
                loadComments();
            });

            // Event listener for comment status toggles (checkboxes)
            // Using event delegation since rows are dynamically added/removed
            $('#commentsTableBody').on('change', 'input[type="checkbox"]', async function() {
                const commentId = $(this).data('comment-id');

                //Update the comment status via AJAX
                await updateCommentStatus(commentId);

                // Reload comments to reflect potential filtering changes if status filter is active
                await loadComments();
            });

        });
    </script>
}
