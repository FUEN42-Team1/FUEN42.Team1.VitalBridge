@model IEnumerable<Team1.VitalBridge.BackStage.Models.ViewModels.ContentCommentListViewModel_I>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "Comments";
}

@* alert *@
@{
    // Check if TempData contains a success message
    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    // Check if TempData contains an error message (optional, but good practice)
    if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

@if (Model != null && Model.Any())
{
    <table class="table table-bordered" id="myTable">
        <thead>
            <tr>
                @* <th>Member</th> *@
                <th>Article Title</th>
                <th>Parent Comment ID</th>
                <th>Content</th>
                <th>Pinned</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var comment in Model)
            {
                <tr>
                    @* <td>@comment.MemberName</td> *@
                    <td>@comment.ContentTitle</td>
                    <td>@comment.ParentCommentId</td>
                    <td>@comment.Content</td>
                    <td>@comment.IsPinned</td>
                    <td>@comment.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-outline-warning rounded-pill btn-sm" asp-action="Edit" asp-route-id="@comment.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No comments found.</p>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#myTable').DataTable();

        });
    </script>
}
