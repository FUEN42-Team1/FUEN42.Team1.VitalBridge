<style>
    /***** Neon gradient *****/
    .neon-btn {
        color: #fff;
        font-weight: 600;
        letter-spacing: .4px;
        background: linear-gradient(120deg,#ff00e1,#00e3ff,#ffbe00,#ff00e1);
        background-size: 300% 300%;
        border: none;
        border-radius: .5rem;
        animation: neonShift 6s ease infinite;
        box-shadow: 0 0 4px rgba(255,0,225,.6),0 0 8px rgba(0,227,255,.6);
    }

    /* Float + shadow enhancement */
    .float-btn {
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .float-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 6px rgba(255,0,225,.7),0 0 14px rgba(0,227,255,.7);
        }

        .float-btn:active {
            transform: translateY(0);
            box-shadow: 0 0 3px rgba(255,0,225,.5),0 0 8px rgba(0,227,255,.5);
        }

    /* Animated gradient */
    @@keyframes neonShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }
</style>
