@model Team1.VitalBridge.BackStage.Models.ViewModels.ManagerOrganizationDetailsViewModel

<div class="modal-header">
    <h5 class="modal-title" id="detailsModalLabel">@Html.DisplayFor(model => model.Name) - 機構詳情</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">基本資訊</h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.InstitutionName)</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.InstitutionName) ? "無" : Model.InstitutionName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TypeName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TypeName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Address)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CityName) @Html.DisplayFor(model => model.DistrictName) @Html.DisplayFor(model => model.Address)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.BedCount)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.BedCount)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AgeLimits)</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.AgeLimits) ? "無" : Model.AgeLimits)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "無" : Model.Description)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MapUrl)</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.MapUrl))
                            {
                                <a href="@Model.MapUrl" target="_blank" class="btn btn-sm btn-outline-info">查看地圖</a>
                            }
                            else
                            {
                                <span>無地圖連結</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">服務特色</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-4">
                            <h6 class="text-muted">補貼資訊</h6>
                            <ul class="list-unstyled">
                                @if (Model.SubsidyInfoNames.Any())
                                {
                                    @foreach (var item in Model.SubsidyInfoNames)
                                    {
                                        <li>@item</li>
                                    }
                                }
                                else
                                {
                                    <li>無</li>
                                }
                            </ul>
                        </div>
                        <div class="col-sm-4">
                            <h6 class="text-muted">特色服務</h6>
                            <ul class="list-unstyled">
                                @if (Model.FeatureServiceNames.Any())
                                {
                                    @foreach (var item in Model.FeatureServiceNames)
                                    {
                                        <li>@item</li>
                                    }
                                }
                                else
                                {
                                    <li>無</li>
                                }
                            </ul>
                        </div>
                        <div class="col-sm-4">
                            <h6 class="text-muted">服務對象</h6>
                            <ul class="list-unstyled">
                                @if (Model.ServiceTargetNames.Any())
                                {
                                    @foreach (var item in Model.ServiceTargetNames)
                                    {
                                        <li>@item</li>
                                    }
                                }
                                else
                                {
                                    <li>無</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">房型與價格</h6>
                </div>
                <div class="card-body">
                    @if (Model.Rooms.Any())
                    {
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>房型</th>
                                    <th class="text-end">每月價格</th>
                                    <th class="text-center">房間數量</th>
                                    <th class="text-center">有押金</th>
                                    <th class="text-end">押金金額</th>
                                    <th class="text-center">押金月數</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var room in Model.Rooms)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => room.RoomTypeName)</td>
                                        <td class="text-end">
                                            @if (room.MonthlyPrice.HasValue && room.MonthlyPrice.Value > 0)
                                            {
                                                @room.MonthlyPrice.Value.ToString("C0")
                                            }
                                            else
                                            {
                                                <span>面議</span>
                                            }
                                        </td>
                                        <td class="text-center">@Html.DisplayFor(modelItem => room.RoomQuantity)</td>
                                        <td class="text-center">
                                            @(room.HasDeposit == true ? "是" : "否")
                                        </td>
                                        <td class="text-end">
                                            @if (room.HasDeposit == true)
                                            {
                                                @room.DepositAmount?.ToString("C0")
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (room.HasDeposit == true)
                                            {
                                                @Html.DisplayFor(modelItem => room.DepositMonths)
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>無房型與價格資訊。</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0">機構照片</h6>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" class="img-fluid rounded" alt="機構照片" />
                    }
                    else
                    {
                        <div class="placeholder-img">無照片</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
</div>