@using Team1.VitalBridge.BackStage.Models.ViewModels
@model PaginatedResult<ManagerOrganizationsViewModel>

@{
    ViewData["Title"] = "機構管理";
    var pageNumber = Model.PageNumber;
    var totalPages = Model.TotalPages;
    var pageSize = Model.PageSize;
    var keyword = ViewBag.Keyword;
}

@section Styles {
    <style>
        /* 新增的表格標頭樣式 */
        .table thead th {
            background-color: #f8f9fa;
            color: #212529;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
        }

        /* Modal 標頭與頁尾配色維持淺灰色 */
        .modal-header, .modal-footer {
            background-color: #f8f9fa;
        }

        /* 響應式分頁導覽列 */
        .pagination-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .pagination-container {
                flex-direction: row;
                justify-content: space-between;
            }
        }

        /* 響應式操作按鈕 */
        @@media (max-width: 576px) {
            .action-buttons {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 5px;
            }

                .action-buttons .btn {
                    width: 100%;
                }
        }

        /* 特色服務詳情卡片樣式 */
        .feature-service-detail-card {
            border: 1px solid #e9ecef;
            transition: all 0.3s ease;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        }

        .feature-service-detail-card:hover {
            border-color: #007bff;
            box-shadow: 0 2px 8px rgba(0, 123, 255, 0.15);
            transform: translateY(-2px);
        }

        .feature-service-detail-card .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 80px;
        }

        /* 響應式調整特色服務卡片 */
        @@media (max-width: 768px) {
            .feature-service-detail-card .card-body {
                min-height: 70px;
            }
        }

        @@media (max-width: 576px) {
            .feature-service-detail-card .card-body {
                min-height: 60px;
            }
        }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h6 class="m-0 font-weight-bold text-primary">機構清單</h6>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> 新增機構
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 d-flex align-items-center mb-2 mb-md-0">
                <label for="pageSize" class="me-2">顯示</label>
                <select id="pageSize" class="form-select" style="width: auto;">
                    @{
                        var pageSizes = new[] { 5, 10, 20, 50 };
                        foreach (var size in pageSizes)
                        {
                            if (size == pageSize)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    }
                </select>
                <span class="ms-2">筆結果</span>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center">
                <label for="searchQuery" class="me-2">搜尋:</label>
                <input type="search" id="searchQuery" class="form-control" placeholder="請輸入關鍵字" style="width: auto;" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover" id="organizationsTable" width="100%" cellspacing="0">
                <colgroup>
                    <col style="width: 30%;">
                    <col style="width: 35%;">
                    <col style="width: 10%;">
                    <col style="width: 10%;">
                    <col style="width: 15%;">
                </colgroup>
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Items.First().Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Items.First().Address)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Items.First().BedCount)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Items.First().IsActive)</th>
                        <th class="text-center">操作</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Address)</td>
                            <td class="text-center">@Html.DisplayFor(modelItem => item.BedCount)</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input toggle-active-switch"
                                           type="checkbox"
                                           id="flexSwitchCheck_@item.Id"
                                           data-id="@item.Id"
                                           data-organization-name="@item.Name"
                                           @Html.Raw(item.IsActive ? "checked" : "")>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> 編輯
                                    </a>
                                    <button type="button" class="btn btn-info btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#detailsModal_@item.Id">
                                        <i class="fas fa-info-circle"></i> 詳情
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <div class="text-nowrap mb-2 mb-md-0">
                顯示第 @(Model.Items.Count > 0 ? (pageSize * (pageNumber - 1) + 1).ToString() : "0")
                至 @(pageSize * (pageNumber - 1) + Model.Items.Count)
                筆結果，共 @Model.TotalCount 筆
            </div>
            <ul class="pagination mb-0 flex-wrap justify-content-center">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="1">
                        <span class="d-none d-md-inline">第一頁</span>
                        <span class="d-md-none">&lt;&lt;</span>
                    </a>
                </li>
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(pageNumber - 1)">
                        <span class="d-none d-md-inline">上一頁</span>
                        <span class="d-md-none">&lt;</span>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "") d-none d-sm-block">
                        <a class="page-link" href="#" data-page-number="@i">@i</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(pageNumber + 1)">
                        <span class="d-none d-md-inline">下一頁</span>
                        <span class="d-md-none">&gt;</span>
                    </a>
                </li>
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@totalPages">
                        <span class="d-none d-md-inline">最後一頁</span>
                        <span class="d-md-none">&gt;&gt;</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@foreach (var item in Model.Items)
{
    var organizationDetails = (ViewBag.DetailsViewModels as List<ManagerOrganizationDetailsViewModel>)
        .FirstOrDefault(d => d.Id == item.Id);

    if (organizationDetails != null)
    {
        <div class="modal fade" id="detailsModal_@item.Id" tabindex="-1" aria-labelledby="detailsModalLabel_@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="detailsModalLabel_@item.Id">機構詳情 - @organizationDetails.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="container-fluid">
                            @if (!string.IsNullOrEmpty(organizationDetails.PhotoUrl))
                            {
                                <div class="mb-3 text-center">
                                    <img src="/api/UploadFile/GetFile?fileName=@organizationDetails.PhotoUrl" class="img-fluid rounded" alt="機構照片" style="max-height: 300px; object-fit: cover;">
                                </div>
                            }
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <p><strong>名稱:</strong> @organizationDetails.Name</p>
                                    <p><strong>所屬機構名稱:</strong> @organizationDetails.InstitutionName</p>
                                    <p><strong>機構類別名稱:</strong> @organizationDetails.TypeName</p>
                                    <p><strong>地址:</strong> @organizationDetails.CityName @organizationDetails.DistrictName @organizationDetails.Address</p>
                                    <p><strong>床位數:</strong> @organizationDetails.BedCount</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>收容年齡限制:</strong> @organizationDetails.AgeLimits</p>
                                    <p><strong>Google 地圖連結:</strong> <a href="@organizationDetails.MapUrl" target="_blank">點擊前往</a></p>
                                    <p><strong>是否啟用:</strong> @(organizationDetails.IsActive ? "是" : "否")</p>
                                </div>
                                <div class="col-12">
                                    <p><strong>機構簡述:</strong> @organizationDetails.Description</p>
                                </div>
                                <div class="col-12">
                                    <p><strong>政府補助資訊:</strong> @string.Join(", ", organizationDetails.SubsidyInfoDescription)</p>
                                </div>
                                <div class="col-12">
                                    <p><strong>特色服務:</strong></p>
                                    @if (organizationDetails.FeatureServices != null && organizationDetails.FeatureServices.Any())
                                    {
                                        <div class="row">
                                            @foreach (var featureService in organizationDetails.FeatureServices)
                                            {
                                                <div class="col-md-3 col-sm-4 col-6 mb-3">
                                                    <div class="card h-100 feature-service-detail-card">
                                                        <div class="card-body text-center p-2">
                                                            @if (!string.IsNullOrEmpty(featureService.ImageUrl))
                                                            {
                                                                <img src="/api/UploadFile/GetFile?fileName=@featureService.ImageUrl" 
                                                                     alt="@featureService.Name" 
                                                                     class="rounded mb-2" 
                                                                     style="width: 40px; height: 40px; object-fit: cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex align-items-center justify-content-center bg-light border rounded mb-2 mx-auto" 
                                                                     style="width: 40px; height: 40px; color: #6c757d;">
                                                                    <i class="fas fa-image"></i>
                                                                </div>
                                                            }
                                                            <small class="text-muted d-block">@featureService.Name</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">無特色服務</span>
                                    }
                                </div>
                                <div class="col-12">
                                    <p><strong>服務對象:</strong> @string.Join(", ", organizationDetails.ServiceTargetNames)</p>
                                </div>
                            </div>
                            <hr />

                            <h5>房型資訊</h5>
                            @if (organizationDetails.Rooms.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>房型名稱</th>
                                                <th>每月費用</th>
                                                <th>房間數量</th>
                                                <th>是否需要押金</th>
                                                <th>押金金額</th>
                                                <th>押金月數</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var room in organizationDetails.Rooms)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => room.RoomTypeName)</td>
                                                    <td>@room.MonthlyPrice?.ToString("C0")</td>
                                                    <td>@Html.DisplayFor(modelItem => room.RoomQuantity)</td>
                                                    <td>
                                                        @if (room.HasDeposit.GetValueOrDefault())
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-x-circle-fill text-danger"></i>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (room.HasDeposit.GetValueOrDefault())
                                                        {
                                                            @room.DepositAmount?.ToString("C0")
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (room.HasDeposit.GetValueOrDefault())
                                                        {
                                                            @Html.DisplayFor(modelItem => room.DepositMonths)
                                                        }
                                                        else
                                                        {
                                                            <span>-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p>無房型資訊。</p>
                            }

                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="~/sb-admin/vendor/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // 監聽每頁筆數變更
            $('#pageSize').on('change', function () {
                const newPageSize = $(this).val();
                const currentKeyword = $('#searchQuery').val();
                const url = `@Url.Action("Index", "ManagerOrganizations")?page=1&pageSize=${newPageSize}&keyword=${encodeURIComponent(currentKeyword)}`;
                window.location.href = url;
            });

            // 監聽搜尋框 Enter 鍵
            $('#searchQuery').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const newKeyword = $(this).val();
                    const currentPageSize = $('#pageSize').val();
                    const url = `@Url.Action("Index", "ManagerOrganizations")?page=1&pageSize=${currentPageSize}&keyword=${encodeURIComponent(newKeyword)}`;
                    window.location.href = url;
                }
            });

            // 監聽分頁按鈕點擊
            $('.pagination').on('click', 'a.page-link', function (e) {
                e.preventDefault();
                const pageNumber = $(this).data('page-number');
                if (pageNumber && !$(this).parent().hasClass('disabled')) {
                    const currentPageSize = $('#pageSize').val();
                    const currentKeyword = $('#searchQuery').val();
                    const url = `@Url.Action("Index", "ManagerOrganizations")?page=${pageNumber}&pageSize=${currentPageSize}&keyword=${encodeURIComponent(currentKeyword)}`;
                    window.location.href = url;
                }
            });

            // 頁面載入時根據 URL 參數設定搜尋框和每頁筆數
            const urlParams = new URLSearchParams(window.location.search);
            const keyword = urlParams.get('keyword');
            const pageSize = urlParams.get('pageSize');
            if (keyword) {
                $('#searchQuery').val(keyword);
            }
            if (pageSize) {
                $('#pageSize').val(pageSize);
            }

            // 啟用/停用切換開關的邏輯 (使用 jQuery 和 Fetch API)
            $('.toggle-active-switch').on('change', function () {
                const organizationId = $(this).data('id');
                const organizationName = $(this).data('organization-name');
                const isChecked = $(this).prop('checked');
                const switchElement = $(this);

                fetch(`@Url.Action("ToggleActive", "ManagerOrganizations")?id=${organizationId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '操作成功',
                            text: `${organizationName} 已成功${data.newIsActive ? '啟用' : '停用'}`,
                            showConfirmButton: false,
                            timer: 1500
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '操作失敗',
                            text: data.message,
                        });
                        switchElement.prop('checked', !isChecked);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: '系統錯誤',
                        text: '操作過程中發生錯誤，請稍後再試。'
                    });
                    switchElement.prop('checked', !isChecked);
                });
            });
        });
    </script>
}