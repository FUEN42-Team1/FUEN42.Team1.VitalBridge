@using Team1.VitalBridge.BackStage.Models.ViewModels
@model PaginatedResult<ManagerOrganizationsViewModel>

@{
    ViewData["Title"] = "機構管理";
    var pageNumber = Model.PageNumber;
    var totalPages = Model.TotalPages;
    var pageSize = Model.PageSize;
    var keyword = ViewBag.Keyword;
}

<div class="row">
    <div class="col-md-12">
        <h1 class="mb-4">機構清單</h1>

        <div class="d-flex justify-content-between mb-3">
            <form asp-action="Index" method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="搜尋機構名稱或地址..." />
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="submit">搜尋</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 30%;">@Html.DisplayNameFor(model => model.Items.First().Name)</th>
                            <th style="width: 30%;">@Html.DisplayNameFor(model => model.Items.First().Address)</th>
                            <th class="text-center" style="width: 10%;">@Html.DisplayNameFor(model => model.Items.First().BedCount)</th>
                            <th class="text-center" style="width: 15%;">@Html.DisplayNameFor(model => model.Items.First().IsActive)</th>
                            <th class="text-center" style="width: 15%;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr id="row-@item.Id">
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                <td class="text-center">@Html.DisplayFor(modelItem => item.BedCount)</td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active-switch"
                                               type="checkbox"
                                               id="flexSwitchCheck_@item.Id"
                                               data-id="@item.Id"
                                               @Html.Raw(item.IsActive ? "checked" : "")>
                                        <label class="form-check-label" for="flexSwitchCheck_@item.Id"></label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-info btn-sm btn-details" data-bs-toggle="modal" data-bs-target="#detailsModal" data-bs-id="@item.Id">詳情</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber - 1)" asp-route-keyword="@keyword">上一頁</a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == pageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-keyword="@keyword">@i</a>
                            </li>
                        }

                        <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber + 1)" asp-route-keyword="@keyword">下一頁</a>
                        </li>
                    </ul>
                </nav>

                <small class="text-muted">
                    第 @(Model.TotalCount == 0 ? 0 : pageNumber) 頁，共 @totalPages 頁
                    (@Model.TotalCount 項結果)
                </small>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table thead th {
            background-color: #e2f3f5;
            color: #000;
            border-bottom: 2px solid #d1d3e2;
            white-space: nowrap;
        }

        .modal-header, .modal-footer {
            background-color: #f8f9fa;
        }

        .btn-info {
            background-color: #36b9cc;
            border-color: #36b9cc;
            color: white;
        }

            .btn-info:hover {
                background-color: #2c9faf;
                border-color: #2a96a9;
                color: white;
            }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 啟用/停用切換開關的邏輯
            document.querySelectorAll('.toggle-active-switch').forEach(function (switchElement) {
                switchElement.addEventListener('change', function () {
                    const organizationId = this.dataset.id;
                    const isChecked = this.checked;

                    fetch(`@Url.Action("ToggleActive", "ManagerOrganizations")?id=${organizationId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '操作成功',
                                text: `${data.organizationName} 已成功${data.newIsActive ? '啟用' : '停用'}`,
                                showConfirmButton: false,
                                timer: 1500
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: '操作失敗',
                                text: data.message,
                            });
                            this.checked = !isChecked;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: '系統錯誤',
                            text: '操作過程中發生錯誤，請稍後再試。'
                        });
                        this.checked = !isChecked;
                    });
                });
            });

            // 詳情模態視窗的邏輯
            const detailsModalElement = document.getElementById('detailsModal');
            if (detailsModalElement) {
                detailsModalElement.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const organizationId = button.getAttribute('data-bs-id');
                    const modalContent = detailsModalElement.querySelector('.modal-content');

                    // 顯示載入中的訊息，給予使用者回饋
                    modalContent.innerHTML = `
                        <div class="modal-body text-center p-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">載入中...</p>
                        </div>
                    `;

                    // 載入 partial view
                    fetch(`@Url.Action("_DetailsPartial", "ManagerOrganizations", new { id = -1 })`.replace('-1', organizationId))
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }
                            return response.text();
                        })
                        .then(html => {
                            modalContent.innerHTML = html;
                        })
                        .catch(error => {
                            console.error('Error loading partial view:', error);
                            modalContent.innerHTML = `
                                <div class="modal-header">
                                    <h5 class="modal-title">錯誤</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>無法載入詳情內容。請稍後再試。</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                                </div>
                            `;
                        });
                });
            }
        });
    </script>
}