<style>
    .weird-card {
        background: linear-gradient(135deg, #ff00aa, #00ffe1);
        border: 5px dashed #00ff00;
        border-radius: 2rem;
        padding: 2rem;
        box-shadow: 0 0 25px #ff00ff, 0 0 15px #00ffff inset;
        transform: rotate(-1.5deg);
        animation: wiggle 3s infinite alternate ease-in-out;
        font-family: 'Comic Sans MS', cursive, sans-serif;
    }

    @@keyframes wiggle {
        0%

    {
        transform: rotate(-2deg);
    }

    100% {
        transform: rotate(2deg);
    }

    }

    .weird-card h2 {
        font-size: 2.5rem;
        color: #000;
        text-shadow: 2px 2px #fff;
        transform: rotate(3deg);
    }

    .weird-card input {
        border: 3px solid #ffcc00;
        background-color: #ffffe0;
        color: #003300;
        font-weight: bold;
    }

    .weird-btn {
        background: repeating-linear-gradient(45deg, #ff0, #0ff 10px, #f0f 10px, #ff0 20px);
        color: #000;
        border: 3px dotted #000;
        transform: skewX(-10deg);
        font-weight: bold;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%

    {
        box-shadow: 0 0 0 0 #ff00ff;
    }

    100% {
        box-shadow: 0 0 20px 10px transparent;
    }

    }

    .quick-fill {
        font-style: italic;
        color: #333;
        background: #ffdddd;
        border: 2px solid red;
        border-radius: 8px;
        padding: 2px 8px;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="weird-card text-center">
                <h2>👾 登入系統</h2>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="mb-3 text-start">
                        <label asp-for="Email" class="form-label">📧 Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-start">
                        <label asp-for="Password" class="form-label">🔑 密碼</label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn weird-btn">🚀 進入異次元</button>
                    </div>
                </form>

                <form method="post" asp-controller="AdminUsers" asp-action="SendResetPasswordLink" class="mt-3">
                    <input type="hidden" name="AdminUserId" value="DDF16E3A-82D5-4546-A5AF-F7C90B39B22B" />
                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger">⚡ 重設密碼（慎點）</button>
                    </div>
                </form>

                <div class="mt-3">
                    <button type="button" class="quick-fill" onclick="quickFill()">🧪 快速填入 (Dev)</button>
                </div>
            </div>
        </div>
    </div>
</div>















