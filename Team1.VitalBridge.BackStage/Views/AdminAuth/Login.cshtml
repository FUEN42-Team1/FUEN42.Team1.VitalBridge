@model Team1.VitalBridge.BackStage.Models.ViewModels.AdminLoginViewModel

@{
    ViewData["Title"] = "登入";
    Layout = null; // 單頁
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 樂齡橋 後台管理系統</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            /* 盡量貼近你截圖的配色 */
            --vb-bg-light: #F1F3FE; /* 頁面淡紫底 */
            --vb-card-border: #E3E7FB; /* 卡片邊 */
            --vb-primary: #3B82F6; /* 藍主色（像「詳細」按鈕） */
            --vb-warning: #F59E0B; /* 黃（像「編輯」按鈕） */
            --vb-success: #22C55E; /* 綠徽章 */
            --vb-danger: #EF4444; /* 紅徽章 */
            --vb-muted: #94A3B8; /* 灰徽章 */
            --vb-input: #E5E9FF; /* 輕邊框用 */
            --vb-text: #1F2937;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--vb-bg-light);
            color: var(--vb-text);
        }

        .auth-shell {
            min-height: 100%;
            display: grid;
            place-items: center;
            padding: 32px 16px;
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border: 1px solid var(--vb-card-border);
            border-radius: 16px;
            box-shadow: 0 6px 22px rgba(31,41,55,.06);
            overflow: hidden;
            animation: fadeIn .35s ease-out both;
        }
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(8px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }

        }

        .auth-head {
            padding: 18px 22px;
            border-bottom: 1px solid var(--vb-card-border);
            background: #fff;
        }

            .auth-head h1 {
                font-size: 1.35rem;
                font-weight: 700;
                letter-spacing: .02em;
                margin: 0;
            }

        .auth-sub {
            font-size: .9rem;
            color: #64748B;
        }

        .auth-body {
            padding: 22px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .input-group-text {
            background: #F7F8FF;
            border-color: var(--vb-input);
        }

        .form-control {
            border-color: var(--vb-input);
        }

            .form-control:focus {
                border-color: var(--vb-primary);
                box-shadow: 0 0 0 .2rem rgba(59,130,246,.15);
            }

        .btn-primary {
            background: var(--vb-primary);
            border-color: var(--vb-primary);
            font-weight: 600;
        }

            .btn-primary:hover {
                filter: brightness(.96);
            }

        .btn-outline-warning {
            color: #8a5a00;
            border-color: var(--vb-warning);
        }

            .btn-outline-warning:hover {
                background: var(--vb-warning);
                border-color: var(--vb-warning);
                color: #fff;
            }

        .alert-validation {
            border: 1px solid #FAD1D1;
            background: #FFF4F5;
            color: #B91C1C;
            border-radius: 12px;
            padding: .75rem 1rem;
        }

        .auth-foot {
            padding: 14px 22px 20px;
            border-top: 1px dashed var(--vb-card-border);
            display: flex;
            gap: .75rem;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .mini {
            color: #64748B;
            font-size: .9rem;
        }

        .vb-link {
            color: var(--vb-primary);
            text-decoration: none;
        }

            .vb-link:hover {
                text-decoration: underline;
            }

        /* 軟色徽章（風格接近列表頁） */
        .badge-soft {
            font-weight: 600;
            border-radius: 999px;
            padding: .35rem .6rem;
        }

        .badge-soft-success {
            color: #14532d;
            background: rgba(34,197,94,.15);
            border: 1px solid rgba(34,197,94,.25);
        }

        .badge-soft-warning {
            color: #78350f;
            background: rgba(245,158,11,.15);
            border: 1px solid rgba(245,158,11,.25);
        }

        .badge-soft-danger {
            color: #7f1d1d;
            background: rgba(239,68,68,.14);
            border: 1px solid rgba(239,68,68,.25);
        }

        .badge-soft-muted {
            color: #334155;
            background: rgba(148,163,184,.16);
            border: 1px solid rgba(148,163,184,.28);
        }

        /* 細節：輸入/按鈕的圓角一致 */
        .form-control, .input-group-text, .btn {
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-head">
                <h1 class="d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill"></i> 管理後台登入
                    <span class="badge badge-soft badge-soft-muted ms-auto">樂齡橋 VitalBridge</span>
                </h1>
                @* <div class="auth-sub mt-1">請使用管理者帳號登入系統</div> *@
            </div>

            <div class="auth-body">
                <form asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- 驗證摘要 -->
                    <div asp-validation-summary="ModelOnly" class="alert-validation mb-3"></div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">電子郵件</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-2">
                        <label asp-for="Password" class="form-label">密碼</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" id="Password" type="password" placeholder="請輸入密碼" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePwd" aria-label="顯示/隱藏密碼">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @* <div class="d-flex justify-content-between align-items-center mb-3"> *@
                    @*     <a class="vb-link" asp-controller="AdminAuth" asp-action="Forgot">忘記密碼？</a> *@
                    @*     <!-- 需要也可加：<a class="vb-link" asp-controller="AdminAuth" asp-action="Register">建立帳號</a> --> *@
                    @* </div> *@
                    <div style="height: 32px;"></div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-1"></i> 登入
                        </button>
                    </div>
                </form>

                <!-- 管理員重設密碼：改成貼近清單頁的次要風格 -->
                @* <form class="mt-3" method="post" asp-controller="AdminUsers" asp-action="SendResetPasswordLink"> *@
                @*     <input type="hidden" name="AdminUserId" value="DDF16E3A-82D5-4546-A5AF-F7C90B39B22B" /> *@
                @*     <button type="submit" class="btn btn-outline-warning w-100"> *@
                @*         <i class="bi bi-arrow-repeat me-1"></i> 寄送重設密碼連結（管理員） *@
                @*     </button> *@
                @* </form> *@
            </div>

            <div class="auth-foot">
                <div class="mini">
                    狀態：<span class="badge badge-soft badge-soft-success">服務正常</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill()">
                        <i class="bi bi-lightning-charge"></i> 快速填入 (Dev)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // 顯示/隱藏密碼（維持後台冷靜風格，不加過多動畫）
        (function () {
            const btn = document.getElementById('togglePwd');
            const input = document.getElementById('Password');
            if (btn && input) {
                btn.addEventListener('click', () => {
                    const isPwd = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isPwd ? 'text' : 'password');
                    const icon = btn.querySelector('i');
                    if (icon){ icon.classList.toggle('bi-eye'); icon.classList.toggle('bi-eye-slash'); }
                });
            }
        })();

        // Dev 快速填入
        function quickFill(){
            const email = document.getElementById('Email');
            const pwd = document.getElementById('Password');
            if (email) email.value = 'chaosun@yahoo.com';
            if (pwd)   pwd.value = '123456';
        }
    </script>
</body>
</html>
