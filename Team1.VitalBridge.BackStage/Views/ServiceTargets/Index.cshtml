@model Team1.VitalBridge.BackStage.Models.ViewModels.PaginatedResult<Team1.VitalBridge.BackStage.Models.EFModels.ServiceTarget>

@{
    ViewData["Title"] = "服務對象清單";
}

@section Styles {
    <style>
        /* 新增/編輯/啟用/停用按鈕配色 */
        .btn-add {
            background-color: #28a745; /* 綠色 */
            color: white;
            border-color: #28a745;
        }

            .btn-add:hover {
                background-color: #218838;
                border-color: #1e7e34;
                color: white;
            }

        .btn-edit {
            background-color: #ffc107; /* 橘黃色 */
            color: white;
            border-color: #ffc107;
        }

            .btn-edit:hover {
                background-color: #e0a800;
                border-color: #d39e00;
                color: white;
            }

        /* 啟用/停用按鈕的樣式 */
        .btn-deactivate {
            background-color: #e74a3b; /* 紅色 */
            color: white;
            border-color: #e74a3b;
        }

            .btn-deactivate:hover {
                background-color: #c82333;
                border-color: #bd2130;
                color: white;
            }

        .btn-activate {
            background-color: #36b9cc; /* 藍色 */
            color: white;
            border-color: #36b9cc;
        }

            .btn-activate:hover {
                background-color: #2c9faf;
                border-color: #2a96a9;
                color: white;
            }

        /* 表格標頭配色 */
        .table thead th {
            background-color: #e2f3f5; /* 淺藍綠色 */
            color: #000;
            border-bottom: 2px solid #d1d3e2;
            white-space: nowrap; /* 防止標題文字換行 */
        }

        /* Modal 標頭與頁尾配色 */
        .modal-header, .modal-footer {
            background-color: #f8f9fa; /* 淺灰色背景 */
        }

        /* 確保表格在任何大小下都有一致的欄位寬度 */
        #serviceTargetTable {
            table-layout: fixed;
            width: 100%;
        }

            #serviceTargetTable th:nth-child(1),
            #serviceTargetTable td:nth-child(1) {
                width: 50%;
            }

            #serviceTargetTable th:nth-child(2),
            #serviceTargetTable td:nth-child(2) {
                width: 20%;
            }

            #serviceTargetTable th:nth-child(3),
            #serviceTargetTable td:nth-child(3) {
                width: 30%;
            }

            /* 讓表格內容在空間不足時自動換行 */
            #serviceTargetTable td {
                word-break: break-word;
                overflow-wrap: break-word;
            }

        /* 響應式分頁導覽列 */
        .pagination-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .pagination-container {
                flex-direction: row;
                justify-content: space-between;
            }
        }

        /* 響應式操作按鈕：讓按鈕在小螢幕時垂直排列 */
        @@media (max-width: 576px) {
            #serviceTargetTable td:last-child {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 5px; /* 按鈕間的間距 */
            }

                #serviceTargetTable td:last-child .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h6 class="m-0 font-weight-bold text-primary">服務對象清單</h6>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" class="btn btn-add" data-toggle="modal" data-target="#serviceTargetModal" id="createBtn">
                    <i class="fas fa-plus"></i> 新增服務對象
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 d-flex align-items-center">
                <label for="pageSize" class="mr-2">顯示</label>
                <select id="pageSize" class="form-control" style="width: auto;">
                    @{
                        var pageSizes = new[] { 5, 10, 20, 50 };
                        foreach (var size in pageSizes)
                        {
                            if (size == Model.PageSize)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    }
                </select>
                <span class="ml-2">筆結果</span>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0">
                <label for="searchQuery" class="mr-2">搜尋:</label>
                <input type="search" id="searchQuery" class="form-control" placeholder="請輸入關鍵字" style="width: auto;" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered" id="serviceTargetTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Items.First().Name)
                        </th>
                        <th>
                            狀態
                        </th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr id="row-@item.Id">
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                    @(item.IsActive ? "啟用中" : "已停用")
                                </span>
                            </td>
                            <td>
                                <a href="#" class="btn btn-edit btn-sm edit-btn" data-id="@item.Id" data-name="@item.Name" data-is-active="@item.IsActive">
                                    <i class="fas fa-edit"></i> 編輯
                                </a>
                                <a href="#" class="btn btn-sm @(item.IsActive ? "btn-deactivate deactivate-btn" : "btn-activate activate-btn")" data-id="@item.Id" data-is-active="@item.IsActive">
                                    <i class="fas @(item.IsActive ? "fa-power-off" : "fa-check")"></i> @(item.IsActive ? "停用" : "啟用")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <div class="text-nowrap mb-2 mb-md-0">
                顯示第 @(Model.Items.Count > 0 ? (Model.PageSize * (Model.PageNumber - 1) + 1).ToString() : "0")
                至 @(Model.PageSize * (Model.PageNumber - 1) + Model.Items.Count)
                筆結果，共 @Model.TotalCount 筆
            </div>
            <ul class="pagination mb-0 flex-wrap justify-content-center">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="1">
                        <span class="d-none d-md-inline">第一頁</span>
                        <span class="d-md-none">&lt;&lt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(Model.PageNumber - 1)">
                        <span class="d-none d-md-inline">上一頁</span>
                        <span class="d-md-none">&lt;</span>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "") d-none d-sm-block">
                        <a class="page-link" href="#" data-page-number="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@(Model.PageNumber + 1)">
                        <span class="d-none d-md-inline">下一頁</span>
                        <span class="d-md-none">&gt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="#" data-page-number="@Model.TotalPages">
                        <span class="d-none d-md-inline">最後一頁</span>
                        <span class="d-md-none">&gt;&gt;</span>
                    </a>
                </li>
            </ul>
        </div>

    </div>
</div>

<div class="modal fade" id="serviceTargetModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">新增服務對象</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="serviceTargetForm">
                    <input type="hidden" id="serviceTargetId" name="Id" value="" />
                    <div class="form-group">
                        <label for="serviceTargetName">服務對象名稱</label>
                        <input type="text" class="form-control" id="serviceTargetName" name="Name" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-add" id="saveBtn">儲存</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusConfirmModal" tabindex="-1" role="dialog" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">狀態變更確認</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="statusConfirmText">您確定要停用這筆資料嗎？</p>
                <input type="hidden" id="statusId" value="" />
                <input type="hidden" id="statusChangeTo" value="" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-deactivate" id="confirmStatusBtn">確定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // 監聽「啟用/停用確認」Modal 的 Enter 鍵
            $('#statusConfirmModal').on('shown.bs.modal', function () {
                $(document).on('keypress', function (e) {
                    // Enter 鍵的 key code 是 13
                    if (e.which === 13) {
                        e.preventDefault(); // 防止預設行為
                        $('#confirmStatusBtn').click();
                    }
                });
            });

            // 當 Modal 關閉時，移除 Enter 鍵監聽，避免影響其他地方
            $('#statusConfirmModal').on('hidden.bs.modal', function () {
                $(document).off('keypress');
            });

            // 新增按鈕
            $("#createBtn").on("click", function () {
                $("#modalTitle").text("新增服務對象");
                $("#serviceTargetForm")[0].reset();
                $("#serviceTargetId").val("");
                $("#saveBtn").removeClass("btn-edit").addClass("btn-add");
            });

            // 編輯按鈕
            $("#serviceTargetTable").on("click", ".edit-btn", function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                $("#modalTitle").text("編輯服務對象");
                $("#serviceTargetId").val(id);
                $("#serviceTargetName").val(name);
                $("#serviceTargetModal").modal("show");
                $("#saveBtn").removeClass("btn-add").addClass("btn-edit");
            });

            // 監聽 Enter 鍵，按下後觸發表單提交
            $("#serviceTargetName").on("keydown", function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $("#saveBtn").click();
                }
            });

            // 儲存按鈕 (新增與編輯)
            $("#saveBtn").on("click", function () {
                var id = $("#serviceTargetId").val();
                var name = $("#serviceTargetName").val();
                var url = "";

                if (name.trim() === "") {
                    alert("服務對象名稱不能為空。");
                    return;
                }

                var data = { Name: name };
                if (id) {
                    url = "/ServiceTargets/Edit/" + id;
                    data.Id = id;
                } else {
                    url = "/ServiceTargets/Create";
                }

                $.ajax({
                    url: url,
                    type: "POST",
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            window.location.href = window.location.pathname + window.location.search;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        $("#serviceTargetModal").modal("hide");
                    }
                });
            });

            // 啟用/停用按鈕
            $("#serviceTargetTable").on("click", ".deactivate-btn, .activate-btn", function () {
                var id = $(this).data("id");
                var isActive = $(this).data("is-active") === "True";
                var newStatus = !isActive;

                $("#statusId").val(id);
                $("#statusChangeTo").val(newStatus);
                $("#statusConfirmText").text("您確定要將此資料" + (newStatus ? "啟用" : "停用") + "嗎？");

                if (newStatus) {
                    $("#confirmStatusBtn").removeClass("btn-deactivate").addClass("btn-activate").text("啟用");
                } else {
                    $("#confirmStatusBtn").removeClass("btn-activate").addClass("btn-deactivate").text("停用");
                }

                $("#statusConfirmModal").modal("show");
            });

            // 確認啟用/停用按鈕
            $("#confirmStatusBtn").on("click", function () {
                var id = $("#statusId").val();
                var newStatus = $("#statusChangeTo").val() === "true";

                $.ajax({
                    url: "/ServiceTargets/ToggleStatus/" + id,
                    type: "POST",
                    data: { isActive: newStatus },
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            window.location.href = window.location.pathname + window.location.search;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        $("#statusConfirmModal").modal("hide");
                    }
                });
            });

            // 頁面載入時根據 URL 參數設定搜尋框和每頁筆數
            var urlParams = new URLSearchParams(window.location.search);
            var searchQuery = urlParams.get('searchQuery');
            var pageSize = urlParams.get('pageSize');
            if (searchQuery) {
                $('#searchQuery').val(searchQuery);
            }
            if (pageSize) {
                $('#pageSize').val(pageSize);
            }

            // 監聽每頁筆數變更
            $('#pageSize').on('change', function () {
                var newPageSize = $(this).val();
                var currentQuery = $('#searchQuery').val();
                var url = '@Url.Action("Index", "ServiceTargets")' + '?page=1&pageSize=' + newPageSize + '&searchQuery=' + encodeURIComponent(currentQuery);
                window.location.href = url;
            });

            // 監聽搜尋框 Enter 鍵
            $('#searchQuery').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var newSearchQuery = $(this).val();
                    var currentPageSize = $('#pageSize').val();
                    var url = '@Url.Action("Index", "ServiceTargets")' + '?page=1&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(newSearchQuery);
                    window.location.href = url;
                }
            });

            // 監聽分頁按鈕點擊
            $('.pagination').on('click', 'a.page-link', function (e) {
                e.preventDefault();
                var pageNumber = $(this).data('page-number');
                if (pageNumber) {
                    var currentPageSize = $('#pageSize').val();
                    var currentSearchQuery = $('#searchQuery').val();
                    var url = '@Url.Action("Index", "ServiceTargets")' + '?page=' + pageNumber + '&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(currentSearchQuery);
                    window.location.href = url;
                }
            });
        });
    </script>
}