<div>
    <a asp-action="Index">回上頁</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {

            let baseAddress = 'https://localhost:7184';
            let isLoaded = false;

            $('#parent-category-select').on('click', function () {
                if (isLoaded) return; // Load only once

                fetch(`${baseAddress}/api/ContentCategoriesAPI`)
                    .then(response => response.json())
                    .then(data => {
                        const select = document.getElementById("parent-category-select");
                        if ("@Model.ParentCategoryId"!=null){
                            const option = document.createElement("option");
                            option.value = null;
                            option.text = "沒有父類別";
                            select.appendChild(option);
                        }
                        data.forEach(item => {
                            // Skip if already selected, goes to next item
                            if (item.id == "@Model.ParentCategoryId") return;

                            const option = document.createElement("option");
                            option.value = item.id;
                            option.text = item.name;
                            select.appendChild(option);
                        });
                        isLoaded = true;
                    })
                    .catch(err => console.error("Failed to load categories:", err));
            });
        });
    </script>
}
