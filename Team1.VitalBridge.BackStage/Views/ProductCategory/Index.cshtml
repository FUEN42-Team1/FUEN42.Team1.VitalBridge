@{
    ViewData["Title"] = "商品類別";
}


<style>
    .category-container {
        max-width: 600px;
        margin: 20px auto;
    }

    .add-category-btn {
        background-color: #f8d7da;
        color: #721c24;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: 500;
        margin-bottom: 15px;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .add-category-btn:hover {
            background-color: #f1b4b8;
            color: #721c24;
        }

    .category-content {
        border: 2px solid #6c757d;
        border-radius: 6px;
        padding: 20px;
        background-color: #fff;
    }

    .main-category {
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px solid #e9ecef;
    }

    .category-group {
        margin-bottom: 25px;
    }

    .parent-category {
        font-weight: 500;
        color: #495057;
        margin-bottom: 8px;
        position: relative;
        cursor: pointer;
        user-select: none;
    }

        .parent-category::after {
            content: '▼';
            position: absolute;
            right: 0;
            font-size: 12px;
            color: #6c757d;
            transition: transform 0.3s ease;
        }

        .parent-category.collapsed::after {
            transform: rotate(-90deg);
        }

    .sub-categories {
        margin-left: 20px;
        margin-top: 8px;
    }

    .sub-category {
        color: #6c757d;
        margin-bottom: 6px;
        padding: 4px 0;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .sub-category:hover {
            color: #007bff;
            text-decoration: underline;
        }

    .collapse-transition {
        transition: all 0.3s ease;
    }

    .sub-category.selected {
        color: #007bff;
        font-weight: 500;
    }

    /* 類別名稱樣式 */
    .category-name {
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .category-name:hover {
            color: #007bff;
            text-decoration: underline;
        }

    .parent-category .category-name {
        color: #495057;
    }

        .parent-category .category-name:hover {
            color: #007bff;
        }

    .sub-category .category-name {
        color: #6c757d;
    }

        .sub-category .category-name:hover {
            color: #007bff;
        }
</style>


<div class="container">
    <div class="category-container">
        <!--新增商品類別按鈕-->
        <button type="button" class="add-category-btn add-category-btn" onclick="lacation.href='@Url.Action("Create", "ProductCategory")'">
            新增商品類別
        </button>

        <!-- 類別列表容器 -->
        <div id="category-list">
            <!-- 動態生成的類別列表會放在這裡 -->
        </div>

    </div>
</div>


