@{
    ViewData["Title"] = "商品類別";
}


<style>
    .category-container {
        max-width: 600px;
        margin: 20px auto;
    }

    .add-category-btn {
        background-color: #21AD5B;
        color: #F2FFF7;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: 500;
        margin-bottom: 15px;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .add-category-btn:hover {
            background-color: #16763E;
            color: #F2FFF7;
        }

    .category-content {
        border: 2px solid #6c757d;
        border-radius: 6px;
        padding: 20px;
        background-color: #fff;
    }

    .main-category {
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px solid #e9ecef;
    }

    .category-group {
        margin-bottom: 25px;
    }

    .parent-category {
        font-weight: 500;
        color: #495057;
        margin-bottom: 8px;
        position: relative;
        cursor: pointer;
        user-select: none;
    }

        .parent-category::after {
            content: '▼';
            position: absolute;
            right: 0;
            font-size: 12px;
            color: #6c757d;
            transition: transform 0.3s ease;
        }

        .parent-category.collapsed::after {
            transform: rotate(-90deg);
        }

    .sub-categories {
        margin-left: 20px;
        margin-top: 8px;
    }

    .sub-category {
        color: #6c757d;
        margin-bottom: 6px;
        padding: 4px 0;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .sub-category:hover {
            color: #007bff;
            text-decoration: underline;
        }

    .collapse-transition {
        transition: all 0.3s ease;
    }

    .sub-category.selected {
        color: #007bff;
        font-weight: 500;
    }

    /* 類別名稱樣式 */
    .category-name {
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .category-name:hover {
            color: #007bff;
            text-decoration: underline;
        }

    .parent-category .category-name {
        color: #495057;
    }

        .parent-category .category-name:hover {
            color: #007bff;
        }

    .sub-category .category-name {
        color: #6c757d;
    }

        .sub-category .category-name:hover {
            color: #007bff;
        }

    /* Toast 樣式 */
    .toast {
        min-width: 300px;
    }

    .validation-alert {
        margin-bottom: 1rem;
    }

        .validation-alert ul {
            margin-top: 0.5rem;
            padding-left: 1.5rem;
        }
</style>


<div class="container">
    <div class="category-container">
        <!--新增商品類別按鈕-->
        <button type="button" class="add-category-btn" data-bs-toggle="modal" data-bs-target="#CreateProductCategory">
            新增商品類別
        </button>

        <!--新增商品類別的 Modal-->
        <div class="modal fade" id="CreateProductCategory" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog"
             aria-labelledby="modalTitleId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitleId">
                            新增商品類別
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="container">
                            <!-- 隱藏的 ID 欄位 -->
                            <input type="hidden" id="categoryId">

                            <div class="mb-3">
                                <label for="categoryName" class="form-label">類別名稱</label>
                                <input class="form-control" id="categoryName" placeholder="請輸入商品類別名稱" maxlength="50">
                            </div>
                            <div class="mb-3">
                                <label for="parentCategory" class="form-label">上層類別</label>
                                <select class="form-select" id="parentCategory" name="FatherId">
                                    <option value="">--無上層類別--</option>
                                    <!--這邊用JS載入-->

                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">啟用狀態</label>
                                <div class="form-check form-switch " id="isActive" name=" isActive">

                                    <input class="form-check-input" type="checkbox" id="categoryIsActive" checked>
                                </div>

                            </div>

                            <!--處理圖片區塊-->
                            <div class="input-group mb-3">
                                <label class="form-label">類別圖片</label>
                                <div class="input-group">
                                    <input type="file" class="form-control" id="fileInput" accept="image/*">
                                    <button id="upload" type="button" class="btn btn-outline-primary">上傳圖片</button>
                                </div>
                            </div>
                            <div>
                                <img src="" alt="" id="showimage" class="img-fluid rounded shadow-sm" />
                            </div>
                            <div id="result"></div>
                            <div class="form-group mb-3">
                                <input class="form-control" id="image" readonly />
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            關閉
                        </button>
                        <button type="button" class="btn btn-primary" id="createCategory">新增</button>
                    </div>
                </div>
            </div>
        </div>

        <!--編輯商品類別的 Modal-->
        <div class="modal fade" id="EditProductCategory" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog"
             aria-labelledby="editModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editModalTitle">
                            編輯商品類別
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="container">
                            <!-- 隱藏的 ID 欄位 -->
                            <input type="hidden" id="editCategoryId">

                            <div class="mb-3">
                                <label for="editCategoryName" class="form-label">類別名稱</label>
                                <input class="form-control" id="editCategoryName" placeholder="請輸入商品類別名稱" maxlength="50">
                            </div>
                            <div class="mb-3">
                                <label for="editParentCategory" class="form-label">上層類別</label>
                                <select class="form-select" id="editParentCategory" name="FatherId">
                                    <option value="">--無上層類別--</option>
                                    <!--這邊用JS載入-->

                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">啟用狀態</label>
                                <div class="form-check form-switch " id="editIsActive">
                                    <input class="form-check-input" type="checkbox" id="editCategoryIsActive" checked>
                                </div>

                            </div>

                            <!--處理圖片區塊-->
                            <div class="input-group mb-3">
                                <label class="form-label">類別圖片</label>
                                <div class="input-group">
                                    <input type="file" class="form-control" id="editFileInput" accept="image/*">
                                    <button id="editUpload" type="button" class="btn btn-outline-primary">上傳圖片</button>
                                </div>
                            </div>
                            <div>
                                <img src="" alt="" id="editShowimage" class="img-fluid rounded shadow-sm" />
                            </div>
                            <div id="editResult"></div>
                            <div class="form-group mb-3">
                                <input class="form-control" id="editImage" readonly />
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            關閉
                        </button>
                        <button type="button" class="btn btn-primary" id="updateCategory">確認修改</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- 類別列表容器 -->
        <div id="category-list">
            <!-- 動態生成的類別列表會放在這裡 -->
        </div>

    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('頁面載入完成'); // 測試用
            // 載入類別資料
            loadCategories();

        })
        // 載入類別資料呼叫 API 這邊用fetch
        function loadCategories(){
            fetch('/api/ProductCategoryApi', { method: 'GET' })
            .then(response => response.json())
            .then(data => {
                console.log('類別資料:', data); // 測試用
                renderCategories(data);
            })
            .catch(error => {
                console.error('載入類別資料失敗:', error);
            });

        }

        // 渲染類別資料 (將程式碼轉化為畫面)
        function renderCategories(categories){
            // 清空現有的類別列表所有內容
            const categoryList = document.getElementById('category-list');
            categoryList.innerHTML = '';

            //  計算level層級並轉換資料，屬於父類別還是子類別，並且分組
            const categoriesWithLevel = categories.map(category => {
                return {
                    ...category,
                    level: (category.fatherId != null) ? 1 : 0 // 假設 fatherId 存在表示是子類別
                };
            });

            // 取得根類別
            const rootCategories = categoriesWithLevel.filter(c=> c.level === 0);

             rootCategories.forEach(parent => {
                // 建立類別群組
                const categoryGroup = document.createElement('div');
                categoryGroup.className = 'category-group';

                // 父類別標題
                const parentDiv = document.createElement('div');
                parentDiv.className = 'parent-category collapsed';
                parentDiv.setAttribute('data-bs-toggle', 'collapse');
                parentDiv.setAttribute('data-bs-target', `#category_${parent.id}`);
                parentDiv.setAttribute('aria-expanded', 'false');

                // 父類別名稱 (可點擊編輯)
                const parentNameSpan = document.createElement('span');
                parentNameSpan.className = 'category-name';
                parentNameSpan.textContent = parent.name;
                parentNameSpan.setAttribute('data-id', parent.id);

                parentDiv.appendChild(parentNameSpan);
                categoryGroup.appendChild(parentDiv);

                // 取得該父類別的子類別
                const children = categoriesWithLevel.filter(c => c.fatherId === parent.id);

                if (children.length > 0) {
                    // 建立收合容器
                    const collapseDiv = document.createElement('div');
                    collapseDiv.className = 'collapse collapse-transition';
                    collapseDiv.id = `category_${parent.id}`;

                    const subCategoriesDiv = document.createElement('div');
                    subCategoriesDiv.className = 'sub-categories';

                    children.forEach(child => {
                        const childDiv = document.createElement('div');
                        childDiv.className = 'sub-category';

                        // 子類別名稱 (可點擊編輯)
                        const childNameSpan = document.createElement('span');
                        childNameSpan.className = 'category-name';
                        childNameSpan.textContent = child.name;
                        childNameSpan.setAttribute('data-id', child.id);

                        childDiv.appendChild(childNameSpan);
                        subCategoriesDiv.appendChild(childDiv);
                    });

                    collapseDiv.appendChild(subCategoriesDiv);
                    categoryGroup.appendChild(collapseDiv);
                }

                categoryList.appendChild(categoryGroup);
            });

            // 綁定事件
            bindEvents();


        }
        // 綁定事件處理
        function bindEvents() {
            // 展開/收合的箭頭動畫
            document.querySelectorAll('.collapse').forEach(function(collapseElement) {
                collapseElement.addEventListener('show.bs.collapse', function() {
                    var trigger = document.querySelector('[data-bs-target="#' + this.id + '"]');
                    if (trigger) {
                        trigger.classList.remove('collapsed');
                    }
                });

                collapseElement.addEventListener('hide.bs.collapse', function() {
                    var trigger = document.querySelector('[data-bs-target="#' + this.id + '"]');
                    if (trigger) {
                        trigger.classList.add('collapsed');
                    }
                });
            });

            // 點擊類別名稱開啟編輯 Modal
            document.querySelectorAll('.category-name').forEach(function(element) {
                element.addEventListener('click', function(e) {
                    e.stopPropagation(); // 阻止觸發展開/收合
                    var categoryId = this.getAttribute('data-id');
                    openEditModal(categoryId);
                });
            });

            // 保留子類別的選中效果（點擊空白區域）
            document.querySelectorAll('.sub-category').forEach(function(element) {
                element.addEventListener('click', function(e) {
                    // 如果點擊的是類別名稱，不處理選中效果
                    if (e.target.classList.contains('category-name')) {
                        return;
                    }

                    // 移除其他選中狀態
                    document.querySelectorAll('.sub-category').forEach(function(item) {
                        item.classList.remove('selected');
                    });

                    // 添加選中狀態
                    this.classList.add('selected');

                    var categoryId = this.querySelector('.category-name').getAttribute('data-id');
                    console.log('選中類別ID：', categoryId);
                });
            });
        }




        // 重新載入資料的公用方法（新增或編輯完成後可呼叫）
        function refreshCategories() {
            document.getElementById('category-list').style.display = 'none';
            document.getElementById('loading').style.display = 'block';
            document.getElementById('error-message').style.display = 'none';
            loadCategories();
        }



        // 暴露給全域使用
        window.categoryManager = {
            refresh: refreshCategories
        };

        // ========== 新增功能相關程式碼 ==========
        // 監聽 Modal 開啟事件
        document.getElementById('CreateProductCategory').addEventListener('shown.bs.modal', function(){

            loadParentOptions();
            document.getElementById('categoryName').focus();
        })

        // 提交新增表單
        document.getElementById('createCategory').addEventListener('click', submitCreateForm);

        function submitCreateForm() {
            // 在一開始就清除舊的錯誤
            clearAllFieldErrors('create');


            // 取得表單資料
            const categoryName = document.getElementById('categoryName').value.trim();
            const parentCategory= document.getElementById('parentCategory').value;
            const isActive = document.getElementById('categoryIsActive').checked;

            // 前端驗證
            const validationErrors = validateForm(categoryName, parentCategory);
            if (validationErrors.length > 0) {
               showValidationErrors(validationErrors);
               return;
            }

            // 準備送出資料
            const createDto = {
            name: categoryName,
            fatherId: parentCategory ? parseInt(parentCategory) : null,
            isActive: isActive
            };

            // 顯示載入中狀態
            const createButton = document.getElementById('createCategory');
            const originalText = createButton.textContent;
            createButton.disabled = true;
            createButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>處理中';

            // 呼叫API
            fetch('/api/ProductCategoryApi', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                // 傳送資料
                body: JSON.stringify(createDto)
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err));
                }
                    return response.json();
            })
            .then(data => {
                // 成功處理
                console.log('新增成功:', data);

                // 顯示成功訊息
                showSuccessMessage('商品類別新增成功！');

                // 關閉 Modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('CreateProductCategory'));
                modal.hide();

                // 清空表單
                resetCreateForm();

                // 重新載入類別列表
                loadCategories();
            })
            .catch(error => {
                // 錯誤處理
                console.error('新增失敗:', error);

                handleApiError(error, 'create'); // 這裡改成呼叫共用錯誤處理
            })
            .finally(() => {
                // 恢復按鈕狀態
                createButton.disabled = false;
                createButton.textContent = originalText;
            });
        }




        // 前端表單驗證
        function validateForm(name, parentId) {
            const errors = [];

            // 驗證名稱
            if (!name) {
                errors.push('請輸入類別名稱');
            } else if (name.length > 50) {
                errors.push('類別名稱不能超過50個字元');
            }
            return errors;
        }

        // 重置新增表單
        function resetCreateForm() {
            document.getElementById('categoryName').value = '';
            document.getElementById('parentCategory').value = '';
            document.getElementById('categoryIsActive').checked = true;

             // 清除圖片檔案選擇
            const fileInput = document.getElementById('fileInput');
            if (fileInput) {
                fileInput.value = '';
            }

            // 清除圖片預覽
            const showImage = document.getElementById('showimage');
            if (showImage) {
                showImage.src = '';      // 清空 src
                showImage.style.display = 'none'; // 隱藏預覽
            }

            // 清除任何錯誤訊息
            clearValidationErrors();

        }

        // 顯示驗證錯誤
        function showValidationErrors(errors) {
            // 移除舊的錯誤訊息
            clearValidationErrors();

            // 建立錯誤訊息容器
            const modalBody = document.querySelector('#CreateProductCategory .modal-body');
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show validation-alert';
            alertDiv.role = 'alert';
            // 加入錯誤訊息
            let errorHtml = '<strong>請修正以下錯誤：</strong><ul class="mb-0">';
            errors.forEach(error => {
                errorHtml += `<li>${error}</li>`;
            });
            errorHtml += '</ul>';

            alertDiv.innerHTML = errorHtml +
            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';

            // 插入到 modal-body 的最前面
            modalBody.insertBefore(alertDiv, modalBody.firstChild);

        }
        // 清除驗證錯誤訊息
        function clearValidationErrors() {
            const alerts = document.querySelectorAll('#CreateProductCategory .validation-alert');
            alerts.forEach(alert => alert.remove());
        }


        
        
        // Modal 關閉時清空表單
        document.getElementById('CreateProductCategory').addEventListener('hidden.bs.modal', function () {
            resetCreateForm();
        });



        // 開啟新增表單Model後要JS 載入父類別
        function loadParentOptions(){
            fetch('api/ProductCategoryApi/ParentOptions', { method: 'GET' })
                .then(response => response.json())
                .then(data=>{
                    const select = document.getElementById('parentCategory');

                    // 保留預設，清空其他
                    select.innerHTML = '<option value="">--無上層類別--</option>';

                    // 動態加入選項
                    data.forEach( category=>{

                        const option = document.createElement('option');
                        option.value = category.id;
                        option.textContent = category.name;
                        select.appendChild(option);

                    }

                    );

                })
                .catch(error=> console.log('載入父類別選項失敗:', error));


        }


        // ========== 編輯功能相關程式碼 ==========
        // 開啟編輯 Modal
        function openEditModal(categoryId) {
            // 先載入類別詳細資料
            fetch(`/api/ProductCategoryApi/${categoryId}`, { method: 'GET' })
                .then(response => response.json())
                .then(data => {
                    console.log('載入類別資料:', data);

                    // 設定表單值
                    document.getElementById('editCategoryId').value = data.id;
                    document.getElementById('editCategoryName').value = data.name;
                    document.getElementById('editCategoryIsActive').checked = data.isActive;

                    // 載入父類別選項並設定選中值
                    loadEditParentOptions(data.fatherId, data.id);

                    // 開啟 Modal
                    const modal = new bootstrap.Modal(document.getElementById('EditProductCategory'));
                    modal.show();
                })
                .catch(error => {
                    console.error('載入類別資料失敗:', error);
                    showErrorMessage('載入類別資料失敗');
                });
        }

        // 載入編輯用的父類別選項
        function loadEditParentOptions(selectedFatherId, currentCategoryId) {
            fetch('/api/ProductCategoryApi/ParentOptions', { method: 'GET' })
                .then(response => response.json())
                .then(data => {
                    const select = document.getElementById('editParentCategory');
                    select.innerHTML = '<option value="">--無上層類別--</option>';

                    data.forEach(category => {
                        // 排除自己
                        if (category.id == currentCategoryId) {
                            return;
                        }

                        const option = document.createElement('option');
                        option.value = category.id;
                        option.textContent = category.name;

                        // 設定選中值
                        if (selectedFatherId && category.id == selectedFatherId) {
                            option.selected = true;
                        }

                        select.appendChild(option);
                    });
                })
                .catch(error => console.log('載入父類別選項失敗:', error));
        }

         // 監聽編輯 Modal 開啟事件
        document.getElementById('EditProductCategory').addEventListener('shown.bs.modal', function() {
            document.getElementById('editCategoryName').focus();
        });

         // 編輯 Modal 關閉時清空表單
        document.getElementById('EditProductCategory').addEventListener('hidden.bs.modal', function() {
            resetEditForm();
        });

        //提交編輯表單
        document.getElementById('updateCategory').addEventListener('click', submitEditForm);

        // 即時清除錯誤狀態（編輯）
        // 清除名字錯誤
        document.getElementById('editCategoryName').addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                clearFieldValidation('editCategoryName');
            }
        });
        // 清除選項錯誤
        document.getElementById('editParentCategory').addEventListener('change', function() {
            if (this.classList.contains('is-invalid')) {
                clearFieldValidation('editParentCategory');
            }
        });

        // 提交編輯表單方法
        function submitEditForm() {
            clearAllValidation();
            clearAllFieldErrors('edit');
            const categoryId = document.getElementById('editCategoryId').value;
            const categoryName = document.getElementById('editCategoryName').value.trim();
            const parentCategory = document.getElementById('editParentCategory').value;
            const isActive = document.getElementById('editCategoryIsActive').checked;

            let hasError = false;

            if (!categoryName) {
                showFieldError('editCategoryName', '請輸入類別名稱');
                hasError = true;
            } else if (categoryName.length > 50) {
                showFieldError('editCategoryName', '類別名稱不能超過50個字元');
                hasError = true;
            }

            if (hasError) {
                return;
            }

            const updateDto = {
                id: parseInt(categoryId),
                name: categoryName,
                fatherId: parentCategory ? parseInt(parentCategory) : null,
                isActive: isActive
            };

            const updateButton = document.getElementById('updateCategory');
            const originalText = updateButton.textContent;
            updateButton.disabled = true;
            updateButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>處理中...';

            fetch(`/api/ProductCategoryApi/${categoryId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(updateDto)
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err));
                }
                return response.json();
            })
            .then(data => {
                console.log('更新成功:', data);
                showSuccessMessage('商品類別更新成功！');
                const modal = bootstrap.Modal.getInstance(document.getElementById('EditProductCategory'));
                modal.hide();
                resetEditForm();
                loadCategories();
            })
            .catch(error => {
                console.error('更新失敗:', error);
                // 呼叫handleApiError
                handleApiError(error, 'edit');
            })
            .finally(() => {
                updateButton.disabled = false;
                updateButton.textContent = originalText;
            });
        }


        // 重置編輯表單
        function resetEditForm() {
            document.getElementById('editCategoryId').value = '';
            document.getElementById('editCategoryName').value = '';
            document.getElementById('editParentCategory').value = '';
            document.getElementById('editCategoryIsActive').checked = true;
            document.getElementById('editImage').value = '';
            document.getElementById('editShowimage').src = '';
            document.getElementById('editShowimage').style.display = 'none';
            document.getElementById('editFileInput').value = '';
            clearAllValidation();
        }

        
        

        // ========== 共用功能 ==========

        // 提交表單前，先清除所有欄位的舊錯誤訊息
        function clearAllFieldErrors(mode) {
            const formSelector = mode === 'edit' ? '#EditProductCategory' : '#CreateProductCategory';
            // 移除所有 class 為 'invalid-feedback' 的錯誤提示
            document.querySelectorAll(`${formSelector} .invalid-feedback`).forEach(el => el.remove());
            // 移除所有 input 的 is-invalid 紅色框線
            document.querySelectorAll(`${formSelector} .is-invalid`).forEach(el => el.classList.remove('is-invalid'));
        }

        // 處理API錯誤
        function handleApiError (error, mode){
           // 在處理新錯誤前，先清除舊的
            clearAllFieldErrors(mode);

            // 檢查錯誤物件是否有特定結構
            const prefix = mode === 'edit' ? 'edit' : '';
            // 情況1: 處理後端回傳的「結構化驗證錯
            if(error && error.errors){
                // 將後端欄位名映射到前端元素 ID (不含前綴)
                const fieldMap = {
                    'Name': 'categoryName',
                    'FatherId': 'parentCategory'
                };

            for (const fieldName in error.errors){
                const errorMessages = error.errors[fieldName];
                const elementId = prefix + (fieldMap[fieldName] || fieldName.toLowerCase());
                const element = document.getElementById(elementId);

                if (element && errorMessages.length > 0) {
                // 為輸入框加上 Bootstrap 的紅色框線
                        element.classList.add('is-invalid');

                        // 建立並插入錯誤訊息提示
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'invalid-feedback'; // Bootstrap 的標準錯誤提示 class
                        errorDiv.textContent = errorMessages.join(' '); // 將該欄位的所有錯誤訊息顯示出來

                        // 將錯誤訊息插入到元素的後面
                        element.parentNode.insertBefore(errorDiv, element.nextSibling);
                }
            }
        }
            // 情況2: 處理通用的、非結構化的錯誤 (作為備用方案)
            else {
                const message = (error && (error.message || error.error))
                    ? (error.message || error.error)
                    : (mode === 'edit' ? '更新商品類別失敗，請稍後再試' : '新增商品類別失敗，請稍後再試');

                showErrorMessage(message); // 呼叫您已有的 Toast 函式
            }


        }
        // 顯示個別欄位錯誤
        function showFieldError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const formGroup = field.closest('.mb-3');

            field.classList.add('is-invalid');

            let errorDiv = formGroup.querySelector('.invalid-feedback');
            if (!errorDiv) {
                errorDiv = document.createElement('div');
                errorDiv.className = 'invalid-feedback';
                formGroup.appendChild(errorDiv);
            }
            errorDiv.textContent = message;
        }

        // 清除個別欄位驗證
        function clearFieldValidation(fieldId) {
            const field = document.getElementById(fieldId);
            const formGroup = field.closest('.mb-3');

            field.classList.remove('is-invalid');

            const errorDiv = formGroup.querySelector('.invalid-feedback');
            if (errorDiv) {
                errorDiv.remove();
            }
        }

        //清除所有驗證
        function clearAllValidation() {
            document.querySelectorAll('.is-invalid').forEach(element => {
                element.classList.remove('is-invalid');
            });

            document.querySelectorAll('.invalid-feedback').forEach(element => {
                element.remove();
            });
        }

        // 顯示成功訊息
        function showSuccessMessage(message) {
            // 使用 Toast 或其他方式顯示成功訊息
            const toastHtml = `
                <diV class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
                    <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="toast-header bg-success text-white">
                            <strong class="me-auto">成功</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                    </div>
            `;
            const toastContainer = document.createElement('div');
            toastContainer.innerHTML = toastHtml;
            document.body.appendChild(toastContainer);

            // 3秒後自動關閉
            setTimeout(() => {
                toastContainer.remove();
            }, 3000);


        }

        // 顯示錯誤訊息
        function showErrorMessage(message) {
            const toastHtml = `
                <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
                    <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="toast-header bg-danger text-white">
                            <strong class="me-auto">錯誤</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                </div>
            `;

            const toastContainer = document.createElement('div');
            toastContainer.innerHTML = toastHtml;
            document.body.appendChild(toastContainer);

            // 5秒後自動關閉
            setTimeout(() => {
                toastContainer.remove();
            }, 5000);
        }





    </script>



