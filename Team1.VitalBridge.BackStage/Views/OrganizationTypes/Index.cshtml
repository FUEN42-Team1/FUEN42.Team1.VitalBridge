@model Team1.VitalBridge.BackStage.Models.ViewModels.PaginatedResult<Team1.VitalBridge.BackStage.Models.EFModels.OrganizationType>

@{
    ViewData["Title"] = "機構類型清單";
    var currentSearchQuery = Context.Request.Query["searchQuery"];
    var currentPageSize = Context.Request.Query["pageSize"];
}

@section Styles {
    <style>
        /* (保留原有 CSS 樣式，此處不變) */
        .table thead th {
            background-color: #f8f9fa;
            color: #212529;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
        }

        .modal-header, .modal-footer {
            background-color: #f8f9fa;
        }

        .pagination-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .pagination-container {
                flex-direction: row;
                justify-content: space-between;
            }
        }

        @@media (max-width: 576px) {
            .action-buttons {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 5px;
            }

            .action-buttons .btn {
                width: 100%;
            }
        }

        .status-badge {
            display: inline-block;
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 700;
            line-height: 1;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.5rem;
        }

        .status-badge-active {
            background-color: var(--bs-green);
        }

        .status-badge-inactive {
            background-color: var(--bs-red);
        }
    </style>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h6 class="m-0 font-weight-bold text-primary">機構類型清單</h6>
            </div>
            <div class="col-sm-6 text-end">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#organizationTypeModal" id="createBtn">
                    <i class="fas fa-plus"></i> 新增機構類型
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 d-flex align-items-center">
                <label for="pageSize" class="me-2">顯示</label>
                <select id="pageSize" class="form-select" style="width: auto;">
                    @{
                        var pageSizes = new[] { 5, 10, 20, 50 };
                        foreach (var size in pageSizes)
                        {
                            if (size.ToString() == currentPageSize)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    }
                </select>
                <span class="ms-2">筆結果</span>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0">
                <label for="searchQuery" class="me-2">搜尋:</label>
                <input type="search" id="searchQuery" class="form-control" placeholder="請輸入關鍵字" style="width: auto;" value="@currentSearchQuery" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered" id="organizationTypeTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Items.First().Name)
                        </th>
                        <th>
                            狀態
                        </th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <span class="status-badge @(item.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                    @(item.IsActive ? "啟用中" : "已停用")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="#" class="btn btn-warning btn-sm edit-btn" data-id="@item.Id" data-name="@item.Name" data-bs-toggle="modal" data-bs-target="#organizationTypeModal">
                                        <i class="fas fa-edit"></i> 編輯
                                    </a>
                                    <a href="#" class="btn btn-sm @(item.IsActive ? "btn-danger deactivate-btn" : "btn-info activate-btn")" data-id="@item.Id" data-is-active="@item.IsActive">
                                        <i class="fas @(item.IsActive ? "fa-power-off" : "fa-check")"></i> @(item.IsActive ? "停用" : "啟用")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container mt-3">
            <div class="text-nowrap mb-2 mb-md-0" id="pagination-info">
                顯示第 @(Model.Items.Count > 0 ? (Model.PageSize * (Model.PageNumber - 1) + 1).ToString() : "0")
                至 @(Model.PageSize * (Model.PageNumber - 1) + Model.Items.Count)
                筆結果，共 <span id="total-count">@Model.TotalCount</span> 筆
            </div>
            <ul class="pagination mb-0 flex-wrap justify-content-center" id="pagination-links">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">第一頁</span>
                        <span class="d-md-none">&lt;&lt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">上一頁</span>
                        <span class="d-md-none">&lt;</span>
                    </a>
                </li>
                @{
                    var startPage = Math.Max(1, Model.PageNumber - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "") d-none d-sm-block">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">下一頁</span>
                        <span class="d-md-none">&gt;</span>
                    </a>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize, searchQuery = currentSearchQuery })">
                        <span class="d-none d-md-inline">最後一頁</span>
                        <span class="d-md-none">&gt;&gt;</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@* ... (Modal 區塊維持不變) ... *@
<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalLabel">訊息</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="messageModalBody">
                </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="organizationTypeModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">新增機構類型</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="organizationTypeForm">
                    <input type="hidden" id="organizationTypeId" name="Id" value="" />
                    <div class="mb-3">
                        <label for="organizationTypeName" class="form-label">機構類型名稱</label>
                        <input type="text" class="form-control" id="organizationTypeName" name="Name" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-success" id="saveBtn">儲存</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusConfirmModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">狀態變更確認</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="statusConfirmText">您確定要停用這筆資料嗎？</p>
                <input type="hidden" id="statusId" value="" />
                <input type="hidden" id="statusChangeTo" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" id="confirmStatusBtn">確定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 頁面載入時處理 URL 參數
        const urlParams = new URLSearchParams(window.location.search);
        const currentSearchQuery = urlParams.get('searchQuery') || '';
        const currentPageSize = urlParams.get('pageSize') || 10;
        const currentPage = parseInt(urlParams.get('page') || 1);

        const organizationTypeModal = new bootstrap.Modal(document.getElementById('organizationTypeModal'));
        const statusConfirmModal = new bootstrap.Modal(document.getElementById('statusConfirmModal'));
        const messageModal = new bootstrap.Modal(document.getElementById('messageModal'));

        // 顯示通用訊息 Modal，並在關閉後自動重新整理
        function showMessageModal(message, reloadPage = false) {
            $('#messageModalBody').html(message);
            messageModal.show();

            // 監聽 Modal 關閉事件
            $('#messageModal').on('hidden.bs.modal', function () {
                if (reloadPage) {
                    window.location.reload();
                }
                // 移除事件監聽，避免重複觸發
                $('#messageModal').off('hidden.bs.modal');
            });
        }

        // 動態生成表格行
        function createTableRow(item) {
            const statusClass = item.isActive ? 'status-badge-active' : 'status-badge-inactive';
            const statusText = item.isActive ? '啟用中' : '已停用';
            const statusBtnClass = item.isActive ? 'btn-danger deactivate-btn' : 'btn-info activate-btn';
            const statusBtnText = item.isActive ? '停用' : '啟用';
            const statusIconClass = item.isActive ? 'fa-power-off' : 'fa-check';

            return `
                <tr data-id="${item.id}">
                    <td>${item.name}</td>
                    <td>
                        <span class="status-badge ${statusClass}">${statusText}</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a href="#" class="btn btn-warning btn-sm edit-btn" data-id="${item.id}" data-name="${item.name}" data-bs-toggle="modal" data-bs-target="#organizationTypeModal">
                                <i class="fas fa-edit"></i> 編輯
                            </a>
                            <a href="#" class="btn btn-sm ${statusBtnClass}" data-id="${item.id}" data-is-active="${item.isActive}">
                                <i class="fas ${statusIconClass}"></i> ${statusBtnText}
                            </a>
                        </div>
                    </td>
                </tr>
            `;
        }

        // 更新單一表格行
        function updateTableRow(item) {
            const $row = $(`#tableBody tr[data-id="${item.id}"]`);
            if ($row.length) {
                // 編輯: 直接替換現有行
                $row.replaceWith(createTableRow(item));
            } else {
                // 新增: 將新行添加到表格最前面
                $('#tableBody').prepend(createTableRow(item));
            }
        }

        // 移除單一表格行
        function removeTableRow(id) {
            $(`#tableBody tr[data-id="${id}"]`).remove();
        }

        $(document).ready(function () {
            // 頁面載入時根據 URL 參數設定搜尋框和每頁筆數
            $('#searchQuery').val(currentSearchQuery);
            $('#pageSize').val(currentPageSize);

            // 監聽每頁筆數變更
            $('#pageSize').on('change', function () {
                var newPageSize = $(this).val();
                window.location.href = '@Url.Action("Index", "OrganizationTypes")' + '?page=1&pageSize=' + newPageSize + '&searchQuery=' + encodeURIComponent(currentSearchQuery);
            });

            // 監聽搜尋框 Enter 鍵
            $('#searchQuery').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var newSearchQuery = $(this).val();
                    var currentPageSize = $('#pageSize').val();
                    window.location.href = '@Url.Action("Index", "OrganizationTypes")' + '?page=1&pageSize=' + currentPageSize + '&searchQuery=' + encodeURIComponent(newSearchQuery);
                }
            });

            // 新增按鈕
            $("#createBtn").on("click", function () {
                $("#modalTitle").text("新增機構類型");
                $("#organizationTypeForm")[0].reset();
                $("#organizationTypeId").val("");
                $("#saveBtn").removeClass("btn-warning").addClass("btn-success");
                organizationTypeModal.show();
            });

            // 編輯按鈕
            $("#organizationTypeTable").on("click", ".edit-btn", function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                $("#modalTitle").text("編輯機構類型");
                $("#organizationTypeId").val(id);
                $("#organizationTypeName").val(name);
                $("#saveBtn").removeClass("btn-success").addClass("btn-warning");
                organizationTypeModal.show();
            });

            // 監聽 Enter 鍵，按下後觸發表單提交
            $("#organizationTypeName").on("keydown", function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $("#saveBtn").click();
                }
            });

            // 儲存按鈕 (新增與編輯)
            $("#saveBtn").on("click", function () {
                var id = $("#organizationTypeId").val();
                var name = $("#organizationTypeName").val();
                var url = "";

                if (name.trim() === "") {
                    showMessageModal("機構類型名稱不能為空。");
                    return;
                }

                var data = { Name: name };
                if (id) {
                    url = "/OrganizationTypes/Edit/" + id;
                    data.Id = id;
                } else {
                    url = "/OrganizationTypes/Create";
                }

                $.ajax({
                    url: url,
                    type: "POST",
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            // 成功後顯示訊息並設定為自動重新整理
                            showMessageModal(response.message, true);
                            organizationTypeModal.hide();
                        } else {
                            // 失敗後顯示訊息，不重新整理
                            showMessageModal(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        showMessageModal("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        // 無論成功或失敗都關閉 Modal
                        organizationTypeModal.hide();
                    }
                });
            });

            // 啟用/停用按鈕
            $("#organizationTypeTable").on("click", ".deactivate-btn, .activate-btn", function () {
                var id = $(this).data("id");
                var isActive = $(this).data("is-active") === "True";
                var newStatus = !isActive;

                $("#statusId").val(id);
                $("#statusChangeTo").val(newStatus);
                $("#statusConfirmText").text("您確定要將此資料" + (newStatus ? "啟用" : "停用") + "嗎？");

                if (newStatus) {
                    $("#confirmStatusBtn").removeClass("btn-danger").addClass("btn-info").text("啟用");
                } else {
                    $("#confirmStatusBtn").removeClass("btn-info").addClass("btn-danger").text("停用");
                }
                statusConfirmModal.show();
            });

            // 確認啟用/停用按鈕
            $("#confirmStatusBtn").on("click", function () {
                var id = $("#statusId").val();
                var newStatus = $("#statusChangeTo").val() === "true";

                $.ajax({
                    url: "/OrganizationTypes/ToggleStatus/" + id,
                    type: "POST",
                    data: { isActive: newStatus },
                    success: function (response) {
                        if (response.success) {
                            // 成功後顯示訊息並設定為自動重新整理
                            showMessageModal(response.message, true);
                        } else {
                            // 失敗後顯示訊息，不重新整理
                            showMessageModal(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        showMessageModal("發生錯誤，請稍後再試。");
                    },
                    complete: function () {
                        statusConfirmModal.hide();
                    }
                });
            });

            // 監聽訊息 Modal 上的 Enter 鍵，按下後關閉 Modal
            $('#messageModal').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    messageModal.hide();
                }
            });
        });
    </script>
}

